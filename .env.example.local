# Local-only Firecrawl API
COMPOSE_FILE=compose.yaml
PORT=3002
INTERNAL_PORT=3002
USE_DB_AUTHENTICATION=false
LOCAL_BROWSER_SERVICE_ENABLED=true
LOCAL_BROWSER_STATE_ROOT=/var/lib/firecrawl-browser-volume/state
BROWSER_SERVICE_API_KEY=GENERATED_BY_INIT_SCRIPT_32_BYTE_BASE64URL
BROWSER_REPLAY_INGEST_API_KEY=GENERATED_BY_INIT_SCRIPT_DISTINCT_32_BYTES_MINIMUM
BROWSER_INTERACTION_WORKER_TOKEN=GENERATED_BY_INIT_SCRIPT_DISTINCT_32_BYTE_BASE64URL
MAX_BROWSER_SESSIONS=4
BROWSER_SERVICE_REQUEST_TIMEOUT_MS=30000
BROWSER_RECONCILIATION_TIMEOUT_MS=60000
BROWSER_RECONCILIATION_MAX_ATTEMPTS=4
BROWSER_RECONCILIATION_INITIAL_BACKOFF_MS=250
BROWSER_RECONCILIATION_MAX_BACKOFF_MS=2000
BROWSER_RECONCILIATION_STARTUP_BUDGET_MS=60000
BROWSER_RECONCILIATION_MONITOR_INTERVAL_MS=5000
BROWSER_RECONCILIATION_RETRY_COOLDOWN_MS=30000
BROWSER_PUBLIC_API_ORIGIN=http://127.0.0.1:3002

# Firecrawl v2.11.0 pins pg_cron to the postgres database.
POSTGRES_USER=firecrawl
POSTGRES_PASSWORD=GENERATED_BY_INIT_SCRIPT
POSTGRES_DB=postgres

# Protects /admin/<key>/queues even though the API is loopback-only.
BULL_AUTH_KEY=GENERATED_BY_INIT_SCRIPT

LOGGING_LEVEL=INFO
ALLOW_LOCAL_WEBHOOKS=false
BLOCK_MEDIA=false

# Intentionally unused optional upstream integrations
AUTUMN_SECRET_KEY=
MODEL_EMBEDDING_NAME=
MODEL_NAME=
NUQ_BACKEND=
OLLAMA_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
PROXY_PASSWORD=
PROXY_SERVER=
PROXY_USERNAME=
SEARXNG_CATEGORIES=
SEARXNG_ENDPOINT=http://searxng:8080
SEARXNG_ENGINES=
SEARXNG_SECRET=GENERATED_BY_INIT_SCRIPT_DISTINCT_32_BYTES_HEX
SELF_HOSTED_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
SUPABASE_ANON_TOKEN=
SUPABASE_SERVICE_TOKEN=
SUPABASE_URL=
TEST_API_KEY=
