{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firecrawl.local/schemas/codex-app-server-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "sourceIdentity",
    "artifactSha256",
    "protocolSha256",
    "featureSha256",
    "gateAttestationSha256",
    "model",
    "reasoningEffort",
    "buildTimestamp"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "const": 1
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executablePath",
        "resolvedPath",
        "device",
        "inode",
        "version"
      ],
      "properties": {
        "executablePath": {
          "type": "string",
          "minLength": 1
        },
        "resolvedPath": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "inode": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        }
      }
    },
    "artifactSha256": {
      "$ref": "#/$defs/sha256"
    },
    "protocolSha256": {
      "$ref": "#/$defs/sha256"
    },
    "featureSha256": {
      "$ref": "#/$defs/sha256"
    },
    "gateAttestationSha256": {
      "$ref": "#/$defs/sha256"
    },
    "model": {
      "type": "string",
      "const": "gpt-5.6-terra"
    },
    "reasoningEffort": {
      "type": "string",
      "const": "medium"
    },
    "buildTimestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
