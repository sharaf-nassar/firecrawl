[Unit]
Description=Firecrawl browser execution adapter

[Service]
Type=simple
ExecStart=/usr/local/libexec/firecrawl-browser-execution-adapter
Environment=FIRECRAWL_ADAPTER_SOCKET=%t/firecrawl/adapter.sock
Environment=FIRECRAWL_BROKER_SOCKET=/run/firecrawl-sandbox/broker.sock
Environment=FIRECRAWL_CALLBACK_URL=http://127.0.0.1:3002
Environment=FIRECRAWL_CALLBACK_TOKEN_FILE=%t/firecrawl/adapter.token
Environment=FIRECRAWL_CODEX_AUTH_FILE=%h/.codex/auth.json
Environment=FIRECRAWL_MAX_PROMPT_RUNS=1
Environment=FIRECRAWL_MAX_CODE_RUNS=2
RuntimeDirectory=firecrawl
RuntimeDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=1s
TimeoutStopSec=15s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
