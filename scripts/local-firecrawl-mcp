#!/usr/bin/env node

import { spawn } from "node:child_process";
import {
  createDisabledLocalTools,
  filterToolList,
  interceptCodeCall,
  interceptUnsupportedSearchCall,
  isSearchToolCall,
  probeShimHealth,
  rewriteSearchCallResult,
  unsupportedToolResponse,
} from "./local-firecrawl-mcp.lib.mjs";

const upstreamArgs =
  process.argv.length > 2
    ? process.argv.slice(2)
    : ["-y", "firecrawl-mcp@3.22.3"];

const disabledLocalTools = createDisabledLocalTools(
  (await probeShimHealth()) ? [] : ["firecrawl_extract"],
);
const pendingSearchCallIds = new Set();

const child = spawn("npx", upstreamArgs, {
  env: process.env,
  stdio: ["pipe", "pipe", "inherit"],
});

let inputBuffer = "";
let outputBuffer = "";

function encodeMessage(message) {
  return `${JSON.stringify(message)}\n`;
}

function consumeLines(buffer, chunk, handleLine) {
  const combined = buffer + chunk;
  const lines = combined.split("\n");
  const remainder = lines.pop() ?? "";

  for (const line of lines) {
    handleLine(line);
  }

  return remainder;
}

process.stdin.setEncoding("utf8");
process.stdin.on("data", (chunk) => {
  inputBuffer = consumeLines(inputBuffer, chunk, (line) => {
    if (line.trim() === "") {
      child.stdin.write(`${line}\n`);
      return;
    }

    try {
      const message = JSON.parse(line);
      const response =
        unsupportedToolResponse(message, disabledLocalTools) ??
        interceptCodeCall(message) ??
        interceptUnsupportedSearchCall(message);
      if (response) {
        process.stdout.write(encodeMessage(response));
        return;
      }
      if (isSearchToolCall(message) && message.id !== undefined) {
        pendingSearchCallIds.add(message.id);
      }
    } catch {
      // Preserve non-JSON output so protocol errors remain attributable upstream.
    }

    child.stdin.write(`${line}\n`);
  });
});

process.stdin.on("end", () => {
  if (inputBuffer !== "") {
    child.stdin.write(inputBuffer);
  }
  child.stdin.end();
});

child.stdout.setEncoding("utf8");
child.stdout.on("data", (chunk) => {
  outputBuffer = consumeLines(outputBuffer, chunk, (line) => {
    if (line.trim() === "") {
      process.stdout.write(`${line}\n`);
      return;
    }

    try {
      const message = filterToolList(JSON.parse(line), disabledLocalTools);
      process.stdout.write(
        encodeMessage(rewriteSearchCallResult(message, pendingSearchCallIds)),
      );
    } catch {
      process.stdout.write(`${line}\n`);
    }
  });
});

child.stdout.on("end", () => {
  if (outputBuffer !== "") {
    process.stdout.write(outputBuffer);
  }
});

child.on("error", (error) => {
  process.stderr.write(`local_firecrawl_mcp_start_failed: ${error.message}\n`);
  process.exitCode = 1;
});

child.on("exit", (code, signal) => {
  if (signal) {
    process.kill(process.pid, signal);
    return;
  }
  process.exitCode = code ?? 1;
});

for (const signal of ["SIGINT", "SIGTERM"]) {
  process.on(signal, () => {
    child.kill(signal);
  });
}
