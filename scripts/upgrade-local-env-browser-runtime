#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
env_file="${LOCAL_FIRECRAWL_ENV_FILE:-$repo_root/.env}"
lock_file="${env_file}.browser-runtime-upgrade.lock"
runtime_dir="/run/user/$(id -u)/firecrawl"

fail() {
  printf '%s\n' "$1" >&2
  exit "${2:-1}"
}

[[ "$env_file" == /* ]] || fail 'Environment file path must be absolute' 64
[[ -f "$env_file" && ! -L "$env_file" ]] ||
  fail "Environment file is missing or unsafe: $env_file"
mode="$(stat -c '%a' -- "$env_file")"
[[ "$mode" == 600 ]] ||
  fail "Environment file must have mode 0600: $env_file"
[[ "$(stat -c '%u' -- "$env_file")" == "$UID" ]] ||
  fail "Environment file must be owned by the current user: $env_file"

umask 077
if [[ ! -e "$lock_file" && ! -L "$lock_file" ]]; then
  ( set -o noclobber; : > "$lock_file" ) 2>/dev/null || true
fi
[[ -f "$lock_file" && ! -L "$lock_file" ]] ||
  fail "Environment upgrade lock is unsafe: $lock_file"
lock_identity="$(stat -c '%d:%i:%u:%a:%h' -- "$lock_file")"
[[ "$lock_identity" =~ ^[0-9]+:[0-9]+:${UID}:600:1$ ]] ||
  fail "Environment upgrade lock has unsafe ownership or mode: $lock_file"
exec {lock_fd}<> "$lock_file"
fd_identity="$(stat -Lc '%d:%i:%u:%a:%h' -- "/proc/$$/fd/$lock_fd")"
[[ "$fd_identity" == "$lock_identity" ]] ||
  fail "Environment upgrade lock changed while opening: $lock_file"
flock --exclusive --timeout 30 --conflict-exit-code 75 "$lock_fd" ||
  fail "Environment upgrade lock is busy: $lock_file" 75

declare -A values=()
while IFS= read -r line || [[ -n "$line" ]]; do
  [[ -z "$line" || "$line" == \#* ]] && continue
  [[ "$line" =~ ^([A-Z][A-Z0-9_]*)=(.*)$ ]] ||
    fail 'Environment file contains an invalid assignment'
  key="${BASH_REMATCH[1]}"
  [[ ! -v "values[$key]" ]] ||
    fail "Environment file contains duplicate key: $key"
  values["$key"]="${BASH_REMATCH[2]}"
done < "$env_file"

browser_key="${values[BROWSER_SERVICE_API_KEY]:-}"
if [[ -z "$browser_key" ]]; then
  browser_key="$(
    openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
  )"
elif [[ ! "$browser_key" =~ ^[A-Za-z0-9_-]{43}$ ]]; then
  fail 'BROWSER_SERVICE_API_KEY must be a 32-byte base64url secret'
fi

declare -A required=(
  [BROWSER_SERVICE_API_KEY]="$browser_key"
  [LOCAL_BROWSER_SERVICE_ENABLED]='true'
  [MAX_BROWSER_SESSIONS]='4'
  [LOCAL_FIRECRAWL_HOST_RUNTIME_DIR]="$runtime_dir"
  [BROWSER_EXECUTION_ADAPTER_SOCKET]='/run/firecrawl-adapter/adapter.sock'
  [BROWSER_ADAPTER_TOKEN_FILE]='/run/firecrawl-adapter/adapter.token'
)
ordered_keys=(
  BROWSER_SERVICE_API_KEY
  LOCAL_BROWSER_SERVICE_ENABLED
  MAX_BROWSER_SESSIONS
  LOCAL_FIRECRAWL_HOST_RUNTIME_DIR
  BROWSER_EXECUTION_ADAPTER_SOCKET
  BROWSER_ADAPTER_TOKEN_FILE
)

for key in "${ordered_keys[@]}"; do
  if [[ -v "values[$key]" && "${values[$key]}" != "${required[$key]}" ]]; then
    fail "Environment file has conflicting fixed value: $key"
  fi
done

umask 077
tmp_file="$(mktemp "${env_file}.firecrawl-secret-tmp.upgrade.XXXXXX")"
cleanup() {
  rm -f -- "$tmp_file"
}
trap cleanup EXIT HUP INT TERM PIPE XFSZ
cp --preserve=mode,ownership -- "$env_file" "$tmp_file"
for key in "${ordered_keys[@]}"; do
  if [[ ! -v "values[$key]" ]]; then
    printf '%s=%s\n' "$key" "${required[$key]}" >> "$tmp_file"
  fi
done
chmod 0600 "$tmp_file"
mv -fT -- "$tmp_file" "$env_file"
trap - EXIT HUP INT TERM PIPE XFSZ

printf 'Upgraded %s for local browser runtime.\n' "$env_file"
