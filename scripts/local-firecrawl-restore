#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/local-firecrawl-backup
source "$script_dir/local-firecrawl-backup"

restore_candidate_copy=
restore_rollback=

lf_restore_usage() {
  printf 'Usage: %s <generation-directory> [--rollback-output <absolute-directory>]\n' \
    "${0##*/}" >&2
}

lf_restore_database_profile_paths() {
  local dump="$1"
  local database=
  local status=0

  database="firecrawl_backup_check_$(
    tr -d - <<< "$(< /proc/sys/kernel/random/uuid)"
  )"
  "${compose[@]}" exec -T app-postgres sh -ec \
    'createdb -U "$POSTGRES_USER" --template=template0 "$1"' sh "$database"
  set +e
  "${compose[@]}" exec -T app-postgres sh -ec \
    'pg_restore -U "$POSTGRES_USER" -d "$1" --no-owner --exit-on-error' \
    sh "$database" < "$dump"
  status=$?
  if (( status == 0 )); then
    pointer_validation="$(
      "${compose[@]}" exec -T app-postgres sh -ec '
        psql -X -qAt -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$1" <<'"'"'SQL'"'"'
SELECT
  (
    SELECT count(*)
      FROM browser_profiles p
      LEFT JOIN browser_profile_generations g
        ON g.id = p.latest_generation_id
     WHERE p.writer_session_id IS NOT NULL
        OR (
          p.latest_generation_id IS NOT NULL
          AND (
            g.id IS NULL
            OR g.profile_id <> p.id
            OR g.file_deleted_at IS NOT NULL
            OR g.state_path IS DISTINCT FROM
              concat('"'"'profiles/'"'"', p.id, '"'"'/committed/'"'"', g.id)
          )
        )
  ) + (
    SELECT count(*)
      FROM browser_profile_generations invalid
     WHERE invalid.state_path IS NOT NULL
       AND invalid.file_deleted_at IS NULL
       AND invalid.state_path IS DISTINCT FROM
         concat(
           'profiles/',
           invalid.profile_id,
           '/committed/',
           invalid.id
         )
  );
SELECT state_path
  FROM browser_profile_generations
 WHERE state_path IS NOT NULL
   AND file_deleted_at IS NULL
 ORDER BY state_path;
SQL
      ' sh "$database"
    )"
    status=$?
  fi
  "${compose[@]}" exec -T app-postgres sh -ec \
    'dropdb -U "$POSTGRES_USER" --if-exists "$1"' sh "$database" \
    >/dev/null 2>&1 || status=1
  set -e
  (( status == 0 )) || return "$status"
  [[ "${pointer_validation%%$'\n'*}" == 0 ]] ||
    { printf '%s\n' 'Database profile pointer authority is invalid' >&2; return 1; }
  if [[ "$pointer_validation" == *$'\n'* ]]; then
    printf '%s\n' "${pointer_validation#*$'\n'}"
  fi
}

lf_restore_validate_pointer_agreement() {
  local directory="$1"
  local temporary

  temporary="$(mktemp -d "$control_runtime_dir/profile-pointers.XXXXXXXX")"
  chmod 0700 -- "$temporary"
  cleanup_pointer_validation() {
    rm -rf -- "$temporary"
  }
  trap cleanup_pointer_validation RETURN
  lf_restore_database_profile_paths "$directory/$db_name" \
    > "$temporary/database"
  lf_backup_profile_paths "$directory/$profiles_name" \
    > "$temporary/archive"
  if ! cmp --silent "$temporary/database" "$temporary/archive"; then
    printf '%s\n' \
      'Database and browser profile generation pointers disagree' >&2
    return 1
  fi
  trap - RETURN
  rm -rf -- "$temporary"
}

lf_restore_database() {
  local dump="$1"

  "${compose[@]}" exec -T app-postgres sh -ec \
    'pg_restore -U "$POSTGRES_USER" -d "$POSTGRES_DB" --clean --if-exists --no-owner --exit-on-error --single-transaction' \
    < "$dump"
}

lf_restore_minio() {
  local archive="$1"
  local archive_directory="${archive%/*}"
  local archive_name="${archive##*/}"
  local volume

  volume="$(lf_backup_volume_name minio /data minio-data)" || return $?
  docker run --rm --network none --read-only \
    --volume "$volume:/target" \
    --volume "$archive_directory:/backup:ro" \
    --entrypoint sh "$backup_postgres_image" -ec '
      find /target -mindepth 1 -delete
      tar --extract --gzip --numeric-owner --same-owner \
        --file "/backup/$1" --directory /target
    ' sh "$archive_name"
  docker run --rm --network none --read-only \
    --volume "$volume:/target:ro" \
    --volume "$archive_directory:/backup:ro" \
    --entrypoint tar "$backup_postgres_image" \
    --compare --gzip --numeric-owner \
    --file "/backup/$archive_name" --directory /target
}

lf_restore_profiles() {
  local archive="$1"
  local archive_directory="${archive%/*}"
  local archive_name="${archive##*/}"
  local volume

  volume="$(
    lf_backup_volume_name browser-service \
      /var/lib/firecrawl-browser-volume browser-state
  )" || return $?
  docker run --rm --network none --read-only \
    --volume "$volume:/target" \
    --volume "$archive_directory:/backup:ro" \
    --entrypoint sh "$backup_postgres_image" -ec '
      test -d /target/state
      rm -rf -- /target/state/profiles /target/state/.profile-publish-staging
      tar --extract --gzip --numeric-owner --same-owner \
        --file "/backup/$1" --directory /target/state
    ' sh "$archive_name"
  docker run --rm --network none --read-only \
    --volume "$volume:/target:ro" \
    --volume "$archive_directory:/backup:ro" \
    --entrypoint tar "$backup_postgres_image" \
    --compare --gzip --numeric-owner \
    --file "/backup/$archive_name" --directory /target/state
}

lf_restore_validate_live_pointers() {
  live_pointer_validation="$(
    "${compose[@]}" exec -T app-postgres sh -ec '
      psql -X -qAt -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" <<'"'"'SQL'"'"'
SELECT g.state_path
  FROM browser_profile_generations g
 WHERE g.state_path IS NOT NULL
   AND g.file_deleted_at IS NULL
 ORDER BY g.state_path;
SQL
    '
  )" || return $?
  volume="$(
    lf_backup_volume_name browser-service \
      /var/lib/firecrawl-browser-volume browser-state
  )" || return $?
  printf '%s\n' "$live_pointer_validation" |
    docker run --rm --network none --read-only -i \
      --volume "$volume:/target:ro" \
      --entrypoint sh "$backup_postgres_image" -ec '
        test -d /target/state/profiles
        expected="$(cat)"
        actual="$(
          find /target/state/profiles -mindepth 3 -maxdepth 3 \
            -type d -path "*/committed/*" -printf "%P\n" |
            sed "s#^#profiles/#" | sort
        )"
        test "$expected" = "$actual"
        printf "%s\n" "$expected" |
        while IFS= read -r state_path; do
          test -z "$state_path" && continue
          echo "$state_path" |
            grep -Eq "^profiles/[0-9a-f-]{36}/committed/[0-9a-f-]{36}$"
          test -d "/target/state/$state_path"
          test ! -L "/target/state/$state_path"
        done
      '
}

lf_restore_private_copy() {
  local source="$1"
  local copy_parent

  copy_parent="$(mktemp -d "$control_runtime_dir/restore-input.XXXXXXXX")"
  chmod 0700 -- "$copy_parent"
  restore_candidate_copy="$copy_parent/${source##*/}"
  mkdir -m 0700 -- "$restore_candidate_copy"
  cp -a -- "$source/." "$restore_candidate_copy/"
  lf_backup_validate_generation "$restore_candidate_copy"
}

lf_restore_cleanup() {
  lf_backup_fail_closed
  if [[ -n "$restore_candidate_copy" ]]; then
    rm -rf -- "${restore_candidate_copy%/*}"
  fi
  cleanup_sealed_identity
}

lf_restore_main() {
  local source=
  local rollback_root=
  local generation

  (( $# >= 1 )) || { lf_restore_usage; return 64; }
  source="$1"
  shift
  while (( $# > 0 )); do
    case "$1" in
      --rollback-output)
        (( $# >= 2 )) || { lf_restore_usage; return 64; }
        rollback_root="$2"
        shift 2
        ;;
      *)
        lf_restore_usage
        return 64
        ;;
    esac
  done
  validate_runtime_options
  [[ "$source" == /* && -d "$source" && ! -L "$source" ]] ||
    { printf '%s\n' 'Restore generation must be an absolute real directory' >&2; return 64; }
  [[ "$(readlink -f -- "$source")" == "$source" ]] ||
    { printf '%s\n' 'Restore generation must be canonical' >&2; return 64; }
  lf_backup_generation_names "${source##*/}" || return $?
  if [[ -z "$rollback_root" ]]; then
    rollback_root="${source%/*}"
  fi
  lf_backup_validate_root "$rollback_root"
  acquire_runtime_lock exclusive
  if lf_backup_runtime_running; then
    backup_runtime_was_running=1
  fi
  backup_operation_complete=0
  trap lf_restore_cleanup EXIT
  lf_backup_stop_writers_locked
  lf_restore_private_copy "$source"
  generation="${restore_candidate_copy##*/}"
  lf_backup_generation_names "$generation"
  lf_restore_validate_pointer_agreement "$restore_candidate_copy"

  restore_rollback="$(
    lf_backup_capture_generation_locked \
      "$rollback_root" "$(lf_backup_generation_name)"
  )"
  rollback_generation="${restore_rollback##*/}"
  lf_backup_generation_names "$rollback_generation"
  lf_restore_validate_pointer_agreement "$restore_rollback"
  printf 'Rollback generation: %s\n' "$restore_rollback"

  lf_backup_generation_names "$generation"
  lf_restore_database "$restore_candidate_copy/$db_name"
  lf_restore_minio "$restore_candidate_copy/$minio_name"
  lf_restore_profiles "$restore_candidate_copy/$profiles_name"
  lf_restore_validate_live_pointers
  lf_backup_restart_locked
  backup_operation_complete=1
  rm -rf -- "${restore_candidate_copy%/*}"
  restore_candidate_copy=
  trap cleanup_sealed_identity EXIT
  printf 'Restored persistence generation: %s\n' "$source"
}

lf_restore_main "$@"
