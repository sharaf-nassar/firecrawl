    "Python 3.12.3",
    "GNU bash, version 5.2.21(1)-release",
    "29.6.1",
    "cargo 1.94.0 (85eff7c80 2026-01-15)",
    "runc version 1.3.6",
    "spec: 1.2.1",
    "tar (GNU tar) 1.35",
