test("local lifecycle publishes host staging through one locked sudo call", () => {
  const wrapper = read(join(REPOSITORY, "scripts/local-firecrawl"));
  assert.match(
    wrapper,
    /publish_host_from_staging_locked\(\)[\s\S]*runtime_lock_held" == exclusive/,
  );
  assert.equal(
    [...wrapper.matchAll(/\bsudo\b/g)].length,
    1,
    "one sudo command site",
  );
  assert.match(wrapper, /sudo_command\+=\( -n \)/);
  assert.match(
    wrapper,
    /"\$repo_root\/host\/browser-runtime\/install-root\.sh"/,
  );
  assert.doesNotMatch(
    wrapper,
    /publish_host_from_staging_locked[\s\S]*"\$repo_root\/scripts\/local-firecrawl"/,
  );
  assert.match(wrapper, /install-host requires an interactive terminal/);
  assert.match(
    wrapper,
    /start\)[\s\S]*acquire_runtime_lock exclusive[\s\S]*refresh_host_locked/,
  );
  assert.match(
    wrapper,
    /restart\)[\s\S]*acquire_runtime_lock exclusive[\s\S]*refresh_host_locked/,
  );
});

const staging = process.env.FIRECRAWL_HOST_STAGING;
if (staging) {
  test("provided Firecrawl host staging is install-safe", () => {
    assert.match(staging, /^\//, "FIRECRAWL_HOST_STAGING must be absolute");
    validateStaging(staging);
  });

  test("generation verifier rejects checksum-consistent identity drift", () => {
    const hostile = copyStagingFixture(
      staging,
      "firecrawl-host-identity-hostile-",
    );
    const verify = () =>
      spawnSync(
        "/usr/bin/python3",
        [
          join(HOST_RUNTIME, "verify-generation.py"),
          hostile,
          String(process.getuid()),
        ],
        { encoding: "utf8" },
      );
    const restore = names => {
      for (const name of names) {
        writeFileSync(join(hostile, name), readFileSync(join(staging, name)));
        chmodSync(join(hostile, name), statSync(join(staging, name)).mode & 0o777);
      }
    };
    const topChecksums = join(hostile, "SHA256SUMS");
    try {
      const top = JSON.parse(read(join(hostile, "manifest.json")));
      top.codeRuntime.node = "22.22.2";
      writeFileSync(join(hostile, "manifest.json"), `${JSON.stringify(top)}\n`);
      refreshChecksumRecord(topChecksums, hostile, "manifest.json");
      assert.notEqual(verify().status, 0, "fixed runtime drift rejected");
      restore(["manifest.json", "SHA256SUMS"]);

      const changedTimestamp = JSON.parse(read(join(hostile, "manifest.json")));
      changedTimestamp.buildTimestamp = "2026-07-27T00:00:00.000Z";
      writeFileSync(
        join(hostile, "manifest.json"),
        `${JSON.stringify(changedTimestamp)}\n`,
      );
      refreshChecksumRecord(topChecksums, hostile, "manifest.json");
      assert.notEqual(verify().status, 0, "timestamp mismatch rejected");
      restore(["manifest.json", "SHA256SUMS"]);

      const gatePath = join(hostile, "gate-attestation.json");
      const gate = JSON.parse(read(gatePath));
      gate.model = "other";
      writeFileSync(gatePath, `${JSON.stringify(gate)}\n`);
      const codex = JSON.parse(
        read(join(hostile, "codex-app-server.manifest.json")),
      );
      codex.gateAttestationSha256 = sha256File(gatePath);
      for (const name of [
        "codex-app-server.manifest.json",
        "protocol/codex-app-server.manifest.json",
      ]) {
        writeFileSync(join(hostile, name), `${JSON.stringify(codex)}\n`);
      }
      const gateTop = JSON.parse(read(join(hostile, "manifest.json")));
      gateTop.codexAppServer = codex;
      writeFileSync(
        join(hostile, "manifest.json"),
        `${JSON.stringify(gateTop)}\n`,
      );
      for (const name of [
        "gate-attestation.json",
        "codex-app-server.manifest.json",
        "protocol/codex-app-server.manifest.json",
        "manifest.json",
      ]) {
        refreshChecksumRecord(topChecksums, hostile, name);
      }
      assert.notEqual(verify().status, 0, "gate model drift rejected");
      restore([
        "gate-attestation.json",
        "codex-app-server.manifest.json",
        "protocol/codex-app-server.manifest.json",
        "manifest.json",
        "SHA256SUMS",
      ]);

      const gateIntegers = {
        formatVersion: 1,
        runCount: 3,
        turns: 6,
        actions: 3,
        writes: 3,
        tools: 0,
        approvals: 0,
      };
      for (const [label, values] of [
        [
          "gate integer values",
          Object.fromEntries(
            Object.entries(gateIntegers).map(([key, value]) => [key, value + 1]),
          ),
        ],
        [
          "gate boolean values",
          Object.fromEntries(
            Object.entries(gateIntegers).map(([key, value]) => [
              key,
              value === 0 ? false : true,
            ]),
          ),
        ],
      ]) {
        const changedGate = JSON.parse(
          read(join(hostile, "gate-attestation.json")),
        );
        Object.assign(changedGate, values);
        writeFileSync(
          join(hostile, "gate-attestation.json"),
          `${JSON.stringify(changedGate)}\n`,
        );
        const changedCodex = JSON.parse(
          read(join(hostile, "codex-app-server.manifest.json")),
        );
        changedCodex.gateAttestationSha256 = sha256File(
          join(hostile, "gate-attestation.json"),
        );
        for (const name of [
          "codex-app-server.manifest.json",
          "protocol/codex-app-server.manifest.json",
        ]) {
          writeFileSync(
            join(hostile, name),
            `${JSON.stringify(changedCodex)}\n`,
          );
        }
        const changedTop = JSON.parse(read(join(hostile, "manifest.json")));
        changedTop.codexAppServer = changedCodex;
        writeFileSync(
          join(hostile, "manifest.json"),
          `${JSON.stringify(changedTop)}\n`,
        );
        for (const name of [
          "gate-attestation.json",
          "codex-app-server.manifest.json",
          "protocol/codex-app-server.manifest.json",
          "manifest.json",
        ]) {
          refreshChecksumRecord(topChecksums, hostile, name);
        }
        assert.notEqual(verify().status, 0, `${label} rejected`);
        restore([
          "gate-attestation.json",
          "codex-app-server.manifest.json",
          "protocol/codex-app-server.manifest.json",
          "manifest.json",
          "SHA256SUMS",
        ]);
      }

      const sourceCodex = JSON.parse(
        read(join(hostile, "codex-app-server.manifest.json")),
      );
      sourceCodex.sourceIdentity.inode = "01";
      for (const name of [
        "codex-app-server.manifest.json",
        "protocol/codex-app-server.manifest.json",
      ]) {
        writeFileSync(join(hostile, name), `${JSON.stringify(sourceCodex)}\n`);
      }
      const sourceTop = JSON.parse(read(join(hostile, "manifest.json")));
      sourceTop.codexAppServer = sourceCodex;
      writeFileSync(
        join(hostile, "manifest.json"),
        `${JSON.stringify(sourceTop)}\n`,
      );
      const sourceGate = JSON.parse(read(join(hostile, "gate-attestation.json")));
      sourceGate.codexIdentity = sourceCodex.sourceIdentity;
      writeFileSync(
        join(hostile, "gate-attestation.json"),
        `${JSON.stringify(sourceGate)}\n`,
      );
      sourceCodex.gateAttestationSha256 = sha256File(
        join(hostile, "gate-attestation.json"),
      );
      for (const name of [
        "codex-app-server.manifest.json",
        "protocol/codex-app-server.manifest.json",
      ]) {
        writeFileSync(join(hostile, name), `${JSON.stringify(sourceCodex)}\n`);
      }
      sourceTop.codexAppServer = sourceCodex;
      writeFileSync(
        join(hostile, "manifest.json"),
        `${JSON.stringify(sourceTop)}\n`,
      );
      const snapshotPath = join(
        hostile,
        "protocol/codex-app-server/manifest.json",
      );
      const snapshot = JSON.parse(read(snapshotPath));
      snapshot.codexIdentity = sourceCodex.sourceIdentity;
      writeFileSync(snapshotPath, `${JSON.stringify(snapshot)}\n`);
      for (const name of [
        "gate-attestation.json",
        "codex-app-server.manifest.json",
        "protocol/codex-app-server.manifest.json",
        "protocol/codex-app-server/manifest.json",
        "manifest.json",
      ]) {
        refreshChecksumRecord(topChecksums, hostile, name);
      }
      assert.notEqual(verify().status, 0, "source identity format rejected");
      restore([
        "gate-attestation.json",
        "codex-app-server.manifest.json",
        "protocol/codex-app-server.manifest.json",
        "protocol/codex-app-server/manifest.json",
        "manifest.json",
        "SHA256SUMS",
      ]);

      const schemaName =
        "protocol/codex-app-server/ClientRequest.json";
      const schemaPath = join(hostile, schemaName);
      const schemaRaw = readFileSync(schemaPath);
      const changedSchema = Buffer.from(
        schemaRaw.toString("utf8").replace(
          /"description":"/,
          '"description":"tampered ',
        ),
      );
      assert.notDeepEqual(changedSchema, schemaRaw);
      writeFileSync(schemaPath, changedSchema);
      const protocolRoot = join(hostile, "protocol/codex-app-server");
      refreshChecksumRecord(
        join(protocolRoot, "SHA256SUMS"),
        protocolRoot,
        "ClientRequest.json",
      );
      refreshChecksumRecord(topChecksums, hostile, schemaName);
      refreshChecksumRecord(
        topChecksums,
        hostile,
        "protocol/codex-app-server/SHA256SUMS",
      );
      assert.notEqual(verify().status, 0, "schema digest drift rejected");
      restore([
        schemaName,
        "protocol/codex-app-server/SHA256SUMS",
        "SHA256SUMS",
      ]);

      const fifo = join(hostile, "unmanifested-fifo");
      const fifoResult = spawnSync("/usr/bin/mkfifo", [fifo], {
        encoding: "utf8",
      });
      assert.equal(
        fifoResult.status,
        0,
        `${fifoResult.stdout}${fifoResult.stderr}`,
      );
      chmodSync(fifo, 0o444);
      assert.notEqual(verify().status, 0, "special node rejected");
    } finally {
      spawnSync("/usr/bin/chmod", ["-R", "u+w", hostile]);
      rmSync(hostile, { recursive: true, force: true });
    }
  });

  test("setup failure removes only newly created host directories", () => {
    const fakeRoot = mkdtempSync(join(tmpdir(), "firecrawl-host-setup-"));
    try {
      const result = spawnSync(
        join(HOST_RUNTIME, "install-root.sh"),
        [
          "--staging",
          staging,
          "--adapter-user",
          process.env.USER ?? "mamba",
          "--adapter-uid",
          String(process.getuid()),
        ],
        {
          encoding: "utf8",
          env: {
            ...process.env,
            FIRECRAWL_HOST_TEST_ROOT: fakeRoot,
            FIRECRAWL_HOST_TEST_FAIL_AT: "after-install-directories",
          },
        },
      );
      assert.notEqual(result.status, 0);
      assert.equal(existsSync(join(fakeRoot, "opt")), false);
      assert.equal(existsSync(join(fakeRoot, "etc")), false);
      assert.equal(existsSync(join(fakeRoot, "usr")), false);
      assert.deepEqual(readdirSync(join(fakeRoot, "run")), [
        "firecrawl-host-install.lock",
      ]);
    } finally {
      rmSync(fakeRoot, { recursive: true, force: true });
    }
  });

  test("installer rejects writable and wrong-owner privileged parents", () => {
    for (const fixture of [
      { name: "writable", mode: 0o777, expectedUid: undefined },
      {
        name: "wrong-owner",
        mode: 0o755,
        expectedUid: String(process.getuid() + 1),
      },
    ]) {
      const fakeRoot = mkdtempSync(
        join(tmpdir(), `firecrawl-host-parent-${fixture.name}-`),
      );
      try {
        mkdirSync(join(fakeRoot, "opt"), { mode: fixture.mode });
        chmodSync(join(fakeRoot, "opt"), fixture.mode);
        const env = {
          ...process.env,
          FIRECRAWL_HOST_TEST_ROOT: fakeRoot,
        };
        if (fixture.expectedUid) {
          env.FIRECRAWL_HOST_TEST_DIRECTORY_UID = fixture.expectedUid;
        }
        const result = spawnSync(
          join(HOST_RUNTIME, "install-root.sh"),
          [
            "--staging",
            staging,
            "--adapter-user",
            process.env.USER ?? "mamba",
            "--adapter-uid",
            String(process.getuid()),
          ],
          { encoding: "utf8", env },
        );
        assert.notEqual(result.status, 0, `${fixture.name} parent rejected`);
        assert.equal(
          statSync(join(fakeRoot, "opt")).mode & 0o777,
          fixture.mode,
          `${fixture.name} preexisting parent preserved`,
        );
      } finally {
        rmSync(fakeRoot, { recursive: true, force: true });
      }
    }
  });

  test("pre-publication failure removes group and transaction prerequisites", () => {
    const fakeRoot = mkdtempSync(join(tmpdir(), "firecrawl-host-prepublish-"));
    try {
      const result = spawnSync(
        join(HOST_RUNTIME, "install-root.sh"),
        [
          "--staging",
          staging,
          "--adapter-user",
          process.env.USER ?? "mamba",
          "--adapter-uid",
          String(process.getuid()),
        ],
        {
          encoding: "utf8",
          env: {
            ...process.env,
            FIRECRAWL_HOST_TEST_ROOT: fakeRoot,
            FIRECRAWL_HOST_TEST_GROUP_ACTIVATION: "active",
            FIRECRAWL_HOST_TEST_FAIL_AT: "before-generation-copy",
          },
        },
      );
      assert.notEqual(result.status, 0);
      assert.equal(
        existsSync(join(fakeRoot, "run/firecrawl-host-test-group")),
        false,
        "ordinary failure removes group prerequisite",
      );
      assert.equal(
        readdirSync(join(fakeRoot, "run")).some(name =>
          /^firecrawl-host-install-[0-9]+$/.test(name)
        ),
        false,
        "ordinary failure removes transaction root",
      );
      const generations = join(fakeRoot, "opt/firecrawl/generations");
      assert.equal(
        existsSync(generations) &&
          readdirSync(generations).some(name => name.startsWith(".new-")),
        false,
        "ordinary failure removes temporary generation",
      );
    } finally {
      rmSync(fakeRoot, { recursive: true, force: true });
    }
  });

  test("status 75 preserves only the group activation prerequisite", () => {
    const fakeRoot = mkdtempSync(join(tmpdir(), "firecrawl-host-stale-group-"));
    try {
      const result = spawnSync(
        join(HOST_RUNTIME, "install-root.sh"),
        [
          "--staging",
          staging,
          "--adapter-user",
          process.env.USER ?? "mamba",
          "--adapter-uid",
          String(process.getuid()),
        ],
        {
          encoding: "utf8",
          env: {
            ...process.env,
            FIRECRAWL_HOST_TEST_ROOT: fakeRoot,
            FIRECRAWL_HOST_TEST_GROUP_ACTIVATION: "stale",
          },
        },
      );
      assert.equal(result.status, 75, `${result.stdout}${result.stderr}`);
      assert.equal(
        existsSync(join(fakeRoot, "run/firecrawl-host-test-group/group")),
        true,
      );
      assert.equal(
        existsSync(join(fakeRoot, "run/firecrawl-host-test-group/membership")),
        true,
      );
      assert.equal(
        existsSync(join(fakeRoot, "opt/firecrawl")),
        false,
        "status 75 publishes no generation or system files",
      );
    } finally {
      rmSync(fakeRoot, { recursive: true, force: true });
    }
  });

  test("fake-root installer publishes and uninstalls one closed generation", () => {
    const fakeRoot = mkdtempSync(join(tmpdir(), "firecrawl-host-root-"));
    try {
      const installResult = spawnSync(
        join(HOST_RUNTIME, "install-root.sh"),
        [
          "--staging",
          staging,
          "--adapter-user",
          process.env.USER ?? "mamba",
          "--adapter-uid",
          String(process.getuid()),
        ],
        {
          encoding: "utf8",
          env: { ...process.env, FIRECRAWL_HOST_TEST_ROOT: fakeRoot },
        },
      );
      assert.equal(
        installResult.status,
        0,
        `${installResult.stdout}${installResult.stderr}`,
      );
      const current = join(fakeRoot, "opt/firecrawl/current");
      const target = readlinkSync(current);
      assert.match(target, /^generations\/host-[0-9a-f]{64}$/);
      assert.doesNotMatch(target, /\d+\.\d+\.\d+/);
      const generation = resolve(dirname(current), target);
      assert.deepEqual(
        readFileSync(join(generation, "manifest.json")),
        readFileSync(join(staging, "manifest.json")),
      );
      assert.equal(
        statSync(
          join(
            fakeRoot,
            "usr/local/libexec/firecrawl-acceptance-restart-broker",
          ),
        ).mode & 0o777,
        0o755,
      );
      assert.equal(
        read(
          join(
            fakeRoot,
            "usr/local/libexec/firecrawl-acceptance-restart-broker",
          ),
        ),
        read(
          join(
            HOST_RUNTIME,
            "libexec/firecrawl-acceptance-restart-broker",
          ),
        ),
      );
      assert.equal(
        readlinkSync(join(fakeRoot, "opt/firecrawl/sandbox-bundles")),
        "current/bundles",
      );
      assert.equal(
        readlinkSync(join(fakeRoot, "opt/firecrawl/protocol")),
        "current/protocol",
      );
      assert.equal(
        readlinkSync(join(fakeRoot, "opt/firecrawl/policy")),
        "current/policy",
      );
      const protocolLink = join(fakeRoot, "opt/firecrawl/protocol");
      rmSync(protocolLink);
      mkdirSync(protocolLink, { mode: 0o755 });
      writeFileSync(join(protocolLink, "sentinel"), "preexisting directory\n");
      const stableCollision = spawnSync(
        join(HOST_RUNTIME, "install-root.sh"),
        [
          "--staging",
          staging,
          "--adapter-user",
          process.env.USER ?? "mamba",
          "--adapter-uid",
          String(process.getuid()),
        ],
        {
          encoding: "utf8",
          env: { ...process.env, FIRECRAWL_HOST_TEST_ROOT: fakeRoot },
        },
      );
      assert.notEqual(stableCollision.status, 0, "stable directory collision");
      assert.equal(
        read(join(protocolLink, "sentinel")),
        "preexisting directory\n",
        "stable directory collision rolled back",
      );
      assert.equal(readlinkSync(current), target);
      rmSync(protocolLink, { recursive: true });
      symlinkSync("current/protocol", protocolLink);
      assert.equal(
        read(
          join(
            fakeRoot,
            "etc/systemd/system/firecrawl-sandbox-broker.service",
          ),
        ),
        read(join(HOST_RUNTIME, "systemd/firecrawl-sandbox-broker.service")),
      );
      const verifyGeneration = () =>
        spawnSync(
          "/usr/bin/python3",
          [
            join(HOST_RUNTIME, "verify-generation.py"),
            generation,
            String(process.getuid()),
          ],
          { encoding: "utf8" },
        );
      assert.equal(verifyGeneration().status, 0);
      writeFileSync(join(generation, "extra-file"), "unmanifested\n");
      assert.notEqual(verifyGeneration().status, 0, "extra file rejected");
      rmSync(join(generation, "extra-file"));
      const rootfsTarget = join(
        generation,
        "bundles/code-v1/rootfs/etc/hostname",
      );
      const rootfsBytes = readFileSync(rootfsTarget);
      writeFileSync(rootfsTarget, Buffer.concat([rootfsBytes, Buffer.from("x")]));
      assert.notEqual(verifyGeneration().status, 0, "rootfs drift rejected");
      writeFileSync(rootfsTarget, rootfsBytes);
      const hardlinkTarget = `${rootfsTarget}.hardlink`;
      linkSync(rootfsTarget, hardlinkTarget);
      assert.notEqual(verifyGeneration().status, 0, "rootfs hard link rejected");
      rmSync(hardlinkTarget);
      const protocolTarget = join(
        generation,
        "protocol/codex-app-server/ClientRequest.json",
      );
      const protocolBytes = readFileSync(protocolTarget);
      chmodSync(protocolTarget, 0o644);
      writeFileSync(
        protocolTarget,
        Buffer.concat([protocolBytes, Buffer.from(" ")]),
      );
      chmodSync(protocolTarget, 0o444);
      assert.notEqual(verifyGeneration().status, 0, "protocol drift rejected");
      chmodSync(protocolTarget, 0o644);
      writeFileSync(protocolTarget, protocolBytes);
      chmodSync(protocolTarget, 0o444);
      assert.equal(verifyGeneration().status, 0);

      const installedService = join(
        fakeRoot,
        "etc/systemd/system/firecrawl-sandbox-broker.service",
      );
      writeFileSync(installedService, "previous service\n");
      const lateFailure = spawnSync(
        join(HOST_RUNTIME, "install-root.sh"),
        [
          "--staging",
          staging,
          "--adapter-user",
          process.env.USER ?? "mamba",
          "--adapter-uid",
          String(process.getuid()),
        ],
        {
          encoding: "utf8",
          env: {
            ...process.env,
            FIRECRAWL_HOST_TEST_ROOT: fakeRoot,
            FIRECRAWL_HOST_TEST_FAIL_AT: "after-pointer",
          },
        },
      );
      assert.notEqual(lateFailure.status, 0);
      assert.equal(read(installedService), "previous service\n");
      assert.equal(readlinkSync(current), target);

      const hostile = mkdtempSync(join(tmpdir(), "firecrawl-host-hostile-"));
      chmodSync(hostile, 0o777);
      const rejected = spawnSync(
        join(HOST_RUNTIME, "install-root.sh"),
        [
          "--staging",
          hostile,
          "--adapter-user",
          process.env.USER ?? "mamba",
          "--adapter-uid",
          String(process.getuid()),
        ],
        {
          encoding: "utf8",
          env: { ...process.env, FIRECRAWL_HOST_TEST_ROOT: fakeRoot },
        },
      );
      assert.notEqual(rejected.status, 0);
      assert.equal(readlinkSync(current), target, "generation pointer rolled back");
      rmSync(hostile, { force: true, recursive: true });

      const unrelated = join(fakeRoot, "var/lib/firecrawl-browser-volume");
      mkdirSync(unrelated, { recursive: true });
      writeFileSync(join(unrelated, "keep"), "profile\n");
      const jobs = join(fakeRoot, "run/firecrawl-sandbox/jobs");
      mkdirSync(join(jobs, "firecrawl-active"), { recursive: true });
      const blocked = spawnSync(
        join(HOST_RUNTIME, "uninstall-root.sh"),
        [
          "--adapter-user",
          process.env.USER ?? "mamba",
          "--adapter-uid",
          String(process.getuid()),
        ],
        {
          encoding: "utf8",
          env: { ...process.env, FIRECRAWL_HOST_TEST_ROOT: fakeRoot },
        },
      );
      assert.notEqual(blocked.status, 0);
      assert.ok(existsSync(current));
      rmSync(jobs, { force: true, recursive: true });
      const uninstallResult = spawnSync(
        join(HOST_RUNTIME, "uninstall-root.sh"),
        [
          "--adapter-user",
          process.env.USER ?? "mamba",
          "--adapter-uid",
          String(process.getuid()),
        ],
        {
          encoding: "utf8",
          env: { ...process.env, FIRECRAWL_HOST_TEST_ROOT: fakeRoot },
        },
      );
      assert.equal(
        uninstallResult.status,
        0,
        `${uninstallResult.stdout}${uninstallResult.stderr}`,
      );
      assert.equal(existsSync(join(fakeRoot, "opt/firecrawl")), false);
      assert.equal(read(join(unrelated, "keep")), "profile\n");
    } finally {
      spawnSync("/usr/bin/chmod", ["-R", "u+w", fakeRoot]);
      rmSync(fakeRoot, { recursive: true, force: true });
    }
  });
} else {
  process.stdout.write("# FIRECRAWL_HOST_STAGING unset; staged-output validation skipped\n");
}

if (failed > 0) {
  process.stderr.write(`# ${failed} failed, ${passed} passed\n`);
  process.exitCode = 1;
} else {
  process.stdout.write(`# ${passed} passed\n`);
}
