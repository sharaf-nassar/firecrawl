test("artifact validator rejects tamper, traversal, and symlink", () => {
  const base = mkdtempSync(join(tmpdir(), "firecrawl-artifact-hostile-"));
  try {
    const tamper = join(base, "tamper");
    const [tamperRecord] = artifactFixture(tamper);
    writeFileSync(join(tamper, "files", tamperRecord.name), Buffer.from("tampered"));
    rejects(() => validateArtifactRoot(tamper), /size mismatch|magic rejected|checksum/);

    const traversal = join(base, "traversal");
    const [traversalRecord] = artifactFixture(traversal);
    traversalRecord.name = "../escape.png";
    writeFileSync(
      join(traversal, "manifest.json"),
      `${JSON.stringify([traversalRecord])}\n`,
    );
    rejects(() => validateArtifactRoot(traversal));

    const linked = join(base, "linked");
    const [linkedRecord] = artifactFixture(linked);
    rmSync(join(linked, "files", linkedRecord.name));
    symlinkSync("/etc/hosts", join(linked, "files", linkedRecord.name));
    rejects(() => validateArtifactRoot(linked), /symlink/);
  } finally {
    rmSync(base, { recursive: true, force: true });
  }
});

test("artifact validator rejects count, size, total, and hard links", () => {
  const base = mkdtempSync(join(tmpdir(), "firecrawl-artifact-limits-"));
  try {
    const count = join(base, "count");
    artifactFixture(count, 9);
    rejects(() => validateArtifactRoot(count), /too many/);

    const size = join(base, "size");
    const [sizeRecord] = artifactFixture(size);
    truncateSync(join(size, "files", sizeRecord.name), MAX_ARTIFACT_BYTES + 1);
    sizeRecord.byteSize = MAX_ARTIFACT_BYTES + 1;
    writeFileSync(join(size, "manifest.json"), `${JSON.stringify([sizeRecord])}\n`);
    rejects(() => validateArtifactRoot(size), /size rejected/);

    const total = join(base, "total");
    mkdirSync(join(total, "files"), { recursive: true, mode: 0o700 });
    chmodSync(total, 0o700);
    const totalRecords = [];
    for (let index = 0; index < 3; index += 1) {
      const artifactId = randomUUID();
      const name = `${artifactId}.png`;
      const length = index < 2 ? MAX_ARTIFACT_BYTES : 1;
      const bytes = Buffer.alloc(length);
      Buffer.from([0x89, 0x50, 0x4e, 0x47, 13, 10, 26, 10]).copy(bytes);
      writeFileSync(join(total, "files", name), bytes, { mode: 0o600 });
      totalRecords.push({
        artifactId,
        name,
        kind: "screenshot",
        contentType: "image/png",
        byteSize: length,
        checksum: sha256Bytes(bytes),
      });
    }
    writeFileSync(
      join(total, "manifest.json"),
      `${JSON.stringify(totalRecords)}\n`,
      { mode: 0o600 },
    );
    rejects(() => validateArtifactRoot(total), /total rejected/);

    const hardlink = join(base, "hardlink");
    const [hardlinkRecord] = artifactFixture(hardlink);
    copyFileSync(
      join(hardlink, "files", hardlinkRecord.name),
      join(base, "outside-copy"),
    );
    rmSync(join(hardlink, "files", hardlinkRecord.name));
    linkSync(
      join(base, "outside-copy"),
      join(hardlink, "files", hardlinkRecord.name),
    );
    rejects(() => validateArtifactRoot(hardlink), /hard link/);
  } finally {
    rmSync(base, { recursive: true, force: true });
  }
});

test("code seccomp permits AF_UNIX and AF_INET but rejects AF_INET6", () => {
  const seccomp = JSON.parse(read(join(POLICY, "code-seccomp.json")));
  assert.equal(seccomp.defaultAction, "SCMP_ACT_ERRNO");
  const allowed = new Set(
    seccomp.syscalls.flatMap(rule =>
      rule.action === "SCMP_ACT_ALLOW" ? rule.names : [],
    ),
  );
  for (const name of ["code-seccomp.json", "codex-seccomp.json"]) {
    const policy = JSON.parse(read(join(POLICY, name)));
    const clone3 = policy.syscalls.find(rule =>
      rule.names.length === 1 && rule.names[0] === "clone3"
    );
    assert.deepEqual(clone3, {
      names: ["clone3"],
      action: "SCMP_ACT_ERRNO",
      errnoRet: 38,
    });
  }
  for (const syscall of [
    "chmod",
    "connect",
    "fchmodat",
    "getpgrp",
    "kill",
    "mkdirat",
    "renameat",
    "rmdir",
    "setsid",
    "unlinkat",
    "vfork",
  ]) {
    assert.equal(allowed.has(syscall), true, `${syscall} required by code runtime`);
  }
  const clone3 = seccomp.syscalls.filter(rule => rule.names.includes("clone3"));
  assert.deepEqual(clone3, [
    { names: ["clone3"], action: "SCMP_ACT_ERRNO", errnoRet: 38 },
  ]);
  assert.equal(allowed.has("clone3"), false);
  const socketRules = seccomp.syscalls.filter(rule => rule.names.includes("socket"));
  const socketpairRules = seccomp.syscalls.filter(rule => rule.names.includes("socketpair"));
  const families = socketRules
    .flatMap(rule => rule.args ?? [])
    .filter(argument => argument.index === 0 && argument.op === "SCMP_CMP_EQ")
    .map(argument => argument.value)
    .sort((left, right) => left - right);
  assert.deepEqual(families, [1, 2]);
  assert.equal(families.includes(10), false);
  assert.equal(
    socketpairRules.some(rule =>
      (rule.args ?? []).some(
        argument =>
          argument.index === 0 &&
          argument.op === "SCMP_CMP_EQ" &&
          argument.value === 1,
      ),
    ),
    true,
  );
});

test("Rust binaries embed exact raw broker-contract digest", () => {
  const contract = readFileSync(join(PROTOCOL, "sandbox-broker-v1.contract.json"));
  const digest = sha256Bytes(contract);
  assert.equal(`${JSON.stringify(JSON.parse(contract))}\n`, contract.toString());
  const broker = read(join(REPOSITORY, "apps/sandbox-broker/src/protocol.rs"));
  const adapter = read(
    join(REPOSITORY, "apps/browser-execution-adapter/src/broker_client.rs"),
  );
  assert.equal(extractRustStringConstant(broker, "SHARED_CONTRACT_SHA256"), digest);
  assert.equal(extractRustStringConstant(adapter, "BROKER_CONTRACT_SHA256"), digest);
  assert.match(broker, /include_str!\([^)]*sandbox-broker-v1\.contract\.json/);
  assert.match(adapter, /include_str!\([^)]*sandbox-broker-v1\.contract\.json/);
});

test("checksum validator rejects tamper, traversal, duplicates, and self-entry", () => {
  const root = mkdtempSync(join(tmpdir(), "firecrawl-checksums-"));
  try {
    writeFileSync(join(root, "a"), "a", { mode: 0o600 });
    writeFileSync(join(root, "b"), "b", { mode: 0o600 });
    const valid = `${sha256File(join(root, "a"))}  a\n${sha256File(join(root, "b"))}  b\n`;
    writeFileSync(join(root, "SHA256SUMS"), valid, { mode: 0o600 });
    verifyChecksumManifest(join(root, "SHA256SUMS"), root);
    writeFileSync(join(root, "a"), "changed");
    rejects(() => verifyChecksumManifest(join(root, "SHA256SUMS"), root), /checksum/);
    for (const raw of [
      `${"a".repeat(64)}  ../escape\n`,
      `${"a".repeat(64)}  a\n${"b".repeat(64)}  a\n`,
      `${"a".repeat(64)}  SHA256SUMS\n`,
    ]) {
      writeFileSync(join(root, "SHA256SUMS"), raw);
      rejects(() => parseChecksumManifest(join(root, "SHA256SUMS")));
    }
  } finally {
    rmSync(root, { recursive: true, force: true });
  }
});

test("fake-root tree validation rejects symlinks and writable paths", () => {
  const root = mkdtempSync(join(tmpdir(), "firecrawl-fake-root-"));
  try {
    mkdirSync(join(root, "opt/firecrawl"), { recursive: true, mode: 0o700 });
    writeFileSync(join(root, "opt/firecrawl/manifest.json"), "{}\n", { mode: 0o600 });
    validateTree(root);
    symlinkSync("/etc/hosts", join(root, "opt/firecrawl/escape"));
    rejects(() => validateTree(root), /symlink/);
    rmSync(join(root, "opt/firecrawl/escape"));
    chmodSync(join(root, "opt/firecrawl/manifest.json"), 0o622);
    rejects(() => validateTree(root), /writable/);
  } finally {
    rmSync(root, { recursive: true, force: true });
  }
});

test("systemd units lock socket, cgroup, and adapter identities", () => {
  const socket = read(
    join(HOST_RUNTIME, "systemd/firecrawl-sandbox-broker.socket"),
  );
  assert.match(
    socket,
    /^ListenSequentialPacket=\/run\/firecrawl-sandbox\/broker\.sock$/m,
  );
  assert.match(
    socket,
    /^ExecStartPre=\/usr\/bin\/install -d -o root -g firecrawl-sandbox -m 0750 \/run\/firecrawl-sandbox$/m,
  );
  assert.match(socket, /^SocketUser=root$/m);
  assert.match(socket, /^SocketGroup=firecrawl-sandbox$/m);
  assert.match(socket, /^SocketMode=0660$/m);
  assert.match(socket, /^DirectoryMode=0750$/m);
  assert.match(socket, /^RemoveOnStop=yes$/m);

  const broker = read(
    join(HOST_RUNTIME, "systemd/firecrawl-sandbox-broker.service"),
  );
  assert.match(
    broker,
    /^ExecStart=\/usr\/local\/libexec\/firecrawl-sandbox-broker$/m,
  );
  assert.match(broker, /^Delegate=cpu memory pids io$/m);
  assert.match(broker, /^DelegateSubgroup=broker$/m);
  assert.match(
    broker,
    /^ReadWritePaths=\/run\/firecrawl-sandbox \/sys\/fs\/cgroup\/system\.slice\/firecrawl-sandbox-broker\.service$/m,
  );
  assert.doesNotMatch(broker, /^PrivateNetwork=/m);
  assert.doesNotMatch(broker, /^ProtectControlGroups=/m);
  assert.doesNotMatch(broker, /^MemoryDenyWriteExecute=/m);

  const adapter = read(
    join(HOST_RUNTIME, "systemd/firecrawl-execution-adapter.service"),
  );
  assert.match(
    adapter,
    /^ExecStart=\/usr\/local\/libexec\/firecrawl-browser-execution-adapter$/m,
  );
  assert.match(
    adapter,
    /^Environment=FIRECRAWL_ADAPTER_SOCKET=%t\/firecrawl\/adapter\.sock$/m,
  );
  assert.match(adapter, /^RuntimeDirectory=firecrawl$/m);
  assert.match(adapter, /^RuntimeDirectoryMode=0700$/m);
  assert.match(adapter, /^UMask=0077$/m);
  assert.match(adapter, /^Restart=on-failure$/m);
  assert.doesNotMatch(adapter, /^ProtectSystem=/m);
  assert.doesNotMatch(adapter, /^ProtectHome=/m);
});

