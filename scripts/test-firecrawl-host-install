    [],
    ["--staging-only", "--output", "relative"],
    ["--verify-installed-identity", "--manifest", "relative"],
    ["--unknown"],
  ]) {
    const result = spawnSync("node", [build, ...args], {
      encoding: "utf8",
      timeout: 2_000,
    });
