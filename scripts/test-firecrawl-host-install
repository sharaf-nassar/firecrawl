test("Codex manifest validator rejects drift", () => {
  const valid = {
    formatVersion: 1,
    sourceIdentity: {
      executablePath: "/opt/codex/bin/codex",
      resolvedPath: "/opt/codex/lib/codex.js",
      device: "1",
      inode: "2",
      version: "1.2.3",
    },
    artifactSha256: "a".repeat(64),
    protocolSha256: "b".repeat(64),
    featureSha256: "c".repeat(64),
    gateAttestationSha256: "d".repeat(64),
    model: "gpt-5.6-terra",
    reasoningEffort: "medium",
    buildTimestamp: "2026-07-27T00:00:00.000Z",
  };
  validateCodexManifest(structuredClone(valid));
  for (const mutation of [
    value => {
      value.extra = true;
    },
    value => {
      value.model = "other";
    },
    value => {
      value.sourceIdentity.version = "v1.2.3";
    },
    value => {
      value.sourceIdentity.inode = "01";
    },
    value => {
      value.artifactSha256 = "A".repeat(64);
    },
  ]) {
    const changed = structuredClone(valid);
    mutation(changed);
    rejects(() => validateCodexManifest(changed));
  }
});

