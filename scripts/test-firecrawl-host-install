    assert.match(result.stderr, /host_build_arguments_invalid/);
  }
});

test("Dockerfiles are pinned, non-root, and runtime-Docker-free", () => {
  const codex = read(join(BUNDLES, "codex/Dockerfile"));
  const code = read(join(BUNDLES, "code/Dockerfile"));
  for (const dockerfile of [codex, code]) {
    for (const from of dockerfile.matchAll(/^FROM\s+(\S+)/gm)) {
      assert.match(from[1], /@sha256:[0-9a-f]{64}$/);
    }
    assert.match(dockerfile, /^USER 65532:65532$/m);
    assert.doesNotMatch(dockerfile, /docker\.sock|\/var\/run\/docker/i);
  }
  assert.doesNotMatch(codex, /relay|playwright|mcp/i);
  assert.doesNotMatch(code, /\bcodex\b/i);
  for (const dependency of [
    "playwright@1.61.1",
    "ws@8.21.1",
    "playwright==1.61.0",
    "greenlet==3.5.4",
    "pyee==13.0.1",
    "typing-extensions==4.16.0",
  ]) {
    assert.ok(code.includes(dependency), `missing exact dependency ${dependency}`);
  }
  const copied = /^COPY ([^\n]+) \/opt\/firecrawl\/bin\/$/m.exec(code);
  assert.ok(copied, "code executable COPY inventory missing");
  assert.deepEqual(copied[1].split(/\s+/), [
    "job-init.py",
    "job-relay-supervisor.mjs",
    "run-node.mjs",
    "run-python.py",
    "run-bash.sh",
    "agent-browser.py",
    "cdp-relay.mjs",
  ]);
});

