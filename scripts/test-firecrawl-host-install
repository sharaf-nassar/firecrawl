test("code wrappers reject unexpected invocation before execution", () => {
  const init = spawnSync("python3", [join(BUNDLES, "code/job-init.py")], {
    encoding: "utf8",
    timeout: 2_000,
  });
  assert.notEqual(init.status, 0);
  assert.match(init.stderr, /invalid_job_init_invocation/);
  const supervisor = spawnSync("node", [join(BUNDLES, "code/job-relay-supervisor.mjs")], {
    encoding: "utf8",
    timeout: 2_000,
  });
  assert.notEqual(supervisor.status, 0);
  assert.match(supervisor.stderr, /invalid_runner/);
  const source = {
    node: read(join(BUNDLES, "code/run-node.mjs")),
    python: read(join(BUNDLES, "code/run-python.py")),
    bash: read(join(BUNDLES, "code/run-bash.sh")),
    relay: read(join(BUNDLES, "code/cdp-relay.mjs")),
    agent: read(join(BUNDLES, "code/agent-browser.py")),
  };
  assert.match(source.node, /process\.argv\.length\s*!==\s*2/);
  assert.match(
    source.python,
    /(?:sys\.argv\[1:\]\s*!=\s*\[\]|len\(sys\.argv\)\s*!=\s*1)/,
  );
  assert.match(source.bash, /\[\[\s+\$#\s+-eq\s+0\s+\]\]/);
  assert.match(source.relay, /process\.argv\.length\s*!==\s*3/);
  assert.match(source.agent, /invalid_agent_browser_invocation/);
});

test("artifact helpers encode closed limits and safe creation", () => {
  for (const name of ["run-node.mjs", "run-python.py", "agent-browser.py"]) {
    const source = read(join(BUNDLES, "code", name));
    assert.match(source, /MAX_ARTIFACTS\s*=\s*8/);
    assert.match(source, /MAX_ARTIFACT_BYTES\s*=\s*16\s*\*\s*1024\s*\*\s*1024/);
    assert.match(source, /MAX_ARTIFACT_TOTAL\s*=\s*32\s*\*\s*1024\s*\*\s*1024/);
    assert.match(source, /artifact\.sock/);
    assert.doesNotMatch(source, /ARTIFACT_ROOT|manifest\.json|O_EXCL|O_NOFOLLOW/);
    assert.doesNotMatch(source, /save[Aa]rtifact\s*\([^)]*(?:path|name|key|id)/);
  }
  const supervisor = read(join(BUNDLES, "code/job-relay-supervisor.mjs"));
  assert.match(supervisor, /MAX_ARTIFACTS\s*=\s*8/);
  assert.match(
    supervisor,
    /MAX_ARTIFACT_BYTES\s*=\s*16\s*\*\s*1024\s*\*\s*1024/,
  );
  assert.match(
    supervisor,
    /MAX_ARTIFACT_TOTAL\s*=\s*32\s*\*\s*1024\s*\*\s*1024/,
  );
  assert.match(supervisor, /O_EXCL/);
  assert.match(supervisor, /O_NOFOLLOW/);
  assert.match(supervisor, /terminateProcessGroup/);
  assert.match(supervisor, /resetArtifactRoot/);
  const broker = read(join(REPOSITORY, "apps/sandbox-broker/src/oci.rs"));
  assert.match(broker, /const MAX_ARTIFACT_COUNT: usize = 8;/);
  assert.match(broker, /const MAX_ARTIFACT_BYTES: u64 = 16 \* 1024 \* 1024;/);
  assert.match(
    broker,
    /const MAX_ARTIFACT_TOTAL_BYTES: u64 = 32 \* 1024 \* 1024;/,
  );
  assert.match(
    broker,
    /OPENAT2_RESOLVE_BENEATH \| OPENAT2_RESOLVE_NO_SYMLINKS/,
  );
  assert.match(broker, /metadata\.nlink\(\) != 1/);
});

test("artifact validator accepts one closed fixture", () => {
  const root = mkdtempSync(join(tmpdir(), "firecrawl-artifact-valid-"));
  try {
    artifactFixture(root);
    assert.equal(validateArtifactRoot(root).length, 1);
  } finally {
