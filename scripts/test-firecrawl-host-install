#!/usr/bin/env node

import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import { createHash, randomUUID } from "node:crypto";
import {
  chmodSync,
  copyFileSync,
  existsSync,
  lstatSync,
  linkSync,
  mkdirSync,
  mkdtempSync,
  readFileSync,
  readlinkSync,
  readdirSync,
  realpathSync,
  rmSync,
  statSync,
  symlinkSync,
  truncateSync,
  writeFileSync,
} from "node:fs";
import { tmpdir } from "node:os";
import { dirname, join, relative, resolve, sep } from "node:path";
import { fileURLToPath } from "node:url";

const SCRIPT = fileURLToPath(import.meta.url);
const REPOSITORY = resolve(dirname(SCRIPT), "..");
const BUNDLES = join(REPOSITORY, "host/browser-runtime/bundles");
const POLICY = join(REPOSITORY, "host/browser-runtime/policy");
const PROTOCOL = join(REPOSITORY, "host/browser-runtime/protocol");
const HOST_RUNTIME = join(REPOSITORY, "host/browser-runtime");
const SHA256 = /^[0-9a-f]{64}$/;
const SEMVER =
  /^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$/;
const SAFE_RELATIVE = /^(?!\/)(?!.*(?:^|\/)\.\.(?:\/|$))[A-Za-z0-9._/@-]+$/;
const UUID_NAME =
  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\.(?:png|jpg|zip|webm)$/;
const MAX_ARTIFACTS = 8;
const MAX_ARTIFACT_BYTES = 16 * 1024 * 1024;
const MAX_ARTIFACT_TOTAL = 32 * 1024 * 1024;

const EXPECTED_CONFIG = `model = "gpt-5.6-terra"
model_reasoning_effort = "medium"
approval_policy = "never"
sandbox_mode = "read-only"
web_search = "disabled"

[history]
persistence = "none"

[analytics]
enabled = false

[features]
apps = false
artifact = false
auth_elicitation = false
browser_use = false
browser_use_external = false
browser_use_full_cdp_access = false
code_mode = false
code_mode_host = false
code_mode_only = false
computer_use = false
enable_mcp_apps = false
goals = false
hooks = false
image_generation = false
in_app_browser = false
memories = false
multi_agent = false
plugins = false
plugin_sharing = false
remote_plugin = false
request_permissions_tool = false
shell_snapshot = false
shell_tool = false
skill_mcp_dependency_install = false
skill_search = false
standalone_web_search = false
tool_call_mcp_elicitation = false
tool_suggest = false
unified_exec = false
workspace_dependencies = false
`;

const REQUIRED_BUNDLE_FILES = [
  "codex/Dockerfile",
  "codex/codex-app-server.manifest.schema.json",
  "code/Dockerfile",
  "code/job-init.py",
  "code/job-relay-supervisor.mjs",
  "code/run-node.mjs",
  "code/run-python.py",
  "code/run-bash.sh",
  "code/agent-browser.py",
  "code/cdp-relay.mjs",
];
const GATE = await import(
  `${new URL("./codex-browser-gate/gate-contract.mjs", import.meta.url)}?test=${Date.now()}`
);

let passed = 0;
let failed = 0;
let totalTests = 0;

function test(name, callback) {
  totalTests += 1;
  try {
    callback();
    passed += 1;
    process.stdout.write(`ok ${totalTests} - ${name}\n`);
  } catch (error) {
    failed += 1;
    process.stderr.write(`not ok ${totalTests} - ${name}\n`);
    process.stderr.write(`  ${error.stack || error}\n`);
  }
}

function ownKeys(value, expected, label) {
  assert.deepEqual(Object.keys(value).sort(), [...expected].sort(), `${label} keys`);
}

function regularFile(path, label = path) {
  const metadata = lstatSync(path);
  assert.equal(metadata.isSymbolicLink(), false, `${label} must not be a symlink`);
  assert.equal(metadata.isFile(), true, `${label} must be a regular file`);
  assert.equal(metadata.nlink, 1, `${label} must have one hard link`);
  return metadata;
}

function directory(path, label = path) {
  const metadata = lstatSync(path);
  assert.equal(metadata.isSymbolicLink(), false, `${label} must not be a symlink`);
  assert.equal(metadata.isDirectory(), true, `${label} must be a directory`);
  return metadata;
}

function read(path) {
  regularFile(path);
  return readFileSync(path, "utf8");
}

function sha256Bytes(bytes) {
  return createHash("sha256").update(bytes).digest("hex");
}

function sha256File(path) {
  return sha256Bytes(readFileSync(path));
}

function extractRawRustConstant(source, name) {
  const pattern = new RegExp(
    `(?:pub\\s+)?const\\s+${name}\\s*:\\s*&str\\s*=\\s*r#"(.*?)"#;`,
    "s",
  );
  const match = pattern.exec(source);
  assert.ok(match, `${name} raw Rust constant missing`);
  return match[1];
}

function extractRustStringConstant(source, name) {
  const pattern = new RegExp(
    `(?:pub\\s+)?const\\s+${name}\\s*:\\s*&str\\s*=\\s*"([0-9a-f]{64})";`,
  );
  const match = pattern.exec(source);
  assert.ok(match, `${name} Rust digest missing`);
  return match[1];
}

function validateManifestSchema(schema) {
  ownKeys(
    schema,
    ["$schema", "$id", "type", "additionalProperties", "required", "properties", "$defs"],
    "Codex manifest schema",
  );
  assert.equal(schema.$schema, "https://json-schema.org/draft/2020-12/schema");
  assert.equal(schema.type, "object");
  assert.equal(schema.additionalProperties, false);
  assert.deepEqual(schema.required, [
    "formatVersion",
    "sourceIdentity",
    "artifactSha256",
    "protocolSha256",
    "featureSha256",
    "gateAttestationSha256",
    "model",
    "reasoningEffort",
    "buildTimestamp",
  ]);
  ownKeys(schema.properties, schema.required, "Codex manifest schema properties");
  assert.equal(schema.properties.formatVersion.const, 1);
  assert.equal(schema.properties.model.const, "gpt-5.6-terra");
  assert.equal(schema.properties.reasoningEffort.const, "medium");
  assert.equal(schema.properties.sourceIdentity.additionalProperties, false);
  assert.deepEqual(schema.properties.sourceIdentity.required, [
    "executablePath",
    "resolvedPath",
    "device",
    "inode",
    "version",
  ]);
  ownKeys(
    schema.properties.sourceIdentity.properties,
    schema.properties.sourceIdentity.required,
    "source identity schema",
  );
  assert.equal(schema.$defs.sha256.pattern, "^[0-9a-f]{64}$");
  assert.equal(schema.properties.sourceIdentity.properties.version.pattern, SEMVER.source);
}

function validateCodexManifest(manifest) {
  const keys = [
    "formatVersion",
    "sourceIdentity",
    "artifactSha256",
    "protocolSha256",
    "featureSha256",
    "gateAttestationSha256",
    "model",
    "reasoningEffort",
    "buildTimestamp",
  ];
  ownKeys(manifest, keys, "Codex manifest");
  assert.equal(manifest.formatVersion, 1);
  assert.equal(manifest.model, "gpt-5.6-terra");
  assert.equal(manifest.reasoningEffort, "medium");
  assert.equal(typeof manifest.buildTimestamp, "string");
  assert.equal(new Date(manifest.buildTimestamp).toISOString(), manifest.buildTimestamp);
  ownKeys(
    manifest.sourceIdentity,
    ["executablePath", "resolvedPath", "device", "inode", "version"],
    "source identity",
  );
  assert.match(manifest.sourceIdentity.executablePath, /^\//);
  assert.match(manifest.sourceIdentity.resolvedPath, /^\//);
  assert.match(manifest.sourceIdentity.device, /^(0|[1-9][0-9]*)$/);
  assert.match(manifest.sourceIdentity.inode, /^(0|[1-9][0-9]*)$/);
  assert.match(manifest.sourceIdentity.version, SEMVER);
  for (const key of [
    "artifactSha256",
    "protocolSha256",
    "featureSha256",
    "gateAttestationSha256",
  ]) {
    assert.match(manifest[key], SHA256, key);
  }
  return manifest;
}

function parseChecksumManifest(path) {
  const raw = read(path);
  assert.ok(raw.endsWith("\n"), `${path} must end in newline`);
  const records = raw
    .slice(0, -1)
    .split("\n")
    .map(line => {
      const match = /^([0-9a-f]{64})  ([A-Za-z0-9._/@-]+)$/.exec(line);
      assert.ok(match, `invalid checksum record: ${line}`);
      assert.match(match[2], SAFE_RELATIVE);
      assert.equal(match[2].split("/").includes(".."), false);
      assert.notEqual(match[2], "SHA256SUMS");
      return { digest: match[1], name: match[2] };
    });
  assert.ok(records.length > 0, `${path} must not be empty`);
  const names = records.map(record => record.name);
  assert.deepEqual(names, [...names].sort(), `${path} must be sorted`);
  assert.equal(new Set(names).size, names.length, `${path} must be unique`);
  return records;
}

function verifyChecksumManifest(path, root = dirname(path)) {
  for (const record of parseChecksumManifest(path)) {
    const target = join(root, record.name);
    assert.ok(
      resolve(target).startsWith(`${resolve(root)}${sep}`),
      "checksum target escaped root",
    );
    regularFile(target, record.name);
    assert.equal(sha256File(target), record.digest, `${record.name} checksum`);
  }
}

function refreshChecksumRecord(path, root, name) {
  const records = parseChecksumManifest(path);
  assert.equal(records.some(record => record.name === name), true);
  writeFileSync(
    path,
    `${records
      .map(record =>
        `${record.name === name ? sha256File(join(root, name)) : record.digest}  ${record.name}`
      )
      .join("\n")}\n`,
  );
}

function copyStagingFixture(staging, prefix) {
  const root = mkdtempSync(join(tmpdir(), prefix));
  const result = spawnSync(
    "/usr/bin/cp",
    ["-a", "--reflink=auto", `${staging}/.`, root],
    { encoding: "utf8" },
  );
  assert.equal(result.status, 0, `${result.stdout}${result.stderr}`);
  return root;
}

function expectedArtifactType(bytes) {
  if (bytes.subarray(0, 8).equals(Buffer.from([0x89, 0x50, 0x4e, 0x47, 13, 10, 26, 10]))) {
    return ["screenshot", "image/png", "png"];
  }
  if (bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) {
    return ["screenshot", "image/jpeg", "jpg"];
  }
  if (
    bytes.subarray(0, 4).equals(Buffer.from([0x50, 0x4b, 0x03, 0x04])) ||
    bytes.subarray(0, 4).equals(Buffer.from([0x50, 0x4b, 0x05, 0x06]))
  ) {
    return ["trace", "application/zip", "zip"];
  }
  if (bytes.subarray(0, 4).equals(Buffer.from([0x1a, 0x45, 0xdf, 0xa3]))) {
    return ["recording", "video/webm", "webm"];
  }
  assert.fail("artifact magic rejected");
}

function validateArtifactRoot(root) {
  const rootMetadata = directory(root, "artifact root");
  assert.equal(rootMetadata.mode & 0o022, 0, "artifact root writable by group/other");
  const manifestPath = join(root, "manifest.json");
  const manifestMetadata = regularFile(manifestPath, "artifact manifest");
  assert.ok(manifestMetadata.size <= 64 * 1024, "artifact manifest too large");
  const records = JSON.parse(readFileSync(manifestPath, "utf8"));
  assert.ok(Array.isArray(records), "artifact manifest must be an array");
  assert.ok(records.length <= MAX_ARTIFACTS, "too many artifacts");
  const filesRoot = join(root, "files");
  const filesMetadata = directory(filesRoot, "artifact files");
  assert.equal(filesMetadata.dev, rootMetadata.dev, "artifact files device mismatch");
  assert.equal(filesMetadata.mode & 0o022, 0, "artifact files writable by group/other");
  const names = new Set();
  const ids = new Set();
  let total = 0;
  for (const record of records) {
    ownKeys(
      record,
      ["artifactId", "name", "kind", "contentType", "byteSize", "checksum"],
      "artifact record",
    );
    assert.match(record.artifactId, /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/);
    assert.match(record.name, UUID_NAME);
    assert.ok(record.name.startsWith(`${record.artifactId}.`), "artifact ID/name mismatch");
    assert.equal(ids.has(record.artifactId), false, "duplicate artifact ID");
    assert.equal(names.has(record.name), false, "duplicate artifact name");
    ids.add(record.artifactId);
    names.add(record.name);
    assert.ok(
      Number.isSafeInteger(record.byteSize) &&
        record.byteSize > 0 &&
        record.byteSize <= MAX_ARTIFACT_BYTES,
      "artifact size rejected",
    );
    total += record.byteSize;
    assert.ok(total <= MAX_ARTIFACT_TOTAL, "artifact total rejected");
    assert.match(record.checksum, SHA256);
    const target = join(filesRoot, record.name);
    assert.equal(dirname(target), filesRoot, "artifact traversal");
    const metadata = regularFile(target, "artifact");
    assert.equal(metadata.dev, rootMetadata.dev, "artifact device mismatch");
    assert.equal(metadata.size, record.byteSize, "artifact size mismatch");
    assert.ok(metadata.blocks * 512 >= metadata.size, "sparse artifact rejected");
    assert.equal(metadata.mode & 0o022, 0, "artifact writable by group/other");
    const bytes = readFileSync(target);
    const [kind, contentType, extension] = expectedArtifactType(bytes);
    assert.equal(record.kind, kind);
    assert.equal(record.contentType, contentType);
    assert.ok(record.name.endsWith(`.${extension}`));
    assert.equal(sha256Bytes(bytes), record.checksum, "artifact checksum mismatch");
  }
  assert.deepEqual(
    readdirSync(filesRoot).sort(),
    [...names].sort(),
    "unmanifested artifact file",
  );
  return records;
}

function artifactFixture(root, count = 1) {
  mkdirSync(join(root, "files"), { recursive: true, mode: 0o700 });
  chmodSync(root, 0o700);
  chmodSync(join(root, "files"), 0o700);
  const records = [];
  for (let index = 0; index < count; index += 1) {
    const artifactId = randomUUID();
    const name = `${artifactId}.png`;
    const bytes = Buffer.concat([
      Buffer.from([0x89, 0x50, 0x4e, 0x47, 13, 10, 26, 10]),
      Buffer.from(`fixture-${index}`),
    ]);
    writeFileSync(join(root, "files", name), bytes, { mode: 0o600 });
    records.push({
      artifactId,
      name,
      kind: "screenshot",
      contentType: "image/png",
      byteSize: bytes.byteLength,
      checksum: sha256Bytes(bytes),
    });
  }
  writeFileSync(join(root, "manifest.json"), `${JSON.stringify(records)}\n`, {
    mode: 0o600,
  });
  return records;
}

function rejects(callback, pattern) {
  assert.throws(callback, pattern);
}

function requireCommand(command, args = ["--version"]) {
  const result = spawnSync(command, args, { encoding: "utf8" });
  assert.notEqual(result.error?.code, "ENOENT", `${command} is required`);
}

function runSyntax(command, args, label) {
  const result = spawnSync(command, args, { encoding: "utf8" });
  assert.equal(
    result.status,
    0,
    `${label} syntax failed:\n${result.stdout}${result.stderr}`,
  );
}

function validateTree(root, { skipBundleRootfs = false } = {}) {
  const rootMetadata = directory(root);
  assert.equal(rootMetadata.mode & 0o022, 0, `writable tree root: ${root}`);
  const visit = current => {
    for (const entry of readdirSync(current)) {
      const path = join(current, entry);
      const metadata = lstatSync(path);
      assert.equal(metadata.isSymbolicLink(), false, `staged symlink: ${path}`);
      assert.equal(metadata.mode & 0o022, 0, `writable staged path: ${path}`);
      const name = relative(root, path).split(sep).join("/");
      if (metadata.isDirectory()) {
        if (
          !(
            skipBundleRootfs &&
            /^bundles\/(?:codex-v1|code-v1)\/rootfs$/.test(name)
          )
        ) {
          visit(path);
        }
      } else {
        assert.equal(metadata.isFile(), true, `special staged path: ${path}`);
      }
    }
  };
  visit(root);
}

function validateStaging(root) {
  assert.equal(resolve(root), realpathSync(root), "staging root must not be a symlink");
  validateTree(root, { skipBundleRootfs: true });
  const required = [
    "manifest.json",
    "SHA256SUMS",
    "codex-app-server.tar",
    "codex-app-server.manifest.json",
    "gate-attestation.json",
    "protocol/sandbox-broker-v1.contract.json",
    "protocol/codex-app-server.manifest.json",
    "protocol/codex-app-server/manifest.json",
    "protocol/codex-app-server/SHA256SUMS",
    "policy/bundles.json",
    "policy/codex-seccomp.json",
    "policy/code-seccomp.json",
    "bundles/codex-v1/rootfs.identity.json",
    "bundles/code-v1/rootfs.identity.json",
    "bin/firecrawl-sandbox-broker",
    "bin/firecrawl-browser-execution-adapter",
    "bin/acceptance-restart-broker",
  ];
  for (const name of required) assert.ok(existsSync(join(root, name)), `missing ${name}`);
  const neutralVisit = current => {
    for (const entry of readdirSync(current, { withFileTypes: true })) {
      const path = join(current, entry.name);
      const name = relative(root, path).split(sep).join("/");
      if (!name.includes("/rootfs/")) {
        assert.doesNotMatch(
          entry.name,
          /(?:^|[-_])v?\d+\.\d+\.\d+(?:[-+._]|$)/,
          `versioned staging name: ${name}`,
        );
      }
      if (entry.isDirectory() && !name.endsWith("/rootfs")) neutralVisit(path);
    }
  }
  neutralVisit(root);
  verifyChecksumManifest(join(root, "SHA256SUMS"), root);
  verifyChecksumManifest(
    join(root, "protocol/codex-app-server/SHA256SUMS"),
    join(root, "protocol/codex-app-server"),
  );
  const manifest = validateCodexManifest(
    JSON.parse(read(join(root, "codex-app-server.manifest.json"))),
  );
  const gateRaw = readFileSync(join(root, "gate-attestation.json"));
  const gate = JSON.parse(gateRaw);
  assert.equal(sha256Bytes(gateRaw), manifest.gateAttestationSha256);
  assert.deepEqual(gate.codexIdentity, manifest.sourceIdentity);
  assert.equal(gate.schemaSha256, manifest.protocolSha256);
  assert.equal(gate.featureSha256, manifest.featureSha256);
  assert.equal(gate.runCount, 3);
  assert.equal(gate.model, "gpt-5.6-terra");
  assert.equal(gate.reasoningEffort, "medium");
  assert.equal(gate.tools, 0);
  assert.equal(gate.approvals, 0);
  assert.equal(
    manifest.artifactSha256,
    sha256File(join(root, "codex-app-server.tar")),
    "Codex artifact digest",
  );
  const contract = readFileSync(join(root, "protocol/sandbox-broker-v1.contract.json"));
  assert.deepEqual(
    contract,
    readFileSync(join(PROTOCOL, "sandbox-broker-v1.contract.json")),
    "staged broker contract bytes",
  );
  const top = JSON.parse(read(join(root, "manifest.json")));
  ownKeys(
    top,
    [
      "formatVersion",
      "buildTimestamp",
      "codexAppServer",
      "codeRuntime",
      "bundleDigests",
      "policyHashes",
      "brokerContractSha256",
      "binaryHashes",
    ],
    "top host manifest",
  );
  assert.equal(top.formatVersion, 1);
  assert.equal(top.buildTimestamp, manifest.buildTimestamp);
  assert.deepEqual(top.codexAppServer, manifest, "embedded Codex manifest");
  assert.deepEqual(top.codeRuntime, {
    node: "22.22.1",
    python: "3.12.3",
    bash: "5.2.21",
    javascriptPlaywright: "1.61.1",
    pythonPlaywright: "1.61.0",
    relayProtocol: "code-relay-v1",
  });
  assert.equal(top.brokerContractSha256, sha256Bytes(contract));
  ownKeys(top.bundleDigests, ["codex-v1", "code-v1"], "bundle digests");
  ownKeys(
    top.policyHashes,
    ["bundles.json", "code-seccomp.json", "codex-seccomp.json"],
    "policy hashes",
  );
  ownKeys(
    top.binaryHashes,
    [
      "firecrawl-sandbox-broker",
      "firecrawl-browser-execution-adapter",
      "acceptance-restart-broker",
    ],
    "binary hashes",
  );
  for (const [name, digest] of Object.entries(top.policyHashes)) {
    assert.equal(digest, sha256File(join(root, "policy", name)), `${name} digest`);
    assert.deepEqual(
      readFileSync(join(root, "policy", name)),
      readFileSync(join(POLICY, name)),
      `${name} source bytes`,
    );
  }
  for (const [name, digest] of Object.entries(top.binaryHashes)) {
    assert.equal(digest, sha256File(join(root, "bin", name)), `${name} digest`);
  }
  for (const name of [
    "firecrawl-sandbox-broker",
    "firecrawl-browser-execution-adapter",
    "acceptance-restart-broker",
  ]) {
    const mode = statSync(join(root, "bin", name)).mode & 0o777;
    assert.equal(mode & 0o111, 0o100, `${name} owner executable`);
    assert.equal(mode & 0o077, 0, `${name} not private`);
  }
  for (const bundle of ["codex-v1", "code-v1"]) {
    const identity = JSON.parse(
      read(join(root, "bundles", bundle, "rootfs.identity.json")),
    );
    ownKeys(identity, ["version", "bundleId", "rootfsSha256"], `${bundle} identity`);
    assert.equal(identity.version, 1);
    assert.equal(identity.bundleId, bundle);
    assert.match(identity.rootfsSha256, SHA256);
    assert.equal(top.bundleDigests[bundle], identity.rootfsSha256);
    directory(join(root, "bundles", bundle, "rootfs"));
  }
  assert.deepEqual(
    readFileSync(join(root, "codex-app-server.manifest.json")),
    readFileSync(join(root, "protocol/codex-app-server.manifest.json")),
    "runtime Codex manifest bytes",
  );
  const snapshot = JSON.parse(
    read(join(root, "protocol/codex-app-server/manifest.json")),
  );
  assert.equal(snapshot.schemaDigest, manifest.protocolSha256);
}

test("static bundle inventory is exact", () => {
  const actual = [];
  for (const family of readdirSync(BUNDLES).sort()) {
    for (const entry of readdirSync(join(BUNDLES, family), { withFileTypes: true })) {
      assert.equal(entry.isSymbolicLink(), false, `bundle symlink: ${entry.name}`);
      if (entry.isFile()) actual.push(`${family}/${entry.name}`);
    }
  }
  assert.deepEqual(actual.sort(), [...REQUIRED_BUNDLE_FILES].sort());
  for (const name of actual) regularFile(join(BUNDLES, name));
});

test("Codex config is byte-identical and has no MCP table", () => {
  assert.equal(GATE.CONFIG, EXPECTED_CONFIG);
  const broker = read(join(REPOSITORY, "apps/sandbox-broker/src/bundles.rs"));
  const adapter = read(
    join(REPOSITORY, "apps/browser-execution-adapter/src/broker_client.rs"),
  );
  assert.equal(extractRawRustConstant(broker, "FIXED_CODEX_CONFIG"), EXPECTED_CONFIG);
  assert.equal(extractRawRustConstant(adapter, "CODEX_CONFIG"), EXPECTED_CONFIG);
  assert.doesNotMatch(EXPECTED_CONFIG, /(?:^|\n)\s*\[mcp_servers(?:\.|\])/);
  assert.doesNotMatch(EXPECTED_CONFIG, /\bmcp_servers\b/);
  assert.equal(
    [...EXPECTED_CONFIG.matchAll(/^([a-z0-9_]+) = false$/gm)].length,
    GATE.DISABLED_FEATURES.length + 1,
  );
  for (const feature of GATE.DISABLED_FEATURES) {
    assert.match(EXPECTED_CONFIG, new RegExp(`^${feature} = false$`, "m"));
  }
});

test("Codex manifest schema is closed and exact", () => {
