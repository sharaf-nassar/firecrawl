#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
project_name="${LOCAL_FIRECRAWL_PROJECT_NAME:-firecrawl}"
compose=(
  docker compose
  --project-name "$project_name"
  --project-directory "$repo_root"
  -f "$repo_root/compose.yaml"
)
compose_config_sources="$repo_root/compose.yaml"
legacy_compose_config_sources="$repo_root/compose.yaml,$repo_root/compose.local.yaml"
if [[ -n "${LOCAL_FIRECRAWL_COMPOSE_OVERRIDE:-}" ]]; then
  if [[ "$LOCAL_FIRECRAWL_COMPOSE_OVERRIDE" != /* ]] ||
    [[ ! -f "$LOCAL_FIRECRAWL_COMPOSE_OVERRIDE" ]] ||
    [[ -L "$LOCAL_FIRECRAWL_COMPOSE_OVERRIDE" ]] ||
    [[ "$(readlink -f -- "$LOCAL_FIRECRAWL_COMPOSE_OVERRIDE")" != "$LOCAL_FIRECRAWL_COMPOSE_OVERRIDE" ]]; then
    printf '%s\n' \
      'LOCAL_FIRECRAWL_COMPOSE_OVERRIDE must be a canonical file' >&2
    exit 64
  fi
  compose+=(-f "$LOCAL_FIRECRAWL_COMPOSE_OVERRIDE")
  compose_config_sources+=",$LOCAL_FIRECRAWL_COMPOSE_OVERRIDE"
fi
if [[ -n "${LOCAL_FIRECRAWL_ENV_FILE:-}" ]]; then
  compose+=(--env-file "$LOCAL_FIRECRAWL_ENV_FILE")
fi

control_runtime_root="${XDG_RUNTIME_DIR:-/run/user/${UID}}"
control_runtime_dir="$control_runtime_root/firecrawl-control"
runtime_lock_path="$control_runtime_dir/lifecycle.lock"
runtime_lock_held=
if [[ "$project_name" != firecrawl ]]; then
  if [[ ! "$project_name" =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]]; then
    printf '%s\n' 'LOCAL_FIRECRAWL_PROJECT_NAME is invalid' >&2
    exit 64
  fi
  runtime_lock_path="$control_runtime_dir/lifecycle.${project_name}.lock"
fi

lock_wait_seconds="${LOCAL_FIRECRAWL_LOCK_WAIT_SECONDS:-30}"
one_shot_timeout_seconds="${LOCAL_FIRECRAWL_ONE_SHOT_TIMEOUT_SECONDS:-300}"
health_wait_timeout_seconds="${LOCAL_FIRECRAWL_HEALTH_WAIT_TIMEOUT_SECONDS:-180}"
dependency_services=(
  playwright-service
  nuq-postgres
  redis
  rabbitmq
  app-postgres
  minio
)
base_long_running_services=(
  api
  browser-service
  browser-interaction-worker
  browser-interaction-egress-proxy
  "${dependency_services[@]}"
)
one_shot_services=(browser-state-init app-db-migrate minio-init)
long_running_services=("${base_long_running_services[@]}")
diagnostic_services=("${long_running_services[@]}" "${one_shot_services[@]}")
search_provider_mode=

usage() {
  printf '%s\n' \
    "Usage: ${0##*/} {start|stop|restart|lock-path|configure-search}" \
    "       ${0##*/} status [--json]" \
    "       ${0##*/} health [--json]" \
    "       ${0##*/} probe-egress" \
    "       ${0##*/} logs [all|api|searxng|browser-service|browser-interaction-worker|browser-interaction-egress-proxy] [correlation-id]" \
    >&2
}

validate_runtime_options() {
  if [[ ! "$lock_wait_seconds" =~ ^[1-9][0-9]*$ ]]; then
    printf '%s\n' \
      'LOCAL_FIRECRAWL_LOCK_WAIT_SECONDS must be a positive integer' >&2
    exit 64
  fi
  if [[ ! "$one_shot_timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
    printf '%s\n' \
      'LOCAL_FIRECRAWL_ONE_SHOT_TIMEOUT_SECONDS must be a positive integer' >&2
    exit 64
  fi
  if [[ ! "$health_wait_timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
    printf '%s\n' \
      'LOCAL_FIRECRAWL_HEALTH_WAIT_TIMEOUT_SECONDS must be a positive integer' >&2
    exit 64
  fi
}

resolve_local_codex_runtime() {
  local auth_mode
  local auth_path
  local ca_bundle_input
  local ca_bundle_path
  local command_path
  local package_dir
  local resolved_path
  local seen
  local -a resolved_entrypoints=()

  while IFS= read -r command_path; do
    if [[ "$command_path" != /* ]] || [[ "$command_path" == *$'\n'* ]]; then
      continue
    fi
    resolved_path="$(readlink -e -- "$command_path" 2>/dev/null || true)"
    if [[ -z "$resolved_path" ]] || [[ ! -f "$resolved_path" ]]; then
      continue
    fi
    seen=false
    for package_dir in "${resolved_entrypoints[@]}"; do
      if [[ "$package_dir" == "$resolved_path" ]]; then
        seen=true
        break
      fi
    done
    if [[ "$seen" == false ]]; then
      resolved_entrypoints+=("$resolved_path")
    fi
  done < <(type -a -P codex 2>/dev/null || true)

  if (( ${#resolved_entrypoints[@]} == 0 )); then
    printf '%s\n' \
      'Local Codex package is unavailable: codex is not an external executable on PATH' \
      >&2
    return 1
  fi
  if (( ${#resolved_entrypoints[@]} != 1 )); then
    printf '%s\n' \
      'Local Codex package is ambiguous: PATH resolves codex to multiple installations' \
      >&2
    return 1
  fi

  resolved_path="${resolved_entrypoints[0]}"
  package_dir="$(readlink -e -- "$(dirname -- "$(dirname -- "$resolved_path")")" \
    2>/dev/null || true)"
  if [[ -z "$package_dir" ]] ||
    [[ ! -f "$package_dir/package.json" ]] ||
    [[ "$(readlink -e -- "$package_dir/bin/codex.js" 2>/dev/null || true)" != "$resolved_path" ]] ||
    ! jq -e '
      .name == "@openai/codex" and
      .bin.codex == "bin/codex.js"
    ' "$package_dir/package.json" >/dev/null 2>&1; then
    printf '%s\n' \
      'Local Codex package is invalid: active codex is not an @openai/codex package entrypoint' \
      >&2
    return 1
  fi

  if [[ -z "${HOME:-}" ]] || [[ "$HOME" != /* ]]; then
    printf '%s\n' 'Local Codex auth is unavailable: HOME is not absolute' >&2
    return 1
  fi
  auth_path="$(readlink -e -- "$HOME/.codex/auth.json" 2>/dev/null || true)"
  if [[ -z "$auth_path" ]] || [[ ! -f "$auth_path" ]]; then
    printf '%s\n' \
      'Local Codex auth is unavailable: ~/.codex/auth.json is missing' >&2
    return 1
  fi
  if [[ "$(stat -c '%u:%h' -- "$auth_path")" != "$UID:1" ]]; then
    printf '%s\n' \
      'Local Codex auth is unsafe: ~/.codex/auth.json ownership or link count is invalid' \
      >&2
    return 1
  fi
  auth_mode="$(stat -c '%a' -- "$auth_path")"
  if [[ "$auth_mode" != 400 && "$auth_mode" != 600 ]]; then
    printf '%s\n' \
      'Local Codex auth is unsafe: ~/.codex/auth.json must use mode 0400 or 0600' \
      >&2
    return 1
  fi

  ca_bundle_input="${LOCAL_FIRECRAWL_CA_BUNDLE_FILE:-/etc/ssl/certs/ca-certificates.crt}"
  if [[ "$ca_bundle_input" != /* ]] || [[ "$ca_bundle_input" == *$'\n'* ]]; then
    printf '%s\n' \
      'Local CA bundle is invalid: LOCAL_FIRECRAWL_CA_BUNDLE_FILE must be absolute' \
      >&2
    return 1
  fi
  ca_bundle_path="$(readlink -e -- "$ca_bundle_input" 2>/dev/null || true)"
  if [[ -z "$ca_bundle_path" ]] || [[ ! -f "$ca_bundle_path" ]] ||
    [[ ! -r "$ca_bundle_path" ]] || [[ ! -s "$ca_bundle_path" ]]; then
    printf '%s\n' \
      'Local CA bundle is unavailable: expected a readable nonempty regular file' \
      >&2
    return 1
  fi

  export LOCAL_CODEX_PACKAGE_DIR="$package_dir"
  export LOCAL_CODEX_AUTH_FILE="$auth_path"
  export LOCAL_CODEX_CA_BUNDLE_FILE="$ca_bundle_path"
}

acquire_runtime_lock() {
  local mode="$1"
  local -a lock_mode=(--exclusive)
  local fd_identity
  local lock_identity

  if [[ "$mode" == shared ]]; then
    lock_mode=(--shared)
  fi
  if [[ "$control_runtime_root" != /* ]] ||
    [[ ! -d "$control_runtime_root" ]] ||
    [[ -L "$control_runtime_root" ]] ||
    [[ "$(readlink -f -- "$control_runtime_root")" != "$control_runtime_root" ]] ||
    [[ "$(stat -c '%u:%a' -- "$control_runtime_root")" != "$UID:700" ]]; then
    printf '%s\n' 'Lifecycle control runtime root is unsafe' >&2
    return 70
  fi
  if [[ ! -e "$control_runtime_dir" && ! -L "$control_runtime_dir" ]]; then
    install -d -m 0700 -- "$control_runtime_dir"
  fi
  if [[ ! -d "$control_runtime_dir" ]] ||
    [[ -L "$control_runtime_dir" ]] ||
    [[ "$(readlink -f -- "$control_runtime_dir")" != "$control_runtime_dir" ]] ||
    [[ "$(stat -c '%u:%a' -- "$control_runtime_dir")" != "$UID:700" ]]; then
    printf '%s\n' 'Lifecycle control directory is unsafe' >&2
    return 70
  fi
  umask 077
  if [[ ! -e "$runtime_lock_path" && ! -L "$runtime_lock_path" ]]; then
    ( set -o noclobber; : > "$runtime_lock_path" ) 2>/dev/null || true
  fi
  if [[ ! -f "$runtime_lock_path" ]] || [[ -L "$runtime_lock_path" ]]; then
    printf '%s\n' 'Lifecycle lock file is unsafe' >&2
    return 70
  fi
  lock_identity="$(stat -c '%d:%i:%u:%a:%h' -- "$runtime_lock_path")"
  if [[ ! "$lock_identity" =~ ^[0-9]+:[0-9]+:${UID}:600:1$ ]]; then
    printf '%s\n' 'Lifecycle lock ownership or mode is unsafe' >&2
    return 70
  fi
  exec {runtime_lock_fd}<> "$runtime_lock_path"
  fd_identity="$(stat -Lc '%d:%i:%u:%a:%h' \
    -- "/proc/$$/fd/$runtime_lock_fd")"
  if [[ "$fd_identity" != "$lock_identity" ]] ||
    [[ "$(stat -c '%d:%i:%u:%a:%h' -- "$runtime_lock_path")" != "$lock_identity" ]]; then
    printf '%s\n' 'Lifecycle lock changed while opening' >&2
    return 70
  fi
  if ! flock "${lock_mode[@]}" --timeout "$lock_wait_seconds" \
    --conflict-exit-code 75 "$runtime_lock_fd"; then
    printf 'Local Firecrawl maintenance lock is busy: %s\n' \
      "$runtime_lock_path" >&2
    exit 75
  fi
  if [[ "$(stat -c '%d:%i:%u:%a:%h' -- "$runtime_lock_path")" != "$lock_identity" ]]; then
    printf '%s\n' 'Lifecycle lock changed while waiting' >&2
    return 70
  fi
  runtime_lock_held="$mode"
}

prepare_recovery_compose_sources() {
  # Compose expands bind sources even for read-only recovery commands. These
  # inert placeholders let Compose address existing containers without
  # depending on the current Codex installation or auth seed.
  export LOCAL_CODEX_PACKAGE_DIR=/dev/null
  export LOCAL_CODEX_AUTH_FILE=/dev/null
  export LOCAL_CODEX_CA_BUNDLE_FILE=/dev/null
}

configure_search_provider_mode() {
  local endpoint
  local normalized_endpoint
  local rendered="$1"

  if ! endpoint="$(
    jq -er '.services.api.environment.SEARXNG_ENDPOINT | strings' \
      <<< "$rendered"
  )" || ! normalized_endpoint="$(
    printf '%s' "$endpoint" |
      node "$repo_root/scripts/normalize-searxng-endpoint.mjs"
  )" || [[ "$endpoint" != "$normalized_endpoint" ]]; then
    printf '%s\n' \
      'Local search provider invariant failed: endpoint must be normalized' \
      >&2
    return 1
  fi

  if [[ "$normalized_endpoint" == http://searxng:8080 ]]; then
    search_provider_mode=internal
    long_running_services=(searxng "${base_long_running_services[@]}")
  else
    search_provider_mode=external
    long_running_services=("${base_long_running_services[@]}")
  fi
  diagnostic_services=("${long_running_services[@]}" "${one_shot_services[@]}")
}

validate_search_provider_credentials() {
  local rendered="$1"

  if [[ "$search_provider_mode" != internal ]]; then
    return 0
  fi
  if ! jq -e '
    (.services.searxng.environment.SEARXNG_BRAVE_API_KEY_B64 // "") |
      strings | length > 0
  ' <<< "$rendered" >/dev/null 2>&1; then
    printf '%s\n' \
      'Brave Search API key is required for bundled search.' \
      'Run scripts/local-firecrawl configure-search before starting the local runtime.' >&2
    return 1
  fi
  if ! jq -e '
    .services.api.environment.SEARXNG_ENGINES == "braveapi,bing"
  ' <<< "$rendered" >/dev/null 2>&1; then
    printf '%s\n' \
      'Bundled search requires SEARXNG_ENGINES=braveapi,bing.' \
      'Run scripts/local-firecrawl configure-search to repair the local search configuration.' >&2
    return 1
  fi
}

validate_compose() {
  local failed_invariant
  local source_mode="${1:-current}"
  local rendered

  if [[ "$source_mode" == current ]]; then
    resolve_local_codex_runtime
  elif [[ "$source_mode" == recovery ]]; then
    prepare_recovery_compose_sources
  else
    printf '%s\n' 'Internal Compose validation mode is invalid' >&2
    return 70
  fi
  "${compose[@]}" --profile maintenance config --quiet
  rendered="$(
    "${compose[@]}" --profile maintenance config --format json
  )"
  if ! failed_invariant="$(
    jq -r \
    --arg codex_package "$LOCAL_CODEX_PACKAGE_DIR" \
    --arg codex_auth "$LOCAL_CODEX_AUTH_FILE" \
    --arg codex_ca_bundle "$LOCAL_CODEX_CA_BUNDLE_FILE" '
    [
      {
        name: "api_local_browser_service_enabled",
        ok: (.services.api.environment.LOCAL_BROWSER_SERVICE_ENABLED == "true")
      },
      {
        name: "api_local_search_web_only",
        ok: (.services.api.environment.LOCAL_SEARCH_WEB_ONLY == "true")
      },
      {
        name: "searxng_brave_credential_isolation",
        ok: (
          ((.services.searxng.environment // {}) | keys | sort) == [
            "FORCE_OWNERSHIP",
            "SEARXNG_BRAVE_API_KEY_B64",
            "SEARXNG_SECRET"
          ] and
          ([
            .services | to_entries[] |
            select(.key != "searxng") |
            (.value.environment // {}) |
            has("SEARXNG_BRAVE_API_KEY_B64") or
            has("FIRECRAWL_SEARXNG_BRAVE_API_KEY")
          ] | all(. == false))
        )
      },
      {
        name: "api_search_provider_bounds",
        ok: (
          .services.api.environment.SEARCH_PROVIDER_TIMEOUT_MS == "10000" and
          .services.api.environment.SEARCH_PROVIDER_MAX_RESULTS == "100" and
          .services.api.environment.SEARCH_PROVIDER_MAX_CONCURRENCY == "4"
        )
      },
      {
        name: "browser_service_local_enabled",
        ok: (
          .services["browser-service"].environment
            .LOCAL_BROWSER_SERVICE_ENABLED == "true"
        )
      },
      {
        name: "browser_service_session_limit",
        ok: (
          .services["browser-service"].environment.MAX_BROWSER_SESSIONS == "4"
        )
      },
      {
        name: "api_browser_service_key_format",
        ok: (
          (.services.api.environment.BROWSER_SERVICE_API_KEY // "") |
          test("^[A-Za-z0-9_-]{43}$")
        )
      },
      {
        name: "api_worker_token_format",
        ok: (
          (.services.api.environment.BROWSER_INTERACTION_WORKER_TOKEN // "") |
          test("^[A-Za-z0-9_-]{43}$")
        )
      },
      {
        name: "worker_token_consistency",
        ok: (
          .services.api.environment.BROWSER_INTERACTION_WORKER_TOKEN ==
          .services["browser-interaction-worker"].environment
            .BROWSER_INTERACTION_WORKER_TOKEN
        )
      },
      {
        name: "api_worker_socket_path",
        ok: (
          .services.api.environment.BROWSER_INTERACTION_WORKER_SOCKET_PATH ==
          "/run/firecrawl-interaction/worker.sock"
        )
      },
      {
        name: "worker_socket_path",
        ok: (
          .services["browser-interaction-worker"].environment
            .BROWSER_INTERACTION_WORKER_SOCKET_PATH ==
          "/run/firecrawl-interaction/worker.sock"
        )
      },
      {
        name: "api_worker_group",
        ok: (.services.api.group_add == ["1000"])
      },
      {
        name: "worker_user",
        ok: (.services["browser-interaction-worker"].user == "1000:1000")
      },
      {
        name: "worker_read_only_rootfs",
        ok: (.services["browser-interaction-worker"].read_only == true)
      },
      {
        name: "worker_capabilities",
        ok: (.services["browser-interaction-worker"].cap_drop == ["ALL"])
      },
      {
        name: "worker_no_new_privileges",
        ok: (
          (.services["browser-interaction-worker"].security_opt // []) |
          index("no-new-privileges:true") != null
        )
      },
      {
        name: "worker_pid_limit",
        ok: (.services["browser-interaction-worker"].pids_limit == 512)
      },
      {
        name: "worker_ca_environment",
        ok: (
          .services["browser-interaction-worker"].environment
            .CODEX_CA_CERTIFICATE ==
          "/run/certs/host-ca-certificates.crt" and
          .services["browser-interaction-worker"].environment.SSL_CERT_FILE ==
          "/run/certs/host-ca-certificates.crt" and
          .services["browser-interaction-worker"].environment
            .NODE_EXTRA_CA_CERTS ==
          "/run/certs/host-ca-certificates.crt"
        )
      },
      {
        name: "worker_proxy_environment",
        ok: (
          .services["browser-interaction-worker"].environment
            .MODEL_EGRESS_PROXY_SOCKET_PATH ==
          "/run/firecrawl-model-egress/proxy.sock" and
          .services["browser-interaction-worker"].environment.HTTP_PROXY ==
          "http://127.0.0.1:3128" and
          .services["browser-interaction-worker"].environment.HTTPS_PROXY ==
          "http://127.0.0.1:3128" and
          .services["browser-interaction-worker"].environment.http_proxy ==
          "http://127.0.0.1:3128" and
          .services["browser-interaction-worker"].environment.https_proxy ==
          "http://127.0.0.1:3128" and
          .services["browser-interaction-worker"].environment.NO_PROXY == "" and
          .services["browser-interaction-worker"].environment.no_proxy == ""
        )
      },
      {
        name: "worker_mounts",
        ok: ((
          [
            (.services["browser-interaction-worker"].volumes // [])[] | {
              type,
              source,
              target,
              read_only: (.read_only // false),
              create_host_path: .bind.create_host_path
            }
          ] |
          sort_by(.target)
        ) == [
          {
            type: "bind",
            source: $codex_package,
            target: "/opt/codex",
            read_only: true,
            create_host_path: false
          },
          {
            type: "bind",
            source: $codex_ca_bundle,
            target: "/run/certs/host-ca-certificates.crt",
            read_only: true,
            create_host_path: false
          },
          {
            type: "volume",
            source: "browser-interaction-socket",
            target: "/run/firecrawl-interaction",
            read_only: false,
            create_host_path: null
          },
          {
            type: "volume",
            source: "browser-interaction-egress-socket",
            target: "/run/firecrawl-model-egress",
            read_only: false,
            create_host_path: null
          },
          {
            type: "bind",
            source: $codex_auth,
            target: "/run/secrets/codex-auth.json",
            read_only: true,
            create_host_path: false
          },
          {
            type: "volume",
            source: "codex-auth-state",
            target: "/var/lib/firecrawl-codex-auth-state",
            read_only: false,
            create_host_path: null
          }
        ])
      },
      {
        name: "worker_network_disabled",
        ok: (
          .services["browser-interaction-worker"].network_mode == "none" and
          ((.services["browser-interaction-worker"].networks // {}) |
            length == 0)
        )
      },
      {
        name: "api_networks",
        ok: ((
          (.services.api.networks // {}) | keys | sort
        ) == ["backend"])
      },
      {
        name: "model_uplink_exclusive",
        ok: ((
          [
            .services | to_entries[] |
            select((.value.networks // {}) | has("model-uplink")) | .key
          ]
        ) == ["browser-interaction-egress-proxy"])
      },
      {
        name: "egress_proxy_networks",
        ok: (
          (.services["browser-interaction-egress-proxy"].networks // {}) |
          keys == ["model-uplink"]
        )
      },
      {
        name: "egress_proxy_identity",
        ok: (
          .services["browser-interaction-egress-proxy"].user == "1000:1000" and
          .services["browser-interaction-egress-proxy"].read_only == true and
          .services["browser-interaction-egress-proxy"].cap_drop == ["ALL"] and
          .services["browser-interaction-egress-proxy"].pids_limit == 64 and
          ((.services["browser-interaction-egress-proxy"].security_opt // []) |
            index("no-new-privileges:true") != null)
        )
      },
      {
        name: "egress_proxy_mounts",
        ok: ((
          [
            (.services["browser-interaction-egress-proxy"].volumes // [])[] | {
              type,
              source,
              target,
              read_only: (.read_only // false),
              create_host_path: .bind.create_host_path
            }
          ]
        ) == [
          {
            type: "volume",
            source: "browser-interaction-egress-socket",
            target: "/run/firecrawl-model-egress",
            read_only: false,
            create_host_path: null
          }
        ])
      },
      {
        name: "egress_proxy_no_external_surface",
        ok: (
          ((.services["browser-interaction-egress-proxy"].ports // []) |
            length == 0) and
          ((.services["browser-interaction-egress-proxy"].expose // []) |
            length == 0) and
          ((.services["browser-interaction-egress-proxy"].volumes // []) |
            map(.target) | index("/var/run/docker.sock") == null)
        )
      },
      {
        name: "egress_proxy_secret_minimization",
        ok: (
          (.services["browser-interaction-egress-proxy"].environment // {}) |
          keys == ["MODEL_EGRESS_PROXY_SOCKET_PATH"]
        )
      },
      {
        name: "egress_socket_exclusive",
        ok: ((
          [
            .services | to_entries[] |
            select(
              ((.value.volumes // []) |
                map(.source) |
                index("browser-interaction-egress-socket")) != null
            ) |
            .key
          ] | sort
        ) == [
          "browser-interaction-egress-proxy",
          "browser-interaction-worker"
        ])
      },
      {
        name: "api_mounts",
        ok: ((
          [
            (.services.api.volumes // [])[] | {
              type,
              source,
              target,
              read_only: (.read_only // false)
            }
          ] |
          sort_by(.target)
        ) == [
          {
            type: "volume",
            source: "browser-interaction-socket",
            target: "/run/firecrawl-interaction",
            read_only: true
          },
          {
            type: "volume",
            source: "fdb-cluster-file",
            target: "/var/fdb",
            read_only: true
          }
        ])
      },
      {
        name: "worker_no_ports",
        ok: (
          (.services["browser-interaction-worker"].ports // []) | length == 0
        )
      },
      {
        name: "worker_no_expose",
        ok: (
          (.services["browser-interaction-worker"].expose // []) | length == 0
        )
      },
      {
        name: "worker_secret_minimization",
        ok: (
          (.services["browser-interaction-worker"].environment // {}) |
          has("BROWSER_SERVICE_API_KEY") == false and
          has("BROWSER_REPLAY_INGEST_API_KEY") == false and
          has("APPLICATION_DATABASE_URL") == false and
          has("ARTIFACT_MINIO_ACCESS_KEY") == false and
          has("ARTIFACT_MINIO_SECRET_KEY") == false and
          has("MINIO_ROOT_USER") == false and
          has("MINIO_ROOT_PASSWORD") == false
        )
      },
      {
        name: "external_ports_api_only",
        ok: ((
          [
            .services | to_entries[] |
            select((.value.ports // []) | length > 0) | .key
          ]
        ) == ["api"])
      },
      {
        name: "migration_backend_network",
        ok: (
          (.services["app-db-migrate"].networks // {}) | has("backend")
        )
      }
    ] |
    map(select(.ok | not)) |
    .[0].name // empty
  ' <<< "$rendered" 2>/dev/null
  )"; then
    failed_invariant=compose_schema_invalid
  fi
  if [[ -n "$failed_invariant" ]]; then
    printf 'Local browser environment invariant failed: %s\n' \
      "$failed_invariant" >&2
    return 1
  fi
  configure_search_provider_mode "$rendered"
  if [[ "$source_mode" == current ]]; then
    validate_search_provider_credentials "$rendered"
  fi
}

known_legacy_compose_sources() {
  local config_sources="$1"
  local saw_local=
  local saw_root=
  local source
  local -a sources

  IFS=',' read -r -a sources <<< "$config_sources"
  if (( ${#sources[@]} == 0 )); then
    return 1
  fi
  for source in "${sources[@]}"; do
    case "$source" in
      "$repo_root/compose.yaml")
        [[ -z "$saw_root" ]] || return 1
        saw_root=1
        ;;
      "$repo_root/compose.local.yaml")
        [[ -z "$saw_local" ]] || return 1
        saw_local=1
        ;;
      "$repo_root/docker-compose.yaml") ;;
      *) return 1 ;;
    esac
  done
  [[ -n "$saw_root" || -n "$saw_local" ]]
}

api_container_provenance() {
  local api_container_id="$1"
  local config_sources
  local environment
  local mounts
  local project
  local service
  local working_dir

  config_sources="$(
    docker inspect --format \
      '{{index .Config.Labels "com.docker.compose.project.config_files"}}' \
      "$api_container_id"
  )" || { printf '%s\n' unknown; return; }
  environment="$(
    docker inspect --format \
      '{{range .Config.Env}}{{println .}}{{end}}' \
      "$api_container_id"
  )" || { printf '%s\n' unknown; return; }
  mounts="$(
    docker inspect --format \
      '{{range .Mounts}}{{println .Destination}}{{end}}' \
      "$api_container_id" | sed '/^$/d' | LC_ALL=C sort
  )" || { printf '%s\n' unknown; return; }
  project="$(
    docker inspect --format \
      '{{index .Config.Labels "com.docker.compose.project"}}' \
      "$api_container_id"
  )" || { printf '%s\n' unknown; return; }
  service="$(
    docker inspect --format \
      '{{index .Config.Labels "com.docker.compose.service"}}' \
      "$api_container_id"
  )" || { printf '%s\n' unknown; return; }
  working_dir="$(
    docker inspect --format \
      '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' \
      "$api_container_id"
  )" || { printf '%s\n' unknown; return; }

  if [[ "$project" != "$project_name" ]] ||
    [[ "$service" != api ]] ||
    [[ "$working_dir" != "$repo_root" ]]; then
    printf '%s\n' unknown_identity
    return
  fi

  if [[ "$config_sources" == "$compose_config_sources" ]] &&
    grep -Fxq 'LOCAL_BROWSER_SERVICE_ENABLED=true' <<< "$environment" &&
    [[ "$mounts" == $'/run/firecrawl-interaction\n/var/fdb' ]]; then
    printf '%s\n' current
    return
  fi
  if [[ "$config_sources" == "$legacy_compose_config_sources" ]] &&
    grep -Fxq 'LOCAL_BROWSER_SERVICE_ENABLED=true' <<< "$environment" &&
    [[ "$mounts" == $'/run/firecrawl-interaction\n/var/fdb' ]]; then
    printf '%s\n' legacy
    return
  fi

  if known_legacy_compose_sources "$config_sources" &&
    [[ "$mounts" == /var/fdb ]]; then
    printf '%s\n' legacy
    return
  fi

  if known_legacy_compose_sources "$config_sources" &&
    [[ "$mounts" == $'/run/firecrawl-adapter\n/var/fdb' ]]; then
    printf '%s\n' legacy
    return
  fi

  if ! known_legacy_compose_sources "$config_sources"; then
    printf '%s\n' unknown_sources
  elif [[ "$mounts" != /var/fdb ]] &&
    [[ "$mounts" != $'/run/firecrawl-adapter\n/var/fdb' ]] &&
    [[ "$mounts" != $'/run/firecrawl-interaction\n/var/fdb' ]]; then
    printf 'unknown_mounts:%s\n' "${mounts//$'\n'/,}"
  else
    printf '%s\n' unknown_environment
  fi
}

browser_worker_container_provenance() {
  local worker_container_id="$1"
  local config_sources
  local mounts
  local project
  local service
  local working_dir

  config_sources="$(
    docker inspect --format \
      '{{index .Config.Labels "com.docker.compose.project.config_files"}}' \
      "$worker_container_id"
  )" || { printf '%s\n' unknown; return; }
  project="$(
    docker inspect --format \
      '{{index .Config.Labels "com.docker.compose.project"}}' \
      "$worker_container_id"
  )" || { printf '%s\n' unknown; return; }
  service="$(
    docker inspect --format \
      '{{index .Config.Labels "com.docker.compose.service"}}' \
      "$worker_container_id"
  )" || { printf '%s\n' unknown; return; }
  working_dir="$(
    docker inspect --format \
      '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' \
      "$worker_container_id"
  )" || { printf '%s\n' unknown; return; }
  mounts="$(
    docker inspect --format \
      '{{range .Mounts}}{{println .Type "|" .Destination "|" .RW}}{{end}}' \
      "$worker_container_id" | sed '/^$/d' | LC_ALL=C sort
  )" || { printf '%s\n' unknown; return; }

  if [[ "$config_sources" == "$compose_config_sources" ]] &&
    [[ "$project" == "$project_name" ]] &&
    [[ "$service" == browser-interaction-worker ]] &&
    [[ "$working_dir" == "$repo_root" ]] &&
    [[ "$mounts" == $'bind | /opt/codex | false\nbind | /run/certs/host-ca-certificates.crt | false\nbind | /run/secrets/codex-auth.json | false\nvolume | /run/firecrawl-interaction | true\nvolume | /run/firecrawl-model-egress | true\nvolume | /var/lib/firecrawl-codex-auth-state | true' ]]; then
    printf '%s\n' current
    return
  fi
  if [[ "$config_sources" == "$compose_config_sources" ]] &&
    [[ "$project" == "$project_name" ]] &&
    [[ "$service" == browser-interaction-worker ]] &&
    [[ "$working_dir" == "$repo_root" ]] &&
    [[ "$mounts" == $'bind | /opt/codex | false\nbind | /run/secrets/codex-auth.json | false\nvolume | /run/firecrawl-interaction | true\nvolume | /var/lib/firecrawl-codex-auth-state | true' ]]; then
    printf '%s\n' legacy
    return
  fi
  if [[ "$config_sources" == "$compose_config_sources" ]] &&
    [[ "$project" == "$project_name" ]] &&
    [[ "$service" == browser-interaction-worker ]] &&
    [[ "$working_dir" == "$repo_root" ]] &&
    [[ "$mounts" == $'bind | /opt/codex | false\nbind | /run/certs/host-ca-certificates.crt | false\nbind | /run/secrets/codex-auth.json | false\nvolume | /run/firecrawl-interaction | true\nvolume | /var/lib/firecrawl-codex-auth-state | true' ]]; then
    printf '%s\n' legacy
    return
  fi
  if [[ "$config_sources" == "$legacy_compose_config_sources" ]] &&
    [[ "$project" == "$project_name" ]] &&
    [[ "$service" == browser-interaction-worker ]] &&
    [[ "$working_dir" == "$repo_root" ]] &&
    [[ "$mounts" == $'bind | /opt/codex | false\nbind | /run/certs/host-ca-certificates.crt | false\nbind | /run/secrets/codex-auth.json | false\nvolume | /run/firecrawl-interaction | true\nvolume | /var/lib/firecrawl-codex-auth-state | true' ]]; then
    printf '%s\n' legacy
    return
  fi
  if [[ "$config_sources" == "$legacy_compose_config_sources" ]] &&
    [[ "$project" == "$project_name" ]] &&
    [[ "$service" == browser-interaction-worker ]] &&
    [[ "$working_dir" == "$repo_root" ]] &&
    [[ "$mounts" == $'bind | /opt/codex | false\nbind | /run/secrets/codex-auth.json | false\nvolume | /run/firecrawl-interaction | true\nvolume | /var/lib/firecrawl-codex-auth-state | true' ]]; then
    printf '%s\n' legacy
    return
  fi
  if [[ "$config_sources" == "$legacy_compose_config_sources" ]] &&
    [[ "$project" == "$project_name" ]] &&
    [[ "$service" == browser-interaction-worker ]] &&
    [[ "$working_dir" == "$repo_root" ]] &&
    [[ "$mounts" == $'bind | /opt/codex | false\nbind | /run/secrets/codex-auth.json | false\nvolume | /var/lib/firecrawl-codex-auth-state | true' ]]; then
    printf '%s\n' legacy
    return
  fi

  printf '%s\n' unknown
}

validate_running_api_provenance() {
  local api_container_id
  local provenance

  api_container_id="$("${compose[@]}" ps -q api)"
  if [[ -z "$api_container_id" ]]; then
    return 0
  fi
  provenance="$(api_container_provenance "$api_container_id")"
  case "$provenance" in
    current|legacy) ;;
    *)
      printf 'API container provenance does not match: %s\n' \
        "$provenance" >&2
      return 1
      ;;
  esac
}

validate_running_project_provenance() {
  local worker_container_id

  validate_running_api_provenance
  worker_container_id="$(
    "${compose[@]}" ps --all -q browser-interaction-worker
  )"
  if [[ -z "$worker_container_id" ]]; then
    return 0
  fi
  if [[ "$worker_container_id" == *$'\n'* ]] ||
    [[ ! "$worker_container_id" =~ ^[0-9a-f]{64}$ ]] ||
    [[ ! "$(browser_worker_container_provenance "$worker_container_id")" =~ ^(current|legacy)$ ]]; then
    printf '%s\n' \
      'Browser interaction worker provenance or mount shape does not match' \
      >&2
    return 1
  fi
}

require_current_api_provenance() {
  local api_container_id

  api_container_id="$("${compose[@]}" ps -q api)"
  if [[ -z "$api_container_id" ]]; then
    printf '%s\n' 'API container provenance is unavailable' >&2
    return 1
  fi
  if [[ "$(api_container_provenance "$api_container_id")" != current ]]; then
    printf '%s\n' \
      'API container predates Docker-only browser runtime; run scripts/local-firecrawl restart' \
      >&2
    return 1
  fi
}

build_runtime_images() {
  "${compose[@]}" build \
    api browser-state-init browser-service browser-interaction-egress-proxy \
    browser-interaction-worker playwright-service
}

load_one_shot_state() {
  local service="$1"
  local ids
  local snapshot

  ids="$("${compose[@]}" ps --all -q "$service")" || return 1
  one_shot_container_id=
  one_shot_status=missing
  one_shot_running=false
  one_shot_oom_killed=false
  one_shot_exit_code=0
  if [[ -z "$ids" ]]; then
    return 0
  fi
  if [[ "$ids" == *$'\n'* ]] || [[ ! "$ids" =~ ^[0-9a-f]{64}$ ]]; then
    printf '%s container identity is ambiguous\n' "$service" >&2
    return 1
  fi
  snapshot="$(
    docker inspect --format \
      '{{.State.Status}}|{{.State.Running}}|{{.State.OOMKilled}}|{{.State.ExitCode}}' \
      "$ids"
  )" || return 1
  IFS='|' read -r \
    one_shot_status one_shot_running one_shot_oom_killed \
    one_shot_exit_code <<< "$snapshot"
  if [[ ! "$one_shot_status" =~ ^(created|running|exited|paused|restarting|removing|dead)$ ]] ||
    [[ ! "$one_shot_running" =~ ^(true|false)$ ]] ||
    [[ ! "$one_shot_oom_killed" =~ ^(true|false)$ ]] ||
    [[ ! "$one_shot_exit_code" =~ ^[0-9]+$ ]] ||
    (( one_shot_exit_code > 255 )); then
    printf '%s container state is invalid\n' "$service" >&2
    return 1
  fi
  one_shot_container_id="$ids"
}

one_shot_state_summary() {
  printf 'status=%s,running=%s,exit=%s,oom=%s' \
    "$one_shot_status" "$one_shot_running" \
    "$one_shot_exit_code" "$one_shot_oom_killed"
}

remove_nonrunning_one_shot_remnant() {
  local service="$1"
  local container_id

  load_one_shot_state "$service" || return 1
  container_id="$one_shot_container_id"
  if [[ -z "$container_id" ]]; then
    return 0
  fi
  if [[ "$one_shot_running" != false ]] ||
    [[ ! "$one_shot_status" =~ ^(created|exited)$ ]]; then
    printf '%s has a non-removable container: %s\n' \
      "$service" "$(one_shot_state_summary)" >&2
    return 1
  fi
  if ! timeout --verbose --signal=TERM --kill-after=5s 15s \
    docker rm "$container_id" >/dev/null; then
    printf '%s stopped container could not be removed\n' "$service" >&2
    return 1
  fi
}

cleanup_failed_one_shot() {
  local service="$1"
  local expected_container_id="$2"
  local container_id

  if ! load_one_shot_state "$service"; then
    printf '%s failed container cleanup is unproven\n' "$service" >&2
    return 1
  fi
  container_id="$one_shot_container_id"
  if [[ -z "$container_id" ]]; then
    return 0
  fi
  if [[ -n "$expected_container_id" &&
    "$container_id" != "$expected_container_id" ]]; then
    printf '%s failed container identity changed; cleanup refused\n' \
      "$service" >&2
    return 1
  fi
  if [[ "$one_shot_running" == true ]]; then
    if ! timeout --verbose --signal=TERM --kill-after=5s 20s \
      docker stop --timeout 10 "$container_id" >/dev/null; then
      printf '%s failed container did not stop\n' "$service" >&2
      return 1
    fi
    load_one_shot_state "$service" || return 1
    if [[ "$one_shot_container_id" != "$container_id" ]]; then
      printf '%s failed container identity changed after stop\n' \
        "$service" >&2
      return 1
    fi
  fi
  if [[ "$one_shot_running" != false ]] ||
    [[ ! "$one_shot_status" =~ ^(created|exited)$ ]]; then
    printf '%s failed container cleanup refused: %s\n' \
      "$service" "$(one_shot_state_summary)" >&2
    return 1
  fi
  if ! timeout --verbose --signal=TERM --kill-after=5s 15s \
    docker rm "$container_id" >/dev/null; then
    printf '%s failed stopped container could not be removed\n' \
      "$service" >&2
    return 1
  fi
}

report_one_shot_orchestration_failure() {
  local service="$1"
  local phase="$2"
  local status="$3"
  local classification=failed

  if (( status == 124 )); then
    classification='timed out'
  elif (( status == 137 )); then
    classification='was killed after termination failed'
  fi
  if load_one_shot_state "$service"; then
    printf '%s orchestration %s during %s (status: %s; %s)\n' \
      "$service" "$classification" "$phase" "$status" \
      "$(one_shot_state_summary)" >&2
  else
    printf '%s orchestration %s during %s (status: %s; state unavailable)\n' \
      "$service" "$classification" "$phase" "$status" >&2
  fi
}

require_completed_one_shot() {
  local service="$1"
  local state

  state="$(
    "${compose[@]}" ps --all --format '{{.State}} {{.ExitCode}}' "$service"
  )"
  if [[ "$state" != "exited 0" ]]; then
    printf '%s did not complete successfully (state: %s)\n' \
      "$service" "${state:-missing}" >&2
    return 1
  fi
}

run_one_shot() {
  local service="$1"
  local exit_code
  local wait_output
  local started_container_id
  local status

  remove_nonrunning_one_shot_remnant "$service" || return 1
  set +e
  timeout --verbose --signal=TERM --kill-after=10s \
    "${one_shot_timeout_seconds}s" \
    "${compose[@]}" up -d --no-deps --no-build "$service"
  status=$?
  set -e
  if (( status != 0 )); then
    report_one_shot_orchestration_failure "$service" start "$status"
    cleanup_failed_one_shot "$service" "" || true
    return 1
  fi
  load_one_shot_state "$service" || {
    printf '%s orchestration could not identify its container\n' \
      "$service" >&2
    cleanup_failed_one_shot "$service" "" || true
    return 1
  }
  started_container_id="$one_shot_container_id"
  if [[ -z "$started_container_id" ]]; then
    printf '%s orchestration did not create a container\n' "$service" >&2
    return 1
  fi
  if [[ "$one_shot_running" == true ]]; then
    set +e
    wait_output="$(
      timeout --verbose --signal=TERM --kill-after=10s \
        "${one_shot_timeout_seconds}s" \
        docker wait "$started_container_id"
    )"
    status=$?
    set -e
    if (( status != 0 )); then
      report_one_shot_orchestration_failure "$service" wait "$status"
      cleanup_failed_one_shot "$service" "$started_container_id" || true
      return 1
    fi
    if [[ ! "$wait_output" =~ ^[0-9]+$ ]] ||
      (( wait_output < 0 || wait_output > 255 )); then
      printf '%s wait returned an invalid exit status\n' "$service" >&2
      cleanup_failed_one_shot "$service" "$started_container_id" || true
      return 1
    fi
    exit_code="$wait_output"
    load_one_shot_state "$service" || {
      printf '%s final container state is unavailable\n' "$service" >&2
      cleanup_failed_one_shot "$service" "$started_container_id" || true
      return 1
    }
    if [[ "$one_shot_container_id" != "$started_container_id" ]]; then
      printf '%s container identity changed while waiting\n' "$service" >&2
      return 1
    fi
  else
    exit_code="$one_shot_exit_code"
  fi
  if [[ "$one_shot_status" != exited ||
    "$one_shot_running" != false ||
    "$exit_code" != "$one_shot_exit_code" ]]; then
    printf '%s ended in an inconsistent state: %s\n' \
      "$service" "$(one_shot_state_summary)" >&2
    cleanup_failed_one_shot "$service" "$started_container_id" || true
    return 1
  fi
  if (( exit_code != 0 )); then
    printf '%s container exited %s (OOMKilled=%s)\n' \
      "$service" "$exit_code" "$one_shot_oom_killed" >&2
    cleanup_failed_one_shot "$service" "$started_container_id" || true
    return 1
  fi
  require_completed_one_shot "$service"
}

check_port_policy() {
  local project_state
  local expected_published_port="${PORT:-3002}"

  project_state="$("${compose[@]}" ps --all --format json)"
  PROJECT_STATE="$project_state" \
    EXPECTED_PUBLISHED_PORT="$expected_published_port" node - <<'NODE'
const input = process.env.PROJECT_STATE ?? "";
const expectedPublishedPort = Number(process.env.EXPECTED_PUBLISHED_PORT);
try {
  const containers = input
    .split("\n")
    .filter(Boolean)
    .map(line => JSON.parse(line));
  const published = containers.flatMap(container =>
    (container.Publishers ?? [])
      .filter(binding => Number(binding.PublishedPort) > 0)
      .map(binding => ({ service: container.Service, ...binding })),
  );
  const valid =
    published.length === 1 &&
    published[0].service === "api" &&
    published[0].URL === "127.0.0.1" &&
    Number(published[0].TargetPort) === 3002 &&
    Number(published[0].PublishedPort) === expectedPublishedPort &&
    published[0].Protocol === "tcp";
  if (!valid) {
    process.stderr.write(
      `Port policy failed: only api may publish 127.0.0.1:${expectedPublishedPort}\n`,
    );
    process.exit(1);
  }
} catch {
  process.stderr.write("Unable to validate Compose port policy\n");
  process.exit(1);
}
NODE
}

validate_browser_rollback_request() {
  if [[ "${LOCAL_FIRECRAWL_BROWSER_DOWNGRADE:-false}" != true ]]; then
    return
  fi
  if [[ -z "${FIRECRAWL_BROWSER_SERVICE_IMAGE:-}" ]] ||
    [[ ! "$FIRECRAWL_BROWSER_SERVICE_IMAGE" =~ @sha256:[a-f0-9]{64}$ ]]; then
    printf '%s\n' \
      'Browser downgrade requires an immutable FIRECRAWL_BROWSER_SERVICE_IMAGE' >&2
    exit 64
  fi
}

quiesce_browser_writers() {
  current_browser_container_id="$("${compose[@]}" ps -q browser-service)"
  "${compose[@]}" stop api browser-interaction-worker browser-service
  "${compose[@]}" stop browser-interaction-egress-proxy
}

check_browser_rollback_offline() {
  local current_browser_image_id

  if [[ "${LOCAL_FIRECRAWL_BROWSER_DOWNGRADE:-false}" != true ]]; then
    return
  fi
  if [[ -z "$current_browser_container_id" ]]; then
    printf '%s\n' \
      'Browser downgrade requires the current Browser Service to be running' >&2
    exit 1
  fi
  current_browser_image_id="$(
    docker inspect --format '{{.Image}}' "$current_browser_container_id"
  )"
  if [[ ! "$current_browser_image_id" =~ ^sha256:[a-f0-9]{64}$ ]]; then
    printf '%s\n' \
      'Current Browser Service image identity is unavailable' >&2
    exit 1
  fi
  docker run --rm --read-only --network none --user 1000:1000 \
    --cap-drop ALL --security-opt no-new-privileges \
    --volumes-from "$current_browser_container_id:ro" \
    --entrypoint /usr/local/bin/node "$current_browser_image_id" \
    scripts/check-atomic-publication-rollback.mjs \
    /var/lib/firecrawl-browser-volume/state
}

start_runtime() {
  run_one_shot browser-state-init
  "${compose[@]}" up -d --wait \
    --wait-timeout "$health_wait_timeout_seconds" \
    "${dependency_services[@]}"
  if [[ "$search_provider_mode" == internal ]]; then
    "${compose[@]}" up -d --no-deps --wait \
      --wait-timeout "$health_wait_timeout_seconds" searxng
  fi
  run_one_shot app-db-migrate
  run_one_shot minio-init
  "${compose[@]}" up -d --no-deps --wait \
    --wait-timeout "$health_wait_timeout_seconds" browser-service
  "${compose[@]}" up -d --no-deps --wait \
    --wait-timeout "$health_wait_timeout_seconds" \
    browser-interaction-egress-proxy
  "${compose[@]}" up -d --no-deps --wait \
    --wait-timeout "$health_wait_timeout_seconds" \
    browser-interaction-worker
  "${compose[@]}" up -d --no-deps --wait \
    --wait-timeout "$health_wait_timeout_seconds" api
  "${compose[@]}" exec -T api node -e \
    "fetch('http://127.0.0.1:' + (process.env.PORT || '3002') + '/', {
       signal: AbortSignal.timeout(10000),
     }).then(response => {
       if (response.status >= 500) process.exit(1);
     }).catch(() => process.exit(1))"
  require_current_api_provenance
  check_port_policy
}

remove_stale_bundled_search_provider() {
  local container_ids

  container_ids="$("${compose[@]}" ps --all -q searxng)"
  if [[ -z "$container_ids" ]]; then
    return
  fi
  if [[ "$container_ids" == *$'\n'* ]] ||
    [[ ! "$container_ids" =~ ^[0-9a-f]{64}$ ]]; then
    printf '%s\n' 'Bundled SearXNG container identity is ambiguous' >&2
    return 1
  fi
  "${compose[@]}" stop searxng
  "${compose[@]}" rm --force searxng
}

stop_search_provider_for_transition() {
  if [[ "$search_provider_mode" == internal ]]; then
    "${compose[@]}" stop searxng
  else
    remove_stale_bundled_search_provider
  fi
}

stop_runtime() {
  "${compose[@]}" stop api browser-interaction-worker browser-service
  "${compose[@]}" stop browser-interaction-egress-proxy
  stop_search_provider_for_transition
  "${compose[@]}" stop "${dependency_services[@]}"
}

probe_worker_egress() {
  "${compose[@]}" exec -T browser-interaction-worker node -e \
    "const net = require('node:net');
     const probe = authority => new Promise(resolve => {
       const socket = net.createConnection({
         host: '127.0.0.1',
         port: 3128,
       });
       let response = '';
       const finish = status => {
         socket.destroy();
         resolve({ authority, status });
       };
       socket.setTimeout(10000, () => finish(null));
       socket.on('error', () => finish(null));
       socket.on('connect', () => socket.write(
         'CONNECT ' + authority + ' HTTP/1.1\\r\\n' +
         'Host: ' + authority + '\\r\\n\\r\\n'
       ));
       socket.on('data', chunk => {
         response += chunk.toString('ascii');
         const match = /^HTTP\\/1\\.1 (\\d{3}) /u.exec(response);
         if (match) finish(Number(match[1]));
       });
     });
     (async () => {
       const results = [];
       for (const authority of [
         'api.openai.com:443',
         'chatgpt.com:443',
         'example.com:443',
         '169.254.169.254:443',
       ]) results.push(await probe(authority));
       process.stdout.write(JSON.stringify(results) + '\\n');
       const statuses = results.map(result => result.status);
       if (
         statuses[0] !== 200 ||
         statuses[1] !== 200 ||
         statuses[2] !== 403 ||
         statuses[3] !== 403
       ) process.exitCode = 1;
     })().catch(() => {
       process.stdout.write(
         JSON.stringify({ error: 'worker_egress_probe_failed' }) + '\\n'
       );
       process.exitCode = 1;
     });"
}

redact_local_logs() {
  sed -E \
    -e 's/("(authorization|bearer|token|secret|password|searxng_brave_api_key_b64|firecrawl_searxng_brave_api_key|api[_-]?key|capability|prompt|query|endpoint|url|source|page(Value|Text)?)"[[:space:]]*:[[:space:]]*)"([^"\\]|\\.)*"/\1"[REDACTED]"/Ig' \
    -e 's/(Bearer[[:space:]]+)[^[:space:],;}]*/\1[REDACTED]/Ig' \
    -e 's/(authorization|token|secret|password|searxng_brave_api_key_b64|firecrawl_searxng_brave_api_key|api[_-]?key|capability|prompt|query|endpoint|url|source|page(Value|Text)?)([=:][[:space:]]*)[^,;}]*/\1\3[REDACTED]/Ig' \
    -e 's#https?://[^[:space:]",;}]+#[REDACTED_URL]#Ig' \
    -e 's/SearXNG metasearch/[REDACTED]/g'
}

filter_correlation() {
  local correlation="${1:-}"
  if [[ -z "$correlation" ]]; then
    cat
  else
    awk -v correlation="$correlation" 'index($0, correlation) != 0'
  fi
}

show_logs() {
  local target="$1"
  local correlation="${2:-}"
  local -a services

  case "$target" in
    all) services=("${diagnostic_services[@]}") ;;
    api|browser-service|browser-interaction-worker|browser-interaction-egress-proxy)
      services=("$target")
      ;;
    searxng)
      [[ "$search_provider_mode" == internal ]] || return 64
      services=(searxng)
      ;;
    *) return 64 ;;
  esac
  "${compose[@]}" logs --no-color --tail=200 "${services[@]}" 2>&1 |
    filter_correlation "$correlation" |
    tail -n 200 |
    redact_local_logs
}

run_quiet_health_probe() {
  local label="$1"
  local output
  local status

  shift
  if output="$("$@" 2>&1)"; then
    return 0
  else
    status=$?
  fi

  printf 'Health check failed: %s\n' "$label" >&2
  if [[ -n "$output" ]]; then
    while IFS= read -r line; do
      printf '  %s\n' "$line" >&2
    done <<< "$output"
  fi
  return "$status"
}

print_health_report() {
  local bold_green=
  local cyan=
  local green=
  local reset=

  if [[ -t 1 && -z "${NO_COLOR+x}" && "${TERM:-}" != dumb ]]; then
    bold_green=$'\033[1;32m'
    cyan=$'\033[36m'
    green=$'\033[32m'
    reset=$'\033[0m'
  fi

  printf 'Local Firecrawl health: %sPASS%s\n' "$bold_green" "$reset"
  printf 'Endpoint: http://127.0.0.1:%s\n' "${PORT:-3002}"
  printf 'Search provider mode: %s\n' "$search_provider_mode"
  printf '\n%sDependencies%s\n' "$cyan" "$reset"
  printf '  %-30s %sPASS%s\n' \
    'Redis' "$green" "$reset" \
    'RabbitMQ' "$green" "$reset" \
    'PostgreSQL (application)' "$green" "$reset" \
    'PostgreSQL (NuQ)' "$green" "$reset" \
    'MinIO' "$green" "$reset"
  printf '\n%sApplication%s\n' "$cyan" "$reset"
  printf '  %-30s %sPASS%s (%s)\n' \
    'Migration' "$green" "$reset" "$health_migration"
  printf '  %-30s %sPASS%s\n' \
    'Initialization jobs' "$green" "$reset" \
    'Artifact access policy' "$green" "$reset" \
    'Public API' "$green" "$reset" \
    'Loopback port policy' "$green" "$reset"
  printf '  %-30s %sPASS%s (%s)\n' \
    'Search provider' "$green" "$reset" "$search_provider_mode"
  printf '\n%sBrowser runtime%s\n' "$cyan" "$reset"
  printf '  %-30s %sPASS%s\n' \
    'Playwright' "$green" "$reset" \
    'Browser Service' "$green" "$reset" \
    'Interaction worker' "$green" "$reset" \
    'Egress proxy' "$green" "$reset"
}

verify_search_provider_health() {
  if ! timeout --signal=TERM --kill-after=2s 15s \
    "${compose[@]}" exec -T api node -e \
    "fetch('http://127.0.0.1:' + (process.env.PORT || '3002') + '/v2/search', {
       method: 'POST',
       headers: { 'content-type': 'application/json' },
       body: JSON.stringify({
         query: 'SearXNG metasearch',
         sources: ['web'],
         limit: 1,
       }),
       signal: AbortSignal.timeout(10000),
     }).then(async response => {
       let payload;
       try {
         payload = await response.json();
       } catch {
         process.exit(1);
       }
       const result = payload?.data?.web?.[0];
       let validUrl = false;
       try {
         validUrl = ['http:', 'https:'].includes(new URL(result?.url).protocol);
       } catch {}
       if (response.status !== 200 || payload?.success !== true || !validUrl) {
         process.exit(1);
       }
     }).catch(() => process.exit(1))" >/dev/null 2>&1; then
    printf '%s\n' 'Health check failed: search provider functional smoke' >&2
    return 1
  fi
}

verify_health() {
  local api_container_id
  local latest_applied_checksum
  local latest_applied_migration
  local latest_checked_in_checksum
  local latest_checked_in_migration
  local migration_ledger_entry
  local redis_response

  [[ "$runtime_lock_held" == shared || "$runtime_lock_held" == exclusive ]] ||
    { printf '%s\n' 'Health requires the lifecycle lock' >&2; return 70; }
  validate_compose current
  require_current_api_provenance

  redis_response="$("${compose[@]}" exec -T redis redis-cli ping)"
  if [[ "$redis_response" != PONG ]]; then
    printf 'Redis health check returned %q, expected PONG\n' \
      "$redis_response" >&2
    return 1
  fi
  run_quiet_health_probe 'RabbitMQ' \
    "${compose[@]}" exec -T rabbitmq rabbitmq-diagnostics -q check_running
  run_quiet_health_probe 'NuQ PostgreSQL' \
    "${compose[@]}" exec -T nuq-postgres sh -c \
    'pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"'
  run_quiet_health_probe 'application PostgreSQL' \
    "${compose[@]}" exec -T app-postgres sh -c \
    'pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"'

  latest_checked_in_migration="$(
    find "$repo_root/apps/api/src/db/migrations" -maxdepth 1 -type f \
      -name '[0-9][0-9][0-9][0-9]_*.sql' -printf '%f\n' |
      LC_ALL=C sort | tail -n 1
  )"
  if [[ -z "$latest_checked_in_migration" ]]; then
    printf '%s\n' 'No application migrations were found' >&2
    return 1
  fi
  migration_ledger_entry="$(
    "${compose[@]}" exec -T app-postgres sh -ec \
      'psql -X -qAt -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "SELECT concat_ws('"'"'|'"'"', filename, checksum) FROM application_schema_migrations ORDER BY filename DESC LIMIT 1"'
  )"
  IFS='|' read -r latest_applied_migration latest_applied_checksum \
    <<< "$migration_ledger_entry"
  if [[ "$latest_applied_migration" != "$latest_checked_in_migration" ]]; then
    printf 'Application migration mismatch: expected %s, found %s\n' \
      "$latest_checked_in_migration" \
      "${latest_applied_migration:-none}" >&2
    return 1
  fi
  latest_checked_in_checksum="$(
    sha256sum -- \
      "$repo_root/apps/api/src/db/migrations/$latest_checked_in_migration"
  )"
  latest_checked_in_checksum="${latest_checked_in_checksum%% *}"
  if [[ -z "$latest_applied_checksum" ]] ||
    [[ "$latest_applied_checksum" != "$latest_checked_in_checksum" ]]; then
    printf 'Application migration checksum mismatch: %s\n' \
      "$latest_checked_in_migration" >&2
    return 1
  fi

  require_completed_one_shot browser-state-init
  require_completed_one_shot app-db-migrate
  require_completed_one_shot minio-init
  run_quiet_health_probe 'MinIO liveness' \
    "${compose[@]}" exec -T minio curl --fail --silent --show-error \
    --max-time 10 --output /dev/null \
    http://127.0.0.1:9000/minio/health/live
  run_quiet_health_probe 'artifact access policy' \
    "${compose[@]}" exec -T api sh -ec \
    'test -z "${MINIO_ROOT_USER+x}" && test -z "${MINIO_ROOT_PASSWORD+x}" && node dist/src/cli/artifact-health.js'
  "${compose[@]}" exec -T playwright-service node -e \
    "fetch('http://127.0.0.1:3000/health', {
       signal: AbortSignal.timeout(10000),
     }).then(response => {
       if (!response.ok) process.exit(1);
     }).catch(() => process.exit(1))"
  "${compose[@]}" exec -T browser-service node -e \
    "const headers = {
       authorization: 'Bearer ' + process.env.BROWSER_SERVICE_API_KEY,
       'x-firecrawl-correlation-id': 'local-health',
       'x-firecrawl-deadline': new Date(Date.now() + 10000).toISOString(),
     };
     fetch('http://127.0.0.1:3010/health/live', {
       headers,
       signal: AbortSignal.timeout(4000),
     }).then(response => {
       if (!response.ok) process.exit(1);
     }).catch(() => process.exit(1))"
  "${compose[@]}" exec -T browser-interaction-egress-proxy node -e \
    "const net = require('node:net');
     const socket = net.createConnection({
       path: '/run/firecrawl-model-egress/proxy.sock',
     });
     socket.setTimeout(4000, () => process.exit(1));
     socket.on('error', () => process.exit(1));
     socket.on('connect', () => {
       socket.end();
       process.exit(0);
     });"
  "${compose[@]}" exec -T browser-interaction-worker node -e \
    "const http = require('node:http');
     const request = http.request({
       socketPath: '/run/firecrawl-interaction/worker.sock',
       path: '/health/ready',
       signal: AbortSignal.timeout(4000),
     }, response => {
       response.resume();
       response.on('end', () => process.exit(
         response.statusCode === 200 ? 0 : 1
       ));
     });
     request.on('error', () => process.exit(1));
     request.end();"
  curl --fail --silent --show-error --max-time 10 \
    --output /dev/null "http://127.0.0.1:${PORT:-3002}/"
  verify_search_provider_health
  check_port_policy

  health_migration="$latest_applied_migration"
}

if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  return 0
fi

if (( $# < 1 )); then
  usage
  exit 64
fi

command="$1"
shift

require_no_arguments() {
  if (( $# != 0 )); then
    usage
    exit 64
  fi
}

case "$command" in
  configure-search)
    require_no_arguments "$@"
    configure_args=(--configure-search)
    if [[ -n "${LOCAL_FIRECRAWL_ENV_FILE:-}" ]]; then
      configure_args+=(--env-file "$LOCAL_FIRECRAWL_ENV_FILE")
    fi
    exec "$repo_root/scripts/upgrade-local-env-phase1" "${configure_args[@]}"
    ;;
  lock-path)
    require_no_arguments "$@"
    printf '%s\n' "$runtime_lock_path"
    ;;
  start)
    require_no_arguments "$@"
    validate_runtime_options
    acquire_runtime_lock exclusive
    validate_compose current
    validate_browser_rollback_request
    build_runtime_images
    validate_running_project_provenance
    current_browser_container_id="$("${compose[@]}" ps -q browser-service)"
    quiesce_browser_writers
    check_browser_rollback_offline
    stop_search_provider_for_transition
    "${compose[@]}" stop "${dependency_services[@]}"
    start_runtime
    ;;
  stop)
    require_no_arguments "$@"
    validate_runtime_options
    acquire_runtime_lock exclusive
    validate_compose recovery
    validate_running_project_provenance
    stop_runtime
    ;;
  restart)
    require_no_arguments "$@"
    validate_runtime_options
    acquire_runtime_lock exclusive
    validate_compose current
    validate_browser_rollback_request
    build_runtime_images
    validate_running_project_provenance
    current_browser_container_id="$("${compose[@]}" ps -q browser-service)"
    quiesce_browser_writers
    check_browser_rollback_offline
    stop_search_provider_for_transition
    "${compose[@]}" stop "${dependency_services[@]}"
    start_runtime
    ;;
  probe-egress)
    require_no_arguments "$@"
    validate_runtime_options
    acquire_runtime_lock exclusive
    validate_compose current
    validate_running_project_provenance
    probe_worker_egress
    ;;
  status)
    if (( $# > 1 )) ||
      { (( $# == 1 )) && [[ "$1" != --json ]]; }; then
      usage
      exit 64
    fi
    validate_runtime_options
    acquire_runtime_lock shared
    validate_compose recovery
    validate_running_project_provenance
    if [[ "${1:-}" == --json ]]; then
      "${compose[@]}" ps --all --format json \
        "${long_running_services[@]}" "${one_shot_services[@]}" |
        jq -cs --arg mode "$search_provider_mode" \
          '{searchProviderMode:$mode, services:sort_by(.Service)}'
    else
      printf 'Search provider mode: %s\n\n' "$search_provider_mode"
      printf '%s\n' 'Long-running services:'
      "${compose[@]}" ps --all "${long_running_services[@]}"
      printf '\n%s\n' 'Initialization and migration one-shots:'
      "${compose[@]}" ps --all "${one_shot_services[@]}"
    fi
    ;;
  health)
    if (( $# > 1 )) ||
      { (( $# == 1 )) && [[ "$1" != --json ]]; }; then
      usage
      exit 64
    fi
    validate_runtime_options
    acquire_runtime_lock shared
    verify_health
    if [[ "${1:-}" == --json ]]; then
      jq -cn \
        --arg endpoint "http://127.0.0.1:${PORT:-3002}" \
        --arg migration "$health_migration" \
        --arg search_provider_mode "$search_provider_mode" \
        '{status:"healthy", endpoint:$endpoint,
          migration:$migration, artifacts:"MinIO", browserService:"healthy",
          browserInteractionWorker:"healthy",
          browserInteractionEgressProxy:"healthy",
          searchProviderMode:$search_provider_mode,
          searchProvider:"healthy"}'
    else
      print_health_report
    fi
    ;;
  logs)
    if (( $# > 2 )); then
      usage
      exit 64
    fi
    log_target="${1:-all}"
    correlation="${2:-}"
    if [[ -n "$correlation" &&
      ! "$correlation" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]]; then
      printf '%s\n' 'Correlation ID is invalid' >&2
      exit 64
    fi
    validate_runtime_options
    acquire_runtime_lock shared
    validate_compose recovery
    validate_running_project_provenance
    show_logs "$log_target" "$correlation" || {
      usage
      exit 64
    }
    ;;
  *)
    usage
    exit 64
    ;;
esac
