#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
project_name="${LOCAL_FIRECRAWL_PROJECT_NAME:-firecrawl}"
compose=(
  docker compose
  --project-name "$project_name"
  --project-directory "$repo_root"
  -f "$repo_root/compose.yaml"
  -f "$repo_root/compose.local.yaml"
)
compose_config_sources="$repo_root/compose.yaml,$repo_root/compose.local.yaml"
if [[ -n "${LOCAL_FIRECRAWL_COMPOSE_OVERRIDE:-}" ]]; then
  if [[ "$LOCAL_FIRECRAWL_COMPOSE_OVERRIDE" != /* ]] ||
    [[ ! -f "$LOCAL_FIRECRAWL_COMPOSE_OVERRIDE" ]] ||
    [[ -L "$LOCAL_FIRECRAWL_COMPOSE_OVERRIDE" ]] ||
    [[ "$(readlink -f -- "$LOCAL_FIRECRAWL_COMPOSE_OVERRIDE")" != "$LOCAL_FIRECRAWL_COMPOSE_OVERRIDE" ]]; then
    printf '%s\n' 'LOCAL_FIRECRAWL_COMPOSE_OVERRIDE must be a canonical file' >&2
    exit 64
  fi
  compose+=(-f "$LOCAL_FIRECRAWL_COMPOSE_OVERRIDE")
  compose_config_sources+=",$LOCAL_FIRECRAWL_COMPOSE_OVERRIDE"
fi
if [[ -n "${LOCAL_FIRECRAWL_ENV_FILE:-}" ]]; then
  compose+=(--env-file "$LOCAL_FIRECRAWL_ENV_FILE")
fi
control_runtime_root="${XDG_RUNTIME_DIR:-/run/user/${UID}}"
control_runtime_dir="$control_runtime_root/firecrawl-control"
runtime_lock_path="$control_runtime_dir/lifecycle.lock"
runtime_lock_held=
if [[ "$project_name" != firecrawl ]]; then
  if [[ ! "$project_name" =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]]; then
    printf '%s\n' 'LOCAL_FIRECRAWL_PROJECT_NAME is invalid' >&2
    exit 64
  fi
  runtime_lock_path="$control_runtime_dir/lifecycle.${project_name}.lock"
fi
lock_wait_seconds="${LOCAL_FIRECRAWL_LOCK_WAIT_SECONDS:-30}"
one_shot_timeout_seconds="${LOCAL_FIRECRAWL_ONE_SHOT_TIMEOUT_SECONDS:-300}"
drain_timeout_seconds="${LOCAL_FIRECRAWL_DRAIN_TIMEOUT_SECONDS:-45}"
host_runtime_dir="${LOCAL_FIRECRAWL_HOST_RUNTIME_DIR:-/run/user/${UID}/firecrawl}"
host_manifest_path="${LOCAL_FIRECRAWL_HOST_MANIFEST:-/opt/firecrawl/current/manifest.json}"
host_builder="${LOCAL_FIRECRAWL_HOST_BUILDER:-$repo_root/scripts/build-firecrawl-host}"
host_gate_script="${LOCAL_FIRECRAWL_GATE_SCRIPT:-$repo_root/scripts/codex-browser-gate/run.mjs}"
node22="/home/mamba/.nvm/versions/node/v22.22.1/bin/node"
sealed_identity_dir=
sealed_identity_path=
if [[ "${LOCAL_FIRECRAWL_TESTING:-0}" != 1 ]] &&
  { [[ "$host_runtime_dir" != "/run/user/${UID}/firecrawl" ]] ||
    [[ "$host_manifest_path" != /opt/firecrawl/current/manifest.json ]] ||
    [[ "$host_builder" != "$repo_root/scripts/build-firecrawl-host" ]] ||
    [[ "$host_gate_script" != "$repo_root/scripts/codex-browser-gate/run.mjs" ]]; }; then
  printf '%s\n' 'Local Firecrawl test path overrides are disabled' >&2
  exit 64
fi
dependency_services=(
  playwright-service
  nuq-postgres
  redis
  rabbitmq
  app-postgres
  minio
)
long_running_services=(api browser-service "${dependency_services[@]}")
one_shot_services=(browser-state-init minio-init)
diagnostic_services=("${long_running_services[@]}" "${one_shot_services[@]}")

usage() {
  printf '%s\n' \
    "Usage: ${0##*/} {install-host|start|stop|restart|lock-path}" \
    "       ${0##*/} status [--json]" \
    "       ${0##*/} health [--json] [--live-codex]" \
    "       ${0##*/} logs [all|api|browser-service|adapter|broker] [correlation-id]" \
    "       ${0##*/} diagnose-host-job --correlation-id <uuid> --job-id <uuid> --json" \
    >&2
}

validate_runtime_options() {
  if [[ ! "$lock_wait_seconds" =~ ^[1-9][0-9]*$ ]]; then
    printf '%s\n' \
      'LOCAL_FIRECRAWL_LOCK_WAIT_SECONDS must be a positive integer' >&2
    exit 64
  fi
  if [[ ! "$one_shot_timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
    printf '%s\n' \
      'LOCAL_FIRECRAWL_ONE_SHOT_TIMEOUT_SECONDS must be a positive integer' >&2
    exit 64
  fi
  if [[ ! "$drain_timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
    printf '%s\n' \
      'LOCAL_FIRECRAWL_DRAIN_TIMEOUT_SECONDS must be a positive integer' >&2
    exit 64
  fi
}

acquire_runtime_lock() {
  local mode="$1"
  local -a lock_mode=(--exclusive)
  local fd_identity
  local lock_identity

  if [[ "$mode" == shared ]]; then
    lock_mode=(--shared)
  fi
  if [[ "$control_runtime_root" != /* ]] ||
    [[ ! -d "$control_runtime_root" ]] ||
    [[ -L "$control_runtime_root" ]] ||
    [[ "$(readlink -f -- "$control_runtime_root")" != "$control_runtime_root" ]] ||
    [[ "$(stat -c '%u:%a' -- "$control_runtime_root")" != "$UID:700" ]]; then
    printf '%s\n' 'Lifecycle control runtime root is unsafe' >&2
    return 70
  fi
  if [[ ! -e "$control_runtime_dir" && ! -L "$control_runtime_dir" ]]; then
    install -d -m 0700 -- "$control_runtime_dir"
  fi
  if [[ ! -d "$control_runtime_dir" ]] ||
    [[ -L "$control_runtime_dir" ]] ||
    [[ "$(readlink -f -- "$control_runtime_dir")" != "$control_runtime_dir" ]] ||
    [[ "$(stat -c '%u:%a' -- "$control_runtime_dir")" != "$UID:700" ]]; then
    printf '%s\n' 'Lifecycle control directory is unsafe' >&2
    return 70
  fi
  umask 077
  if [[ ! -e "$runtime_lock_path" && ! -L "$runtime_lock_path" ]]; then
    ( set -o noclobber; : > "$runtime_lock_path" ) 2>/dev/null || true
  fi
  if [[ ! -f "$runtime_lock_path" ]] || [[ -L "$runtime_lock_path" ]]; then
    printf '%s\n' 'Lifecycle lock file is unsafe' >&2
    return 70
  fi
  lock_identity="$(stat -c '%d:%i:%u:%a:%h' -- "$runtime_lock_path")"
  if [[ ! "$lock_identity" =~ ^[0-9]+:[0-9]+:${UID}:600:1$ ]]; then
    printf '%s\n' 'Lifecycle lock ownership or mode is unsafe' >&2
    return 70
  fi
  exec {runtime_lock_fd}<> "$runtime_lock_path"
  fd_identity="$(stat -Lc '%d:%i:%u:%a:%h' -- "/proc/$$/fd/$runtime_lock_fd")"
  if [[ "$fd_identity" != "$lock_identity" ]] ||
    [[ "$(stat -c '%d:%i:%u:%a:%h' -- "$runtime_lock_path")" != "$lock_identity" ]]; then
    printf '%s\n' 'Lifecycle lock changed while opening' >&2
    return 70
  fi
  if ! flock "${lock_mode[@]}" --timeout "$lock_wait_seconds" \
    --conflict-exit-code 75 "$runtime_lock_fd"; then
    printf 'Local Firecrawl maintenance lock is busy: %s\n' \
      "$runtime_lock_path" >&2
    exit 75
  fi
  if [[ "$(stat -c '%d:%i:%u:%a:%h' -- "$runtime_lock_path")" != "$lock_identity" ]]; then
    printf '%s\n' 'Lifecycle lock changed while waiting' >&2
    return 70
  fi
  runtime_lock_held="$mode"
}

cleanup_sealed_identity() {
  if [[ -n "$sealed_identity_dir" ]]; then
    rm -rf -- "$sealed_identity_dir"
  fi
}

trap cleanup_sealed_identity EXIT

capture_host_identity_locked() {
  [[ "$runtime_lock_held" == exclusive ]] ||
    { printf '%s\n' 'Identity capture requires the lifecycle lock' >&2; return 70; }
  [[ -z "$sealed_identity_dir" ]] ||
    { printf '%s\n' 'Host identity was already captured' >&2; return 70; }
  sealed_identity_dir="$(mktemp -d \
    "/tmp/firecrawl-host-identity.${UID}.XXXXXXXX")"
  chmod 0700 -- "$sealed_identity_dir"
  [[ "$(stat -c '%u:%a' -- "$sealed_identity_dir")" == "$UID:700" ]] ||
    { printf '%s\n' 'Host identity directory is unsafe' >&2; return 1; }
  sealed_identity_path="$sealed_identity_dir/codex-identity.json"
  "$host_builder" \
    --capture-active-identity --output "$sealed_identity_path" >/dev/null
  [[ -f "$sealed_identity_path" &&
    ! -L "$sealed_identity_path" &&
    "$(stat -c '%u:%a:%h' -- "$sealed_identity_path")" == "$UID:600:1" ]] ||
    { printf '%s\n' 'Captured host identity is unsafe' >&2; return 1; }
}

build_host_staging_locked() {
  local cache_root
  local staging

  [[ "$runtime_lock_held" == exclusive ]] ||
    { printf '%s\n' 'Host publication requires the lifecycle lock' >&2; return 70; }
  cache_root="$(getent passwd "$UID" | cut -d: -f6)/.cache/firecrawl-host-builds"
  staging="$cache_root/staging-$BASHPID"
  "$host_builder" \
    --staging-only --output "$staging" \
    --expected-identity "$sealed_identity_path" >&2 || return $?
  jq -e --slurpfile identity "$sealed_identity_path" '
    .codexAppServer.sourceIdentity == $identity[0]
  ' "$staging/manifest.json" >/dev/null || return $?
  printf '%s\n' "$staging"
}

publish_host_from_staging_locked() {
  local staging="$1"
  local mode="$2"
  local -a sudo_command=(sudo)

  [[ "$runtime_lock_held" == exclusive ]] ||
    { printf '%s\n' 'Host publication requires the lifecycle lock' >&2; return 70; }
  [[ "$mode" == initial || "$mode" == refresh ]] ||
    { printf '%s\n' 'Host publication mode is invalid' >&2; return 64; }
  [[ "$staging" == /* && "$(readlink -f -- "$staging")" == "$staging" ]] ||
    { printf '%s\n' 'Host staging path is invalid' >&2; return 64; }
  if [[ "$mode" == refresh ]]; then
    sudo_command+=( -n )
  fi
  "${sudo_command[@]}" \
    "$repo_root/host/browser-runtime/install-root.sh" \
    --staging "$staging" \
    --adapter-user "$(id -un)" \
    --adapter-uid "$UID"
  systemctl --user daemon-reload
  systemctl --user enable firecrawl-execution-adapter.service
}

refresh_host_locked() {
  local prechecked_drift="${1:-0}"
  local staging
  if [[ ! -f "$host_manifest_path" ]]; then
    printf '%s\n' \
      'Browser host is not installed; run scripts/local-firecrawl install-host' \
      >&2
    return 1
  fi
  if [[ "$prechecked_drift" != 1 ]] && "$host_builder" \
    --verify-installed-identity --manifest "$host_manifest_path" \
    --expected-identity "$sealed_identity_path" >/dev/null; then
    return
  fi
  staging="$(build_host_staging_locked)"
  publish_host_from_staging_locked "$staging" refresh
  "$host_builder" \
    --verify-installed-identity --manifest "$host_manifest_path" \
    --expected-identity "$sealed_identity_path" >/dev/null
}

prepare_host_runtime_locked() {
  local token

  [[ "$runtime_lock_held" == exclusive ]] ||
    { printf '%s\n' 'Runtime preparation requires the lifecycle lock' >&2; return 70; }
  [[ "$host_runtime_dir" == /* ]] ||
    { printf '%s\n' 'Host runtime directory is invalid' >&2; return 70; }
  if [[ -L "$host_runtime_dir" ]]; then
    printf '%s\n' 'Host runtime directory must not be a symlink' >&2
    return 1
  fi
  install -d -m 0700 -- "$host_runtime_dir"
  rm -f -- "$host_runtime_dir/clean-stop"
  [[ "$(stat -c '%u:%a' -- "$host_runtime_dir")" == "$UID:700" ]] ||
    { printf '%s\n' 'Host runtime directory ownership is invalid' >&2; return 1; }
  if [[ ! -e "$host_runtime_dir/adapter.token" ]]; then
    token="$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n')"
    umask 077
    ( set -o noclobber; printf '%s\n' "$token" > "$host_runtime_dir/adapter.token" )
  fi
  [[ -f "$host_runtime_dir/adapter.token" &&
    ! -L "$host_runtime_dir/adapter.token" ]] ||
    { printf '%s\n' 'Adapter token file is unsafe' >&2; return 1; }
  chmod 0600 -- "$host_runtime_dir/adapter.token"
  [[ "$(stat -c '%u:%a' -- "$host_runtime_dir/adapter.token")" == "$UID:600" ]] ||
    { printf '%s\n' 'Adapter token ownership is invalid' >&2; return 1; }
  token="$(<"$host_runtime_dir/adapter.token")"
  [[ "$token" =~ ^[A-Za-z0-9_-]{43}$ ]] ||
    { printf '%s\n' 'Adapter token is invalid' >&2; return 1; }
}

start_host_services_locked() {
  [[ "$runtime_lock_held" == exclusive ]] ||
    { printf '%s\n' 'Host service start requires the lifecycle lock' >&2; return 70; }
  if ! systemctl is-active --quiet firecrawl-sandbox-broker.socket; then
    printf '%s\n' \
      'Sandbox broker socket is inactive; rerun install-host as an administrator' \
      >&2
    return 1
  fi
  prepare_host_runtime_locked
  systemctl --user daemon-reload
  systemctl --user start firecrawl-execution-adapter.service
  systemctl --user is-active --quiet firecrawl-execution-adapter.service
}

stop_host_services_locked() {
  [[ "$runtime_lock_held" == exclusive ]] ||
    { printf '%s\n' 'Host service stop requires the lifecycle lock' >&2; return 70; }
  if systemctl --user is-active --quiet \
    firecrawl-execution-adapter.service; then
    systemctl --user stop firecrawl-execution-adapter.service
  fi
  if systemctl --user is-active --quiet \
    firecrawl-execution-adapter.service; then
    printf '%s\n' 'Browser execution adapter did not stop' >&2
    return 1
  fi
}

api_image_cli() {
  "${compose[@]}" run --rm --no-deps api \
    node "dist/src/cli/$1.js" "${@:2}"
}

api_running_cli() {
  "${compose[@]}" exec -T api \
    node "dist/src/cli/$1.js" "${@:2}"
}

clean_stop_proven() {
  [[ -f "$host_runtime_dir/clean-stop" &&
    ! -L "$host_runtime_dir/clean-stop" &&
    "$(stat -c '%u:%a' -- "$host_runtime_dir/clean-stop")" == "$UID:600" &&
    "$(<"$host_runtime_dir/clean-stop")" == version=1 ]]
}

verify_adapter_health_json() {
  local health_json="$1"
  jq -e \
    --slurpfile manifest "$host_manifest_path" \
    'keys == [
       "brokerProtocolSha256",
       "codexArtifactSha256",
       "codexCliVersion",
       "codexProtocolSchemaSha256",
       "model",
       "reasoningEffort",
       "status",
       "version"
     ] and
     .version == 1 and .status == "ok" and
     .codexCliVersion == $manifest[0].codexAppServer.sourceIdentity.version and
     .codexArtifactSha256 == $manifest[0].codexAppServer.artifactSha256 and
     .codexProtocolSchemaSha256 ==
       $manifest[0].codexAppServer.protocolSha256 and
     .brokerProtocolSha256 == $manifest[0].brokerContractSha256 and
     .model == "gpt-5.6-terra" and .reasoningEffort == "medium"' \
    <<< "$health_json" >/dev/null
}

verify_runtime_status_json() {
  local status_json="$1"
  jq -e '
    keys == [
      "activeBrowserSessions",
      "activeCapabilities",
      "activeCodeJobs",
      "activePromptJobs",
      "activeProxyGrants",
      "activeWriterLeases",
      "brokerProtocolSha256",
      "codexArtifactSha256",
      "codexCliVersion",
      "codexProtocolSchemaSha256",
      "firecrawlCloudFallbackAttempts",
      "model",
      "orphanProcesses",
      "preparedHostJobs",
      "reasoningEffort",
      "runningHostJobs",
      "startingHostJobs",
      "status",
      "unknownActionOutcomes",
      "unsettledHostJobs",
      "version"
    ] and
    .firecrawlCloudFallbackAttempts == 0 and
    all(
      .activeBrowserSessions,
      .activeCapabilities,
      .activeCodeJobs,
      .activePromptJobs,
      .activeProxyGrants,
      .activeWriterLeases,
      .orphanProcesses,
      .preparedHostJobs,
      .runningHostJobs,
      .startingHostJobs,
      .unsettledHostJobs,
      .unknownActionOutcomes;
      type == "number" and . >= 0 and floor == .
    )
  ' <<< "$status_json" >/dev/null
  verify_adapter_health_json "$(
    jq '{
      version, status, codexCliVersion, codexArtifactSha256,
      codexProtocolSchemaSha256, brokerProtocolSha256, model,
      reasoningEffort
    }' <<< "$status_json"
  )"
}

shallow_host_health() {
  local health_json
  "$host_builder" \
    --verify-installed-identity --manifest "$host_manifest_path" >/dev/null
  systemctl is-active --quiet firecrawl-sandbox-broker.socket
  systemctl is-active --quiet firecrawl-sandbox-broker.service
  systemctl --user is-active --quiet firecrawl-execution-adapter.service
  health_json="$(api_image_cli browser-runtime-status --health-only)"
  verify_adapter_health_json "$health_json"
}

validate_compose() {
  local rendered

  "${compose[@]}" config --quiet
  rendered="$("${compose[@]}" config --format json)"
  jq -e \
    --arg runtime "$host_runtime_dir" \
    '
      .services.api.environment.LOCAL_BROWSER_SERVICE_ENABLED == "true" and
      .services["browser-service"].environment
        .LOCAL_BROWSER_SERVICE_ENABLED == "true" and
      .services["browser-service"].environment.MAX_BROWSER_SESSIONS == "4" and
      (
        .services.api.environment.BROWSER_SERVICE_API_KEY |
        test("^[A-Za-z0-9_-]{43}$")
      ) and
      .services.api.environment.BROWSER_EXECUTION_ADAPTER_SOCKET ==
        "/run/firecrawl-adapter/adapter.sock" and
      .services.api.environment.BROWSER_ADAPTER_TOKEN_FILE ==
        "/run/firecrawl-adapter/adapter.token" and
      (
        [.services.api.volumes[] | select(
          .type == "bind" and .source == $runtime and
          .target == "/run/firecrawl-adapter" and .read_only == true
        )] | length
      ) == 1 and
      (
        [.services | to_entries[] |
          select((.value.ports // []) | length > 0) | .key]
      ) == ["api"]
    ' <<< "$rendered" >/dev/null || {
      printf '%s\n' \
        'Local browser environment is invalid; run scripts/upgrade-local-env-browser-runtime' \
        >&2
      return 1
    }
}

run_one_shot() {
  local service="$1"
  local status

  set +e
  timeout --signal=TERM --kill-after=10s "${one_shot_timeout_seconds}s" \
    "${compose[@]}" up --no-deps --force-recreate \
    --abort-on-container-exit --exit-code-from "$service" "$service"
  status=$?
  set -e
  if (( status != 0 )); then
    "${compose[@]}" stop --timeout 10 "$service" >/dev/null 2>&1 || true
    "${compose[@]}" kill "$service" >/dev/null 2>&1 || true
    printf '%s failed or timed out (status: %s)\n' "$service" "$status" >&2
    return "$status"
  fi
  require_completed_one_shot "$service"
}

start_runtime() {
  local status_json

  "${compose[@]}" build api browser-state-init browser-service
  shallow_host_health
  run_one_shot browser-state-init
  "${compose[@]}" up -d --no-deps --wait browser-service
  "${compose[@]}" up -d --wait "${dependency_services[@]}"
  run_one_shot minio-init
  "${compose[@]}" up -d --no-deps --wait api
  "${compose[@]}" exec -T api node -e \
    "fetch('http://127.0.0.1:' + (process.env.PORT || '3002') + '/', {
       signal: AbortSignal.timeout(10000),
     }).then(response => {
       if (response.status >= 500) process.exit(1);
     }).catch(() => process.exit(1))"
  status_json="$(api_running_cli browser-runtime-status)"
  verify_runtime_status_json "$status_json"
  verify_adapter_health_json "$(
    jq '{
      version, status, codexCliVersion, codexArtifactSha256,
      codexProtocolSchemaSha256, brokerProtocolSha256, model, reasoningEffort
    }' <<< "$status_json"
  )"
  check_port_policy
}

verify_quiescent_runtime_status() {
  local status_json="$1"

  verify_runtime_status_json "$status_json" || return $?
  jq -e '
    all(
      .activeBrowserSessions,
      .activeCapabilities,
      .activeCodeJobs,
      .activePromptJobs,
      .activeProxyGrants,
      .activeWriterLeases,
      .orphanProcesses,
      .preparedHostJobs,
      .runningHostJobs,
      .startingHostJobs,
      .unsettledHostJobs,
      .unknownActionOutcomes;
      . == 0
    )
  ' <<< "$status_json" >/dev/null
}

drain_and_stop_runtime() {
  local api_container
  local clean_shutdown=0
  local shutdown_failure=0
  local status_json

  api_container="$("${compose[@]}" ps -q api)"
  if [[ -n "$api_container" ]]; then
    if timeout --signal=TERM --kill-after=5s "${drain_timeout_seconds}s" \
      "${compose[@]}" exec -T api \
        node dist/src/cli/browser-runtime-drain.js; then
      if status_json="$(api_running_cli browser-runtime-status)" &&
        verify_quiescent_runtime_status "$status_json"; then
        clean_shutdown=1
      else
        printf '%s\n' \
          'Browser runtime remained active after graceful drain' >&2
        shutdown_failure=1
      fi
      "${compose[@]}" stop api
    else
      printf '%s\n' \
        'Graceful browser drain timed out; stopping API before forced drain' \
        >&2
      "${compose[@]}" stop --timeout 10 api
      if timeout --signal=TERM --kill-after=5s "${drain_timeout_seconds}s" \
        "${compose[@]}" run --rm --no-deps api \
        node dist/src/cli/browser-runtime-drain.js --force-after-api-stop; then
        if status_json="$(api_image_cli browser-runtime-status)" &&
          verify_quiescent_runtime_status "$status_json"; then
          clean_shutdown=1
        else
          printf '%s\n' \
            'Browser runtime remained active after forced drain' >&2
          shutdown_failure=1
        fi
      else
        printf '%s\n' \
          'Forced browser drain failed after API stop' >&2
        shutdown_failure=1
      fi
    fi
  elif systemctl --user is-active --quiet \
    firecrawl-execution-adapter.service; then
    if timeout --signal=TERM --kill-after=5s "${drain_timeout_seconds}s" \
      "${compose[@]}" run --rm --no-deps api \
      node dist/src/cli/browser-runtime-drain.js --force-after-api-stop; then
      if status_json="$(api_image_cli browser-runtime-status)" &&
        verify_quiescent_runtime_status "$status_json"; then
        clean_shutdown=1
      else
        printf '%s\n' \
          'Browser runtime remained active after forced drain' >&2
        shutdown_failure=1
      fi
    else
      printf '%s\n' 'Forced browser drain failed while API was stopped' >&2
      shutdown_failure=1
    fi
  elif clean_stop_proven; then
    clean_shutdown=1
  else
    printf '%s\n' \
      'Browser runtime shutdown cannot be proven from the stopped state' >&2
    shutdown_failure=1
  fi
  "${compose[@]}" stop browser-service
  stop_host_services_locked
  "${compose[@]}" stop "${dependency_services[@]}"
  if (( clean_shutdown == 1 && shutdown_failure == 0 )); then
    install -d -m 0700 -- "$host_runtime_dir"
    rm -f -- "$host_runtime_dir/clean-stop"
    ( set -o noclobber
      umask 077
      printf '%s\n' 'version=1' > "$host_runtime_dir/clean-stop"
    )
  fi
  if (( shutdown_failure != 0 )); then
    return 1
  fi
}

disposable_browser_health() {
  local base_url="http://127.0.0.1:${PORT:-3002}"
  local create_response
  local execute_response
  local session_id=

  cleanup_disposable_browser() {
    if [[ -n "$session_id" ]]; then
      curl --fail --silent --show-error --max-time 15 \
        -X DELETE --output /dev/null \
        "$base_url/v2/browser/$session_id" || true
    fi
  }
  trap cleanup_disposable_browser RETURN
  create_response="$(
    curl --fail --silent --show-error --max-time 30 \
      -H 'content-type: application/json' \
      --data '{"ttl":30,"activityTtl":10,"streamWebView":false}' \
      "$base_url/v2/browser"
  )"
  session_id="$(jq -er '
    if keys == ["cdpUrl","expiresAt","id","interactiveLiveViewUrl",
      "liveViewUrl","success"] and .success == true and
      (.id | type == "string")
    then .id else error("invalid disposable browser response") end
  ' <<< "$create_response")"
  for expected in 1 2; do
    execute_response="$(
      curl --fail --silent --show-error --max-time 30 \
        -H 'content-type: application/json' \
        --data \
          "{\"code\":\"return $expected\",\"language\":\"node\",\"timeout\":10}" \
        "$base_url/v2/browser/$session_id/execute"
    )"
    jq -e --arg expected "$expected" '
      .success == true and .exitCode == 0 and .killed == false and
      ((.result | tostring) == $expected)
    ' <<< "$execute_response" >/dev/null
  done
  cleanup_disposable_browser
  session_id=
  trap - RETURN
}

redact_local_logs() {
  sed -E \
    -e 's/("(authorization|bearer|token|secret|password|capability|prompt|source|page(Value|Text)?)"[[:space:]]*:[[:space:]]*)"([^"\\]|\\.)*"/\1"[REDACTED]"/Ig' \
    -e 's/(Bearer[[:space:]]+)[^[:space:],;}]*/\1[REDACTED]/Ig' \
    -e 's/(authorization|token|secret|password|capability|prompt|source|page(Value|Text)?)([=:][[:space:]]*)[^,;}]*/\1\3[REDACTED]/Ig' \
    -e 's#(/home/|/root/)[^ ,;}]*(auth\\.json|config\\.toml)#[REDACTED_PATH]#g'
}

run_live_codex_gate() {
  local attestation
  local gate_dir
  local gate_status

  gate_dir="$(mktemp -d "$control_runtime_dir/live-codex-gate.XXXXXXXX")"
  chmod 0700 -- "$gate_dir"
  attestation="$gate_dir/attestation.json"
  set +e
  "$node22" "$host_gate_script" \
    --runs 3 --attestation-out "$attestation" >/dev/null
  gate_status=$?
  set -e
  if (( gate_status != 0 )); then
    rm -rf -- "$gate_dir"
    return "$gate_status"
  fi
  if [[ ! -f "$attestation" ]] ||
    [[ -L "$attestation" ]] ||
    [[ "$(stat -c '%u:%a:%h' -- "$attestation")" != "$UID:600:1" ]] ||
    ! jq -e --slurpfile manifest "$host_manifest_path" '
      keys == [
        "actions",
        "approvals",
        "codexIdentity",
        "featureSha256",
        "formatVersion",
        "model",
        "reasoningEffort",
        "runCount",
        "schemaSha256",
        "tools",
        "turns",
        "writes"
      ] and
      .formatVersion == 1 and
      .codexIdentity == $manifest[0].codexAppServer.sourceIdentity and
      .runCount == 3 and
      .model == $manifest[0].codexAppServer.model and
      .reasoningEffort == $manifest[0].codexAppServer.reasoningEffort and
      .schemaSha256 == $manifest[0].codexAppServer.protocolSha256 and
      .featureSha256 == $manifest[0].codexAppServer.featureSha256 and
      .turns == 6 and .actions == 3 and .writes == 3 and
      .tools == 0 and .approvals == 0
    ' "$attestation" >/dev/null; then
    rm -rf -- "$gate_dir"
    printf '%s\n' 'Live Codex Gate attestation is invalid' >&2
    return 1
  fi
  if ! "$host_builder" \
    --verify-installed-identity --manifest "$host_manifest_path" >/dev/null; then
    rm -rf -- "$gate_dir"
    printf '%s\n' 'Codex identity changed during live Gate' >&2
    return 78
  fi
  rm -rf -- "$gate_dir"
}

filter_correlation() {
  local correlation="${1:-}"
  if [[ -z "$correlation" ]]; then
    cat
  else
    awk -v correlation="$correlation" 'index($0, correlation) != 0'
  fi
}

show_logs() {
  local target="$1"
  local correlation="${2:-}"

  case "$target" in
    all)
      {
        "${compose[@]}" logs --no-color --tail=200 \
          "${diagnostic_services[@]}"
        journalctl --user --no-pager -n 200 \
          --user-unit=firecrawl-execution-adapter.service
        journalctl --no-pager -n 200 \
          -u firecrawl-sandbox-broker.service \
          -u firecrawl-sandbox-broker.socket
      } 2>&1
      ;;
    api|browser-service)
      "${compose[@]}" logs --no-color --tail=200 "$target" 2>&1
      ;;
    adapter)
      journalctl --user --no-pager -n 200 \
        --user-unit=firecrawl-execution-adapter.service 2>&1
      ;;
    broker)
      journalctl --no-pager -n 200 \
        -u firecrawl-sandbox-broker.service \
        -u firecrawl-sandbox-broker.socket 2>&1
      ;;
    *)
      return 64
      ;;
  esac | filter_correlation "$correlation" | tail -n 200 | redact_local_logs
}

require_completed_one_shot() {
  local service="$1"
  local state

  state="$(
    "${compose[@]}" ps --all --format '{{.State}} {{.ExitCode}}' "$service"
  )"
  if [[ "$state" != "exited 0" ]]; then
    printf '%s did not complete successfully (state: %s)\n' \
      "$service" "${state:-missing}" >&2
    exit 1
  fi
}

check_port_policy() {
  local project_state
  local expected_published_port="${PORT:-3002}"

  project_state="$("${compose[@]}" ps --all --format json)"
  PROJECT_STATE="$project_state" \
    EXPECTED_PUBLISHED_PORT="$expected_published_port" node - <<'NODE'
const input = process.env.PROJECT_STATE ?? "";
const expectedPublishedPort = Number(process.env.EXPECTED_PUBLISHED_PORT);
try {
  const containers = input
    .split("\n")
    .filter(Boolean)
    .map(line => JSON.parse(line));
  const published = containers.flatMap(container =>
    (container.Publishers ?? [])
      .filter(binding => Number(binding.PublishedPort) > 0)
      .map(binding => ({ service: container.Service, ...binding })),
  );
  const valid =
    published.length === 1 &&
    published[0].service === "api" &&
    published[0].URL === "127.0.0.1" &&
    Number(published[0].TargetPort) === 3002 &&
    Number(published[0].PublishedPort) === expectedPublishedPort &&
    published[0].Protocol === "tcp";
  if (!valid) {
    process.stderr.write(
      `Port policy failed: only api may publish 127.0.0.1:${expectedPublishedPort}\n`,
    );
    process.exit(1);
  }
} catch {
  process.stderr.write("Unable to validate Compose port policy\n");
  process.exit(1);
}
NODE
}

validate_browser_rollback_request() {
  if [[ "${LOCAL_FIRECRAWL_BROWSER_DOWNGRADE:-false}" != true ]]; then
    return
  fi
  if [[ -z "${FIRECRAWL_BROWSER_SERVICE_IMAGE:-}" ]] ||
    [[ ! "$FIRECRAWL_BROWSER_SERVICE_IMAGE" =~ @sha256:[a-f0-9]{64}$ ]]; then
    printf '%s\n' \
      'Browser downgrade requires an immutable FIRECRAWL_BROWSER_SERVICE_IMAGE' >&2
    exit 64
  fi
}

quiesce_browser_writers() {
  current_browser_container_id="$("${compose[@]}" ps -q browser-service)"
  "${compose[@]}" stop api browser-service
}

check_browser_rollback_offline() {
  local current_browser_image_id

  if [[ "${LOCAL_FIRECRAWL_BROWSER_DOWNGRADE:-false}" != true ]]; then
    return
  fi
  if [[ -z "$current_browser_container_id" ]]; then
    printf '%s\n' \
      'Browser downgrade requires the current Browser Service to be running' >&2
    exit 1
  fi
  current_browser_image_id="$(
    docker inspect --format '{{.Image}}' "$current_browser_container_id"
  )"
  if [[ ! "$current_browser_image_id" =~ ^sha256:[a-f0-9]{64}$ ]]; then
    printf '%s\n' \
      'Current Browser Service image identity is unavailable' >&2
    exit 1
  fi
  docker run --rm --read-only --network none --user 1000:1000 \
    --cap-drop ALL --security-opt no-new-privileges \
    --volumes-from "$current_browser_container_id:ro" \
    --entrypoint /usr/local/bin/node "$current_browser_image_id" \
    scripts/check-atomic-publication-rollback.mjs \
    /var/lib/firecrawl-browser-volume/state
}

verify_deep_health_locked() {
  local live_codex="${1:-0}"
  local api_compose_source
  local api_container_id
  local health_json
  local latest_applied_checksum
  local latest_applied_migration
  local latest_checked_in_checksum
  local latest_checked_in_migration
  local migration_ledger_entry
  local redis_response

  [[ "$runtime_lock_held" == shared || "$runtime_lock_held" == exclusive ]] ||
    { printf '%s\n' 'Deep health requires the lifecycle lock' >&2; return 70; }
  [[ "$live_codex" == 0 || "$live_codex" == 1 ]] ||
    { printf '%s\n' 'Deep health live Codex option is invalid' >&2; return 64; }
  validate_compose
  shallow_host_health
  health_json="$(api_running_cli browser-runtime-status)"
  verify_runtime_status_json "$health_json"
  jq -e '.orphanProcesses == 0' <<< "$health_json" >/dev/null || {
    printf '%s\n' 'Broker orphan processes are present' >&2
    return 1
  }
  verify_adapter_health_json "$(
    jq '{
      version, status, codexCliVersion, codexArtifactSha256,
      codexProtocolSchemaSha256, brokerProtocolSha256, model,
      reasoningEffort
    }' <<< "$health_json"
  )"

  redis_response="$("${compose[@]}" exec -T redis redis-cli ping)"
  if [[ "$redis_response" != "PONG" ]]; then
    printf 'Redis health check returned %q, expected PONG\n' \
      "$redis_response" >&2
    return 1
  fi

  "${compose[@]}" exec -T rabbitmq \
    rabbitmq-diagnostics -q check_running
  "${compose[@]}" exec -T nuq-postgres sh -c \
    'pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"'
  "${compose[@]}" exec -T app-postgres sh -c \
    'pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"'

  latest_checked_in_migration="$(
    find "$repo_root/apps/api/src/db/migrations" -maxdepth 1 -type f \
      -name '[0-9][0-9][0-9][0-9]_*.sql' -printf '%f\n' |
      LC_ALL=C sort | tail -n 1
  )"
  if [[ -z "$latest_checked_in_migration" ]]; then
    printf '%s\n' 'No application migrations were found' >&2
    return 1
  fi
  migration_ledger_entry="$(
    "${compose[@]}" exec -T app-postgres sh -ec \
      'psql -X -qAt -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "SELECT concat_ws('"'"'|'"'"', filename, checksum) FROM application_schema_migrations ORDER BY filename DESC LIMIT 1"'
  )"
  IFS='|' read -r latest_applied_migration latest_applied_checksum \
    <<< "$migration_ledger_entry"
  if [[ "$latest_applied_migration" != "$latest_checked_in_migration" ]]; then
    printf 'Application migration mismatch: expected %s, found %s\n' \
      "$latest_checked_in_migration" \
      "${latest_applied_migration:-none}" >&2
    return 1
  fi
  latest_checked_in_checksum="$(
    sha256sum -- \
      "$repo_root/apps/api/src/db/migrations/$latest_checked_in_migration"
  )"
  latest_checked_in_checksum="${latest_checked_in_checksum%% *}"
  if [[ -z "$latest_applied_checksum" ]] ||
    [[ "$latest_applied_checksum" != "$latest_checked_in_checksum" ]]; then
    printf 'Application migration checksum mismatch: %s\n' \
      "$latest_checked_in_migration" >&2
    return 1
  fi

  api_container_id="$("${compose[@]}" ps -q api)"
  if [[ -z "$api_container_id" ]]; then
    printf '%s\n' 'API container provenance is unavailable' >&2
    return 1
  fi
  api_compose_source="$(
    docker inspect --format \
      '{{index .Config.Labels "com.docker.compose.project.config_files"}}' \
      "$api_container_id"
  )"
  if [[ "$api_compose_source" != "$compose_config_sources" ]]; then
    printf '%s\n' 'API compose provenance does not match' >&2
    return 1
  fi

  require_completed_one_shot minio-init
  "${compose[@]}" exec -T minio curl --fail --silent --show-error \
    --max-time 10 --output /dev/null \
    http://127.0.0.1:9000/minio/health/live
  "${compose[@]}" exec -T api sh -ec \
    'test -z "${MINIO_ROOT_USER+x}" && test -z "${MINIO_ROOT_PASSWORD+x}" && node dist/src/cli/artifact-health.js'
  "${compose[@]}" exec -T playwright-service node -e \
    "fetch('http://127.0.0.1:3000/health', {
        signal: AbortSignal.timeout(10000),
      })
      .then(response => {
        if (!response.ok) {
          throw new Error('Playwright health check returned ' + response.status);
        }
      })
      .catch(error => {
        console.error(error);
        process.exit(1);
      })"
  curl --fail --silent --show-error --max-time 10 \
    --output /dev/null "http://127.0.0.1:${PORT:-3002}/"
  check_port_policy
  disposable_browser_health
  if (( live_codex == 1 )); then
    run_live_codex_gate
  fi
  deep_health_json="$(jq -c 'del(.unsettledHostJobs)' <<< "$health_json")"
  deep_health_migration="$latest_applied_migration"
}

if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  return 0
fi

if (( $# < 1 )); then
  usage
  exit 64
fi

command="$1"
shift

require_no_arguments() {
  if (( $# != 0 )); then
    usage
    exit 64
  fi
}

case "$command" in
  lock-path)
    require_no_arguments "$@"
    printf '%s\n' "$runtime_lock_path"
    ;;
  install-host)
    require_no_arguments "$@"
    validate_runtime_options
    [[ -t 0 && -t 1 ]] || {
      printf '%s\n' 'install-host requires an interactive terminal' >&2
      exit 64
    }
    acquire_runtime_lock exclusive
    capture_host_identity_locked
    staging="$(build_host_staging_locked)"
    printf 'Staging: %s\n' "$staging"
    jq -r \
      '"Codex: " + .codexAppServer.sourceIdentity.version +
       "\\nModel: " + .codexAppServer.model +
       "\\nEffort: " + .codexAppServer.reasoningEffort' \
      "$staging/manifest.json"
    printf '%s\n' \
      'System units: firecrawl-sandbox-broker.socket, firecrawl-sandbox-broker.service' \
      'User unit: firecrawl-execution-adapter.service'
    publish_host_from_staging_locked "$staging" initial
    "$host_builder" \
      --verify-installed-identity --manifest "$host_manifest_path" \
      --expected-identity "$sealed_identity_path" >/dev/null
    ;;
  start)
    require_no_arguments "$@"
    validate_runtime_options
    acquire_runtime_lock exclusive
    [[ -f "$host_manifest_path" ]] ||
      { printf '%s\n' \
          'Browser host is not installed; run scripts/local-firecrawl install-host' \
          >&2; exit 1; }
    capture_host_identity_locked
    if "$host_builder" --verify-installed-identity \
      --manifest "$host_manifest_path" \
      --expected-identity "$sealed_identity_path" >/dev/null; then
      host_identity_drift=0
    else
      verify_status=$?
      if (( verify_status == 78 )); then
        exit 78
      fi
      host_identity_drift=1
    fi
    validate_compose
    validate_browser_rollback_request
    current_browser_container_id="$("${compose[@]}" ps -q browser-service)"
    drain_and_stop_runtime
    refresh_host_locked "$host_identity_drift"
    check_browser_rollback_offline
    start_host_services_locked
    start_runtime
    ;;
  stop)
    require_no_arguments "$@"
    validate_runtime_options
    acquire_runtime_lock exclusive
    validate_compose
    drain_and_stop_runtime
    ;;
  restart)
    require_no_arguments "$@"
    validate_runtime_options
    acquire_runtime_lock exclusive
    [[ -f "$host_manifest_path" ]] ||
      { printf '%s\n' \
          'Browser host is not installed; run scripts/local-firecrawl install-host' \
          >&2; exit 1; }
    capture_host_identity_locked
    if "$host_builder" --verify-installed-identity \
      --manifest "$host_manifest_path" \
      --expected-identity "$sealed_identity_path" >/dev/null; then
      host_identity_drift=0
    else
      verify_status=$?
      if (( verify_status == 78 )); then
        exit 78
      fi
      host_identity_drift=1
    fi
    validate_compose
    validate_browser_rollback_request
    current_browser_container_id="$("${compose[@]}" ps -q browser-service)"
    drain_and_stop_runtime
    refresh_host_locked "$host_identity_drift"
    check_browser_rollback_offline
    start_host_services_locked
    start_runtime
    ;;
  status)
    if (( $# > 1 )) || (( $# == 1 )) && [[ "$1" != --json ]]; then
      usage
      exit 64
    fi
    validate_runtime_options
    acquire_runtime_lock shared
    validate_compose
    [[ -f "$host_manifest_path" ]] ||
      { printf '%s\n' 'Browser host is not installed' >&2; exit 1; }
    durable='{
      "activePromptJobs": 0,
      "activeCodeJobs": 0,
      "preparedHostJobs": 0,
      "startingHostJobs": 0,
      "runningHostJobs": 0,
      "activeBrowserSessions": 0,
      "activeCapabilities": 0,
      "activeProxyGrants": 0,
      "activeWriterLeases": 0,
      "unknownActionOutcomes": 0,
      "firecrawlCloudFallbackAttempts": 0
    }'
    if [[ -n "$("${compose[@]}" ps -q api)" ]]; then
      durable="$(api_running_cli browser-runtime-status)"
      verify_runtime_status_json "$durable"
    elif systemctl --user is-active --quiet \
      firecrawl-execution-adapter.service; then
      [[ -n "$("${compose[@]}" ps -q app-postgres)" ]] || {
        printf '%s\n' \
          'Runtime status is unavailable while adapter jobs may still exist' \
          >&2
        exit 1
      }
      durable="$(api_image_cli browser-runtime-status)"
      verify_runtime_status_json "$durable"
    elif ! clean_stop_proven; then
      printf '%s\n' \
        'Runtime status is unproven after an unclean stop; run restart' >&2
      exit 1
    fi
    status_json="$(
      jq -cn \
        --slurpfile manifest "$host_manifest_path" \
        --argjson durable "$durable" \
        '{
          codexCliVersion:
            $manifest[0].codexAppServer.sourceIdentity.version,
          codexExecutablePath:
            $manifest[0].codexAppServer.sourceIdentity.executablePath,
          codexResolvedPath:
            $manifest[0].codexAppServer.sourceIdentity.resolvedPath,
          codexDevice: $manifest[0].codexAppServer.sourceIdentity.device,
          codexInode: $manifest[0].codexAppServer.sourceIdentity.inode,
          codexArtifactSha256:
            $manifest[0].codexAppServer.artifactSha256,
          codexProtocolSchemaSha256:
            $manifest[0].codexAppServer.protocolSha256,
          brokerProtocolSha256: $manifest[0].brokerContractSha256,
          activePromptJobs: ($durable.activePromptJobs // 0),
          activeCodeJobs: ($durable.activeCodeJobs // 0),
          preparedHostJobs: ($durable.preparedHostJobs // 0),
          startingHostJobs: ($durable.startingHostJobs // 0),
          runningHostJobs: ($durable.runningHostJobs // 0),
          activeBrowserSessions: ($durable.activeBrowserSessions // 0),
          activeCapabilities: ($durable.activeCapabilities // 0),
          activeProxyGrants: ($durable.activeProxyGrants // 0),
          activeWriterLeases: ($durable.activeWriterLeases // 0),
          unknownActionOutcomes: ($durable.unknownActionOutcomes // 0),
          orphanProcesses: ($durable.orphanProcesses // 0),
          firecrawlCloudFallbackAttempts:
            ($durable.firecrawlCloudFallbackAttempts // 0)
        }'
    )"
    if [[ "${1:-}" == --json ]]; then
      printf '%s\n' "$status_json"
    else
      jq . <<< "$status_json"
    fi
    ;;
  health)
    health_json_output=0
    live_codex=0
    for argument in "$@"; do
      case "$argument" in
        --json)
          (( health_json_output == 0 )) || { usage; exit 64; }
          health_json_output=1
          ;;
        --live-codex)
          (( live_codex == 0 )) || { usage; exit 64; }
          live_codex=1
          ;;
        *)
          usage
          exit 64
          ;;
      esac
    done
    validate_runtime_options
    acquire_runtime_lock shared
    verify_deep_health_locked "$live_codex"
    health_json="$deep_health_json"
    latest_applied_migration="$deep_health_migration"
    if (( health_json_output == 1 )); then
      printf '%s\n' "$health_json"
    else
      printf '%s\n' \
        "Local Firecrawl is healthy at http://127.0.0.1:${PORT:-3002}; migrations: $latest_applied_migration; artifacts: MinIO; browser probe: PASS"
    fi
    ;;
  logs)
    if (( $# > 2 )); then
      usage
      exit 64
    fi
    log_target="${1:-all}"
    correlation="${2:-}"
    if [[ -n "$correlation" &&
      ! "$correlation" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]]; then
      printf '%s\n' 'Correlation ID is invalid' >&2
      exit 64
    fi
    validate_runtime_options
    acquire_runtime_lock shared
    validate_compose
    show_logs "$log_target" "$correlation" || {
      usage
      exit 64
    }
    ;;
  diagnose-host-job)
    if (( $# != 5 )) ||
      [[ "$1" != --correlation-id || "$3" != --job-id || "$5" != --json ]]; then
      usage
      exit 64
    fi
    correlation="$2"
    job_id="$4"
    canonical_uuid='^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
    if [[ ! "$correlation" =~ $canonical_uuid ||
      ! "$job_id" =~ $canonical_uuid ]]; then
      printf '%s\n' 'Correlation ID or job ID is invalid' >&2
      exit 64
    fi
    validate_runtime_options
    acquire_runtime_lock shared
    validate_compose
    api_running_cli browser-runtime-status \
      --diagnose-host-job "$correlation" "$job_id"
    ;;
  *)
    usage
    exit 64
    ;;
esac
