#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
project_name="${LOCAL_FIRECRAWL_PROJECT_NAME:-firecrawl}"
compose=(
  docker compose
  --project-name "$project_name"
  --project-directory "$repo_root"
  -f "$repo_root/compose.yaml"
  -f "$repo_root/compose.local.yaml"
)
if [[ -n "${LOCAL_FIRECRAWL_COMPOSE_OVERRIDE:-}" ]]; then
  compose+=(-f "$LOCAL_FIRECRAWL_COMPOSE_OVERRIDE")
fi
if [[ -n "${LOCAL_FIRECRAWL_ENV_FILE:-}" ]]; then
  compose+=(--env-file "$LOCAL_FIRECRAWL_ENV_FILE")
fi
runtime_lock_path="/tmp/firecrawl-local-firecrawl.${UID}.lock"
if [[ "$project_name" != firecrawl ]]; then
  if [[ ! "$project_name" =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]]; then
    printf '%s\n' 'LOCAL_FIRECRAWL_PROJECT_NAME is invalid' >&2
    exit 64
  fi
  runtime_lock_path="/tmp/firecrawl-local-firecrawl.${UID}.${project_name}.lock"
fi
lock_wait_seconds="${LOCAL_FIRECRAWL_LOCK_WAIT_SECONDS:-30}"
one_shot_timeout_seconds="${LOCAL_FIRECRAWL_ONE_SHOT_TIMEOUT_SECONDS:-300}"
dependency_services=(
  playwright-service
  nuq-postgres
  redis
  rabbitmq
  app-postgres
  minio
)
long_running_services=(api browser-service "${dependency_services[@]}")
one_shot_services=(browser-state-init minio-init)
diagnostic_services=("${long_running_services[@]}" "${one_shot_services[@]}")

usage() {
  printf 'Usage: %s {start|stop|restart|status|health|logs|lock-path}\n' \
    "${0##*/}" >&2
}

validate_runtime_options() {
  if [[ ! "$lock_wait_seconds" =~ ^[1-9][0-9]*$ ]]; then
    printf '%s\n' \
      'LOCAL_FIRECRAWL_LOCK_WAIT_SECONDS must be a positive integer' >&2
    exit 64
  fi
  if [[ ! "$one_shot_timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
    printf '%s\n' \
      'LOCAL_FIRECRAWL_ONE_SHOT_TIMEOUT_SECONDS must be a positive integer' >&2
    exit 64
  fi
}

acquire_runtime_lock() {
  local mode="$1"
  local -a lock_mode=(--exclusive)

  if [[ "$mode" == shared ]]; then
    lock_mode=(--shared)
  fi
  exec {runtime_lock_fd}> "$runtime_lock_path"
  if ! flock "${lock_mode[@]}" --timeout "$lock_wait_seconds" \
    --conflict-exit-code 75 "$runtime_lock_fd"; then
    printf 'Local Firecrawl maintenance lock is busy: %s\n' \
      "$runtime_lock_path" >&2
    exit 75
  fi
}

validate_compose() {
  "${compose[@]}" config --quiet
}

run_one_shot() {
  local service="$1"
  local status

  set +e
  timeout --signal=TERM --kill-after=10s "${one_shot_timeout_seconds}s" \
    "${compose[@]}" up --no-deps --force-recreate \
    --abort-on-container-exit --exit-code-from "$service" "$service"
  status=$?
  set -e
  if (( status != 0 )); then
    "${compose[@]}" stop --timeout 10 "$service" >/dev/null 2>&1 || true
    "${compose[@]}" kill "$service" >/dev/null 2>&1 || true
    printf '%s failed or timed out (status: %s)\n' "$service" "$status" >&2
    return "$status"
  fi
  require_completed_one_shot "$service"
}

start_runtime() {
  run_one_shot browser-state-init
  "${compose[@]}" up -d --no-deps --wait browser-service
  "${compose[@]}" up -d --wait "${dependency_services[@]}"
  run_one_shot minio-init
  "${compose[@]}" up -d --no-deps --wait api
  "${compose[@]}" exec -T api node -e \
    "fetch('http://127.0.0.1:' + (process.env.PORT || '3002') + '/', {
       signal: AbortSignal.timeout(10000),
     }).then(response => {
       if (response.status >= 500) process.exit(1);
     }).catch(() => process.exit(1))"
  check_port_policy
}

require_completed_one_shot() {
  local service="$1"
  local state

  state="$(
    "${compose[@]}" ps --all --format '{{.State}} {{.ExitCode}}' "$service"
  )"
  if [[ "$state" != "exited 0" ]]; then
    printf '%s did not complete successfully (state: %s)\n' \
      "$service" "${state:-missing}" >&2
    exit 1
  fi
}

check_port_policy() {
  local project_state
  local expected_published_port="${PORT:-3002}"

  project_state="$("${compose[@]}" ps --all --format json)"
  PROJECT_STATE="$project_state" \
    EXPECTED_PUBLISHED_PORT="$expected_published_port" node - <<'NODE'
const input = process.env.PROJECT_STATE ?? "";
const expectedPublishedPort = Number(process.env.EXPECTED_PUBLISHED_PORT);
try {
  const containers = input
    .split("\n")
    .filter(Boolean)
    .map(line => JSON.parse(line));
  const published = containers.flatMap(container =>
    (container.Publishers ?? [])
      .filter(binding => Number(binding.PublishedPort) > 0)
      .map(binding => ({ service: container.Service, ...binding })),
  );
  const valid =
    published.length === 1 &&
    published[0].service === "api" &&
    published[0].URL === "127.0.0.1" &&
    Number(published[0].TargetPort) === 3002 &&
    Number(published[0].PublishedPort) === expectedPublishedPort &&
    published[0].Protocol === "tcp";
  if (!valid) {
    process.stderr.write(
      `Port policy failed: only api may publish 127.0.0.1:${expectedPublishedPort}\n`,
    );
    process.exit(1);
  }
} catch {
  process.stderr.write("Unable to validate Compose port policy\n");
  process.exit(1);
}
NODE
}

validate_browser_rollback_request() {
  if [[ "${LOCAL_FIRECRAWL_BROWSER_DOWNGRADE:-false}" != true ]]; then
    return
  fi
  if [[ -z "${FIRECRAWL_BROWSER_SERVICE_IMAGE:-}" ]] ||
    [[ ! "$FIRECRAWL_BROWSER_SERVICE_IMAGE" =~ @sha256:[a-f0-9]{64}$ ]]; then
    printf '%s\n' \
      'Browser downgrade requires an immutable FIRECRAWL_BROWSER_SERVICE_IMAGE' >&2
    exit 64
  fi
}

quiesce_browser_writers() {
  current_browser_container_id="$("${compose[@]}" ps -q browser-service)"
  "${compose[@]}" stop api browser-service
}

check_browser_rollback_offline() {
  local current_browser_image_id

  if [[ "${LOCAL_FIRECRAWL_BROWSER_DOWNGRADE:-false}" != true ]]; then
    return
  fi
  if [[ -z "$current_browser_container_id" ]]; then
    printf '%s\n' \
      'Browser downgrade requires the current Browser Service to be running' >&2
    exit 1
  fi
  current_browser_image_id="$(
    docker inspect --format '{{.Image}}' "$current_browser_container_id"
  )"
  if [[ ! "$current_browser_image_id" =~ ^sha256:[a-f0-9]{64}$ ]]; then
    printf '%s\n' \
      'Current Browser Service image identity is unavailable' >&2
    exit 1
  fi
  docker run --rm --read-only --network none --user 1000:1000 \
    --cap-drop ALL --security-opt no-new-privileges \
    --volumes-from "$current_browser_container_id:ro" \
    --entrypoint /usr/local/bin/node "$current_browser_image_id" \
    scripts/check-atomic-publication-rollback.mjs \
    /var/lib/firecrawl-browser-volume/state
}

if (( $# != 1 )); then
  usage
  exit 64
fi

case "$1" in
  lock-path)
    printf '%s\n' "$runtime_lock_path"
    ;;
  start)
    validate_runtime_options
    acquire_runtime_lock exclusive
    validate_compose
    validate_browser_rollback_request
    # Writers stay stopped through rollback validation and initialization.
    quiesce_browser_writers
    check_browser_rollback_offline
    start_runtime
    ;;
  stop)
    validate_runtime_options
    acquire_runtime_lock exclusive
    validate_compose
    "${compose[@]}" stop api
    "${compose[@]}" stop browser-service
    "${compose[@]}" stop "${dependency_services[@]}"
    ;;
  restart)
    validate_runtime_options
    acquire_runtime_lock exclusive
    validate_compose
    validate_browser_rollback_request
    quiesce_browser_writers
    check_browser_rollback_offline
    "${compose[@]}" stop "${dependency_services[@]}"
    start_runtime
    ;;
  status)
    validate_runtime_options
    acquire_runtime_lock shared
    validate_compose
    printf '%s\n' 'Long-running services:'
    "${compose[@]}" ps --all "${long_running_services[@]}"
    printf '\n%s\n' 'Initialization one-shots:'
    "${compose[@]}" ps --all "${one_shot_services[@]}"
    ;;
  health)
    validate_runtime_options
    acquire_runtime_lock shared
    validate_compose

    redis_response="$("${compose[@]}" exec -T redis redis-cli ping)"
    if [[ "$redis_response" != "PONG" ]]; then
      printf 'Redis health check returned %q, expected PONG\n' \
        "$redis_response" >&2
      exit 1
    fi

    "${compose[@]}" exec -T rabbitmq \
      rabbitmq-diagnostics -q check_running
    "${compose[@]}" exec -T nuq-postgres sh -c \
      'pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"'
    "${compose[@]}" exec -T app-postgres sh -c \
      'pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"'

    latest_checked_in_migration="$(
      find "$repo_root/apps/api/src/db/migrations" -maxdepth 1 -type f \
        -name '[0-9][0-9][0-9][0-9]_*.sql' -printf '%f\n' |
        LC_ALL=C sort | tail -n 1
    )"
    if [[ -z "$latest_checked_in_migration" ]]; then
      printf '%s\n' 'No application migrations were found' >&2
      exit 1
    fi
    migration_ledger_entry="$(
      "${compose[@]}" exec -T app-postgres sh -ec \
        'psql -X -qAt -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "SELECT concat_ws('"'"'|'"'"', filename, checksum) FROM application_schema_migrations ORDER BY filename DESC LIMIT 1"'
    )"
    IFS='|' read -r latest_applied_migration latest_applied_checksum \
      <<< "$migration_ledger_entry"
    if [[ "$latest_applied_migration" != "$latest_checked_in_migration" ]]; then
      printf 'Application migration mismatch: expected %s, found %s\n' \
        "$latest_checked_in_migration" \
        "${latest_applied_migration:-none}" >&2
      exit 1
    fi
    latest_checked_in_checksum="$(
      sha256sum -- \
        "$repo_root/apps/api/src/db/migrations/$latest_checked_in_migration"
    )"
    latest_checked_in_checksum="${latest_checked_in_checksum%% *}"
    if [[ -z "$latest_applied_checksum" ]] ||
      [[ "$latest_applied_checksum" != "$latest_checked_in_checksum" ]]; then
      printf 'Application migration checksum mismatch: %s\n' \
        "$latest_checked_in_migration" >&2
      exit 1
    fi

    api_container_id="$("${compose[@]}" ps -q api)"
    if [[ -z "$api_container_id" ]]; then
      printf '%s\n' 'API container provenance is unavailable' >&2
      exit 1
    fi
    api_compose_source="$(
      docker inspect --format \
        '{{index .Config.Labels "com.docker.compose.project.config_files"}}' \
        "$api_container_id"
    )"
    if [[ "$api_compose_source" != "$repo_root/compose.yaml" ]]; then
      printf '%s\n' 'API compose provenance does not match' >&2
      exit 1
    fi

    require_completed_one_shot minio-init
    "${compose[@]}" exec -T minio curl --fail --silent --show-error \
      --max-time 10 --output /dev/null \
      http://127.0.0.1:9000/minio/health/live
    "${compose[@]}" exec -T api sh -ec \
      'test -z "${MINIO_ROOT_USER+x}" && test -z "${MINIO_ROOT_PASSWORD+x}" && node dist/src/cli/artifact-health.js'
    "${compose[@]}" exec -T playwright-service node -e \
      "fetch('http://127.0.0.1:3000/health', {
          signal: AbortSignal.timeout(10000),
        })
        .then(response => {
          if (!response.ok) {
            throw new Error('Playwright health check returned ' + response.status);
          }
        })
        .catch(error => {
          console.error(error);
          process.exit(1);
        })"
    curl --fail --silent --show-error --max-time 10 \
      --output /dev/null "http://127.0.0.1:${PORT:-3002}/"
    check_port_policy

    printf '%s\n' \
      "Local Firecrawl is healthy at http://127.0.0.1:${PORT:-3002}; migrations: $latest_applied_migration; artifacts: MinIO"
    ;;
  logs)
    validate_runtime_options
    acquire_runtime_lock shared
    validate_compose
    "${compose[@]}" logs --no-color --tail=200 \
      "${diagnostic_services[@]}"
    ;;
  *)
    usage
    exit 64
    ;;
esac
