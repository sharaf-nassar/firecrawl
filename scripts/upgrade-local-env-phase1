#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
env_file="${repo_root}/.env"
check_only=false

usage() {
  printf 'Usage: %s [--check] [--env-file <path>]\n' "${0##*/}" >&2
}

fail_field() {
  printf 'Invalid Phase 1 environment field: %s\n' "$1" >&2
  exit 1
}

while (( $# > 0 )); do
  case "$1" in
    --check)
      if [[ "${check_only}" == true ]]; then
        usage
        exit 64
      fi
      check_only=true
      shift
      ;;
    --env-file)
      if (( $# < 2 )); then
        usage
        exit 64
      fi
      env_file="$2"
      shift 2
      ;;
    *)
      usage
      exit 64
      ;;
  esac
done

if [[ -L "${env_file}" ]]; then
  printf 'Refusing symbolic-link environment file\n' >&2
  exit 1
fi
if [[ ! -f "${env_file}" ]]; then
  printf 'Refusing non-regular environment file\n' >&2
  exit 1
fi
if [[ "$(stat -c '%a' -- "${env_file}")" != 600 ]]; then
  printf 'Refusing environment file without mode 0600\n' >&2
  exit 1
fi

declare -A values=()
declare -A seen=()

while IFS= read -r line || [[ -n "${line}" ]]; do
  if [[ "${line}" =~ ^[[:space:]]*$ ]] ||
    [[ "${line}" =~ ^[[:space:]]*# ]]; then
    continue
  fi

  if [[ "${line}" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
    key="${BASH_REMATCH[1]}"
    value="${BASH_REMATCH[2]}"
  else
    candidate="${line%%=*}"
    if [[ "${candidate}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
      fail_field "${candidate}"
    fi
    fail_field unknown
  fi

  if [[ -v "seen[${key}]" ]]; then
    fail_field "${key}"
  fi
  seen["${key}"]=1
  values["${key}"]="${value}"
done < "${env_file}"

phase_keys=(
  APP_POSTGRES_USER
  APP_POSTGRES_PASSWORD
  APP_POSTGRES_DB
  LOCAL_PERSISTENCE_ENABLED
  APPLICATION_DATABASE_URL
  LOCAL_OWNER_ID
  LOCAL_RECORD_RETENTION_DAYS
  LOCAL_ARTIFACT_RETENTION_DAYS
)

if [[ "${check_only}" == true ]]; then
  for key in "${phase_keys[@]}"; do
    if [[ ! -v "values[${key}]" ]]; then
      fail_field "${key}"
    fi
  done
fi

declare -a missing_keys=()

set_default() {
  local key="$1"
  local value="$2"
  if [[ ! -v "values[${key}]" ]]; then
    values["${key}"]="${value}"
    missing_keys+=("${key}")
  fi
}

set_default APP_POSTGRES_USER firecrawl
if [[ ! -v 'values[APP_POSTGRES_PASSWORD]' ]]; then
  values[APP_POSTGRES_PASSWORD]="$(openssl rand -hex 32)"
  missing_keys+=(APP_POSTGRES_PASSWORD)
fi
set_default APP_POSTGRES_DB firecrawl
set_default LOCAL_PERSISTENCE_ENABLED true

expected_database_url="postgresql://${values[APP_POSTGRES_USER]}:${values[APP_POSTGRES_PASSWORD]}@app-postgres:5432/${values[APP_POSTGRES_DB]}"
set_default APPLICATION_DATABASE_URL "${expected_database_url}"

if [[ ! -v 'values[LOCAL_OWNER_ID]' ]]; then
  values[LOCAL_OWNER_ID]="$(node -e 'process.stdout.write(require("node:crypto").randomUUID())')"
  missing_keys+=(LOCAL_OWNER_ID)
fi
set_default LOCAL_RECORD_RETENTION_DAYS 30
set_default LOCAL_ARTIFACT_RETENTION_DAYS 30

for key in APP_POSTGRES_USER APP_POSTGRES_PASSWORD APP_POSTGRES_DB; do
  if [[ -z "${values[${key}]}" ]]; then
    fail_field "${key}"
  fi
done

if [[ "${values[LOCAL_PERSISTENCE_ENABLED]}" != true ]]; then
  fail_field LOCAL_PERSISTENCE_ENABLED
fi

if [[ "${values[APPLICATION_DATABASE_URL]}" != "${expected_database_url}" ]]; then
  fail_field APPLICATION_DATABASE_URL
fi

if ! APPLICATION_DATABASE_URL="${values[APPLICATION_DATABASE_URL]}" \
  APP_POSTGRES_USER="${values[APP_POSTGRES_USER]}" \
  APP_POSTGRES_PASSWORD="${values[APP_POSTGRES_PASSWORD]}" \
  APP_POSTGRES_DB="${values[APP_POSTGRES_DB]}" \
  node -e '
    try {
      const url = new URL(process.env.APPLICATION_DATABASE_URL);
      const valid =
        url.protocol === "postgresql:" &&
        url.hostname === "app-postgres" &&
        url.port === "5432" &&
        decodeURIComponent(url.username) === process.env.APP_POSTGRES_USER &&
        decodeURIComponent(url.password) === process.env.APP_POSTGRES_PASSWORD &&
        decodeURIComponent(url.pathname.slice(1)) === process.env.APP_POSTGRES_DB;
      process.exit(valid ? 0 : 1);
    } catch {
      process.exit(1);
    }
  '; then
  fail_field APPLICATION_DATABASE_URL
fi

owner_id="${values[LOCAL_OWNER_ID]}"
if [[ ! "${owner_id}" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-8][0-9A-Fa-f]{3}-[89aAbB][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$ ]] &&
  [[ "${owner_id}" != 00000000-0000-0000-0000-000000000000 ]] &&
  [[ "${owner_id}" != ffffffff-ffff-ffff-ffff-ffffffffffff ]]; then
  fail_field LOCAL_OWNER_ID
fi

for key in LOCAL_RECORD_RETENTION_DAYS LOCAL_ARTIFACT_RETENTION_DAYS; do
  if [[ ! "${values[${key}]}" =~ ^[1-9][0-9]*$ ]]; then
    fail_field "${key}"
  fi
done

if [[ "${check_only}" == true ]]; then
  printf 'Phase 1 environment is valid: %s\n' "${env_file}"
  exit 0
fi

if (( ${#missing_keys[@]} == 0 )); then
  printf 'Phase 1 environment is already configured: %s\n' "${env_file}"
  exit 0
fi

umask 077
tmp_file="$(mktemp "${env_file}.phase1.XXXXXX")"
trap 'rm -f -- "${tmp_file}"' EXIT
cp -- "${env_file}" "${tmp_file}"
if [[ -s "${tmp_file}" ]]; then
  printf '\n' >> "${tmp_file}"
fi
for key in "${missing_keys[@]}"; do
  printf '%s=%s\n' "${key}" "${values[${key}]}" >> "${tmp_file}"
done
chmod 0600 "${tmp_file}"
mv -- "${tmp_file}" "${env_file}"
trap - EXIT

printf 'Added Phase 1 environment fields: %s\n' "${env_file}"
