#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
env_file="${repo_root}/.env"
check_only=false
snapshot_file=""
output_file=""
endpoint_normalizer="${repo_root}/scripts/normalize-searxng-endpoint.mjs"

usage() {
  printf 'Usage: %s [--check] [--env-file <path>]\n' "${0##*/}" >&2
}

fail_field() {
  printf 'Invalid Phase 1 environment field: %s\n' "$1" >&2
  exit 1
}

cleanup() {
  if [[ -n "${snapshot_file}" ]]; then
    rm -f -- "${snapshot_file}"
  fi
  if [[ -n "${output_file}" ]]; then
    rm -f -- "${output_file}"
  fi
}

validate_environment_file() {
  if [[ -L "${env_file}" ]]; then
    printf 'Refusing symbolic-link environment file\n' >&2
    exit 1
  fi
  if [[ ! -f "${env_file}" ]]; then
    printf 'Refusing non-regular environment file\n' >&2
    exit 1
  fi
  if [[ "$(stat -c '%a' -- "${env_file}")" != 600 ]]; then
    printf 'Refusing environment file without mode 0600\n' >&2
    exit 1
  fi
}

parse_environment() {
  local source_file="$1"
  local destination_name="$2"
  local -n destination="${destination_name}"
  local -A seen=()
  local line key value candidate

  destination=()
  while IFS= read -r line || [[ -n "${line}" ]]; do
    if [[ "${line}" =~ ^[[:space:]]*$ ]] ||
      [[ "${line}" =~ ^[[:space:]]*# ]]; then
      continue
    fi

    if [[ "${line}" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
      key="${BASH_REMATCH[1]}"
      value="${BASH_REMATCH[2]}"
    else
      candidate="${line%%=*}"
      if [[ "${candidate}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
        fail_field "${candidate}"
      fi
      fail_field unknown
    fi

    if [[ -v "seen[${key}]" ]]; then
      fail_field "${key}"
    fi
    seen["${key}"]=1
    destination["${key}"]="${value}"
  done < "${source_file}"
}

copy_environment() {
  local source_name="$1"
  local destination_name="$2"
  local -n source="${source_name}"
  local -n destination="${destination_name}"
  local key

  destination=()
  for key in "${!source[@]}"; do
    destination["${key}"]="${source[${key}]}"
  done
}

normalize_searxng_endpoint() {
  local normalized

  if ! normalized="$(
    printf '%s' "$1" | node "${endpoint_normalizer}" 2>/dev/null
  )"; then
    return 1
  fi
  printf '%s' "${normalized}"
}

searxng_secret_is_unique() {
  local values_name="$1"
  local -n secret_values="${values_name}"
  local key

  for key in "${local_secret_keys[@]}"; do
    if [[ -v "secret_values[${key}]" ]] &&
      [[ "${secret_values[SEARXNG_SECRET]}" == "${secret_values[${key}]}" ]]; then
      return 1
    fi
  done
  return 0
}

require_phase_keys() {
  local values_name="$1"
  local -n required_values="${values_name}"
  local key

  for key in "${phase_keys[@]}"; do
    if [[ ! -v "required_values[${key}]" ]]; then
      fail_field "${key}"
    fi
  done
}

validate_phase_values() {
  local values_name="$1"
  local -n managed_values="${values_name}"
  local expected_database_url key normalized_searxng_endpoint

  require_phase_keys "${values_name}"

  for key in APP_POSTGRES_USER APP_POSTGRES_DB; do
    if [[ ! "${managed_values[${key}]}" =~ ^[a-z_][a-z0-9_]{0,62}$ ]]; then
      fail_field "${key}"
    fi
  done

  if [[ ! "${managed_values[APP_POSTGRES_PASSWORD]}" =~ ^[0-9a-f]{64}$ ]]; then
    fail_field APP_POSTGRES_PASSWORD
  fi

  if [[ "${managed_values[LOCAL_PERSISTENCE_ENABLED]}" != true ]]; then
    fail_field LOCAL_PERSISTENCE_ENABLED
  fi
  if [[ "${managed_values[LOCAL_BROWSER_STATE_ROOT]}" != /var/lib/firecrawl-browser-volume/state ]]; then
    fail_field LOCAL_BROWSER_STATE_ROOT
  fi
  if [[ "${managed_values[LOCAL_BROWSER_SERVICE_ENABLED]}" != true ]]; then
    fail_field LOCAL_BROWSER_SERVICE_ENABLED
  fi
  if [[ ! "${managed_values[BROWSER_SERVICE_API_KEY]}" =~ ^[A-Za-z0-9_-]{43}$ ]]; then
    fail_field BROWSER_SERVICE_API_KEY
  fi
  if [[ ! "${managed_values[BROWSER_REPLAY_INGEST_API_KEY]}" =~ ^[0-9a-f]{64}$ ]]; then
    fail_field BROWSER_REPLAY_INGEST_API_KEY
  fi
  if [[ "${managed_values[BROWSER_REPLAY_INGEST_API_KEY]}" == "${managed_values[BROWSER_SERVICE_API_KEY]}" ]]; then
    fail_field BROWSER_REPLAY_INGEST_API_KEY
  fi
  if [[ ! "${managed_values[BROWSER_INTERACTION_WORKER_TOKEN]}" =~ ^[A-Za-z0-9_-]{43}$ ]]; then
    fail_field BROWSER_INTERACTION_WORKER_TOKEN
  fi
  if [[ "${managed_values[BROWSER_INTERACTION_WORKER_TOKEN]}" == "${managed_values[BROWSER_SERVICE_API_KEY]}" ]] ||
    [[ "${managed_values[BROWSER_INTERACTION_WORKER_TOKEN]}" == "${managed_values[BROWSER_REPLAY_INGEST_API_KEY]}" ]]; then
    fail_field BROWSER_INTERACTION_WORKER_TOKEN
  fi

  expected_database_url="postgresql://${managed_values[APP_POSTGRES_USER]}:${managed_values[APP_POSTGRES_PASSWORD]}@app-postgres:5432/${managed_values[APP_POSTGRES_DB]}"
  if [[ "${managed_values[APPLICATION_DATABASE_URL]}" != "${expected_database_url}" ]]; then
    fail_field APPLICATION_DATABASE_URL
  fi

  if [[ ! "${managed_values[LOCAL_OWNER_ID]}" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]]; then
    fail_field LOCAL_OWNER_ID
  fi

  for key in LOCAL_RECORD_RETENTION_DAYS LOCAL_ARTIFACT_RETENTION_DAYS; do
    if [[ ! "${managed_values[${key}]}" =~ ^[1-9][0-9]*$ ]]; then
      fail_field "${key}"
    fi
  done

  if [[ "${managed_values[MINIO_ROOT_USER]}" != firecrawl-root ]]; then
    fail_field MINIO_ROOT_USER
  fi
  if [[ ! "${managed_values[MINIO_ROOT_PASSWORD]}" =~ ^[0-9a-f]{64}$ ]]; then
    fail_field MINIO_ROOT_PASSWORD
  fi
  if [[ "${managed_values[ARTIFACT_STORE_PROVIDER]}" != minio ]]; then
    fail_field ARTIFACT_STORE_PROVIDER
  fi
  if [[ "${managed_values[ARTIFACT_MINIO_ENDPOINT]}" != http://minio:9000 ]]; then
    fail_field ARTIFACT_MINIO_ENDPOINT
  fi
  if [[ "${managed_values[ARTIFACT_MINIO_ACCESS_KEY]}" != firecrawl-app ]]; then
    fail_field ARTIFACT_MINIO_ACCESS_KEY
  fi
  if [[ ! "${managed_values[ARTIFACT_MINIO_SECRET_KEY]}" =~ ^[0-9a-f]{64}$ ]]; then
    fail_field ARTIFACT_MINIO_SECRET_KEY
  fi
  if [[ "${managed_values[MINIO_ROOT_PASSWORD]}" == "${managed_values[ARTIFACT_MINIO_SECRET_KEY]}" ]]; then
    fail_field ARTIFACT_MINIO_SECRET_KEY
  fi
  if [[ "${managed_values[ARTIFACT_MINIO_BUCKET]}" != firecrawl-artifacts ]]; then
    fail_field ARTIFACT_MINIO_BUCKET
  fi
  if [[ "${managed_values[ARTIFACT_MINIO_REGION]}" != us-east-1 ]]; then
    fail_field ARTIFACT_MINIO_REGION
  fi

  if ! normalized_searxng_endpoint="$(
    normalize_searxng_endpoint "${managed_values[SEARXNG_ENDPOINT]}"
  )" ||
    [[ "${managed_values[SEARXNG_ENDPOINT]}" != "${normalized_searxng_endpoint}" ]]; then
    fail_field SEARXNG_ENDPOINT
  fi
  if [[ ! "${managed_values[SEARXNG_SECRET]}" =~ ^[0-9a-f]{64}$ ]] ||
    ! searxng_secret_is_unique "${values_name}"; then
    fail_field SEARXNG_SECRET
  fi
}

while (( $# > 0 )); do
  case "$1" in
    --check)
      if [[ "${check_only}" == true ]]; then
        usage
        exit 64
      fi
      check_only=true
      shift
      ;;
    --env-file)
      if (( $# < 2 )); then
        usage
        exit 64
      fi
      env_file="$2"
      shift 2
      ;;
    *)
      usage
      exit 64
      ;;
  esac
done

phase_keys=(
  APP_POSTGRES_USER
  APP_POSTGRES_PASSWORD
  APP_POSTGRES_DB
  LOCAL_PERSISTENCE_ENABLED
  LOCAL_BROWSER_SERVICE_ENABLED
  LOCAL_BROWSER_STATE_ROOT
  BROWSER_SERVICE_API_KEY
  BROWSER_REPLAY_INGEST_API_KEY
  BROWSER_INTERACTION_WORKER_TOKEN
  APPLICATION_DATABASE_URL
  LOCAL_OWNER_ID
  LOCAL_RECORD_RETENTION_DAYS
  LOCAL_ARTIFACT_RETENTION_DAYS
  MINIO_ROOT_USER
  MINIO_ROOT_PASSWORD
  ARTIFACT_STORE_PROVIDER
  ARTIFACT_MINIO_ENDPOINT
  ARTIFACT_MINIO_ACCESS_KEY
  ARTIFACT_MINIO_SECRET_KEY
  ARTIFACT_MINIO_BUCKET
  ARTIFACT_MINIO_REGION
  SEARXNG_ENDPOINT
  SEARXNG_SECRET
)

local_secret_keys=(
  POSTGRES_PASSWORD
  APP_POSTGRES_PASSWORD
  BULL_AUTH_KEY
  BROWSER_SERVICE_API_KEY
  BROWSER_REPLAY_INGEST_API_KEY
  BROWSER_INTERACTION_WORKER_TOKEN
  MINIO_ROOT_PASSWORD
  ARTIFACT_MINIO_SECRET_KEY
)

if [[ "${check_only}" == true ]]; then
  validate_environment_file
  declare -A check_values=()
  parse_environment "${env_file}" check_values
  validate_phase_values check_values
  printf 'Phase 1 environment is valid: %s\n' "${env_file}"
  exit 0
fi

if ! command -v flock >/dev/null 2>&1; then
  printf 'Required advisory locking facility is unavailable\n' >&2
  exit 1
fi

validate_environment_file

umask 077
lock_file="${env_file}.phase1.lock"
if [[ ! -e "${lock_file}" && ! -L "${lock_file}" ]]; then
  (set -o noclobber; : > "${lock_file}") 2>/dev/null || true
fi
if [[ -L "${lock_file}" || ! -f "${lock_file}" ]]; then
  printf 'Refusing unsafe Phase 1 environment lock\n' >&2
  exit 1
fi
if [[ "$(stat -c '%a' -- "${lock_file}")" != 600 ]]; then
  printf 'Refusing Phase 1 environment lock without mode 0600\n' >&2
  exit 1
fi

exec {lock_fd}<> "${lock_file}"
flock -x "${lock_fd}"
validate_environment_file

trap cleanup EXIT HUP INT TERM
snapshot_file="$(mktemp "${env_file}.firecrawl-secret-tmp.snapshot.XXXXXX")"
cp -- "${env_file}" "${snapshot_file}"
chmod 0600 "${snapshot_file}"

declare -A original_values=()
declare -A candidate_values=()
parse_environment "${snapshot_file}" original_values
copy_environment original_values candidate_values

declare -a changed_keys=()
declare -A changed_key_set=()

mark_changed() {
  local key="$1"
  if [[ ! -v "changed_key_set[${key}]" ]]; then
    changed_key_set["${key}"]=1
    changed_keys+=("${key}")
  fi
}

set_default() {
  local key="$1"
  local value="$2"
  if [[ ! -v "candidate_values[${key}]" ]]; then
    candidate_values["${key}"]="${value}"
    mark_changed "${key}"
  fi
}

generate_base64url_secret() {
  openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
}

generate_searxng_secret() {
  candidate_values[SEARXNG_SECRET]="$(openssl rand -hex 32)"
  while ! searxng_secret_is_unique candidate_values; do
    candidate_values[SEARXNG_SECRET]="$(openssl rand -hex 32)"
  done
}

set_default APP_POSTGRES_USER firecrawl
if [[ ! -v 'candidate_values[APP_POSTGRES_PASSWORD]' ]]; then
  candidate_values[APP_POSTGRES_PASSWORD]="$(openssl rand -hex 32)"
  mark_changed APP_POSTGRES_PASSWORD
fi
set_default APP_POSTGRES_DB firecrawl
set_default LOCAL_PERSISTENCE_ENABLED true
if [[ ! -v 'candidate_values[LOCAL_BROWSER_SERVICE_ENABLED]' ]] ||
  [[ "${candidate_values[LOCAL_BROWSER_SERVICE_ENABLED]}" == false ]]; then
  candidate_values[LOCAL_BROWSER_SERVICE_ENABLED]=true
  mark_changed LOCAL_BROWSER_SERVICE_ENABLED
elif [[ "${candidate_values[LOCAL_BROWSER_SERVICE_ENABLED]}" != true ]]; then
  fail_field LOCAL_BROWSER_SERVICE_ENABLED
fi
set_default LOCAL_BROWSER_STATE_ROOT /var/lib/firecrawl-browser-volume/state
if [[ ! -v 'candidate_values[BROWSER_SERVICE_API_KEY]' ]] ||
  [[ "${candidate_values[BROWSER_SERVICE_API_KEY]}" =~ ^[0-9a-f]{64}$ ]]; then
  candidate_values[BROWSER_SERVICE_API_KEY]="$(generate_base64url_secret)"
  while { [[ -v 'candidate_values[BROWSER_REPLAY_INGEST_API_KEY]' ]] &&
      [[ "${candidate_values[BROWSER_SERVICE_API_KEY]}" == "${candidate_values[BROWSER_REPLAY_INGEST_API_KEY]}" ]]; } ||
    { [[ -v 'candidate_values[BROWSER_INTERACTION_WORKER_TOKEN]' ]] &&
      [[ "${candidate_values[BROWSER_SERVICE_API_KEY]}" == "${candidate_values[BROWSER_INTERACTION_WORKER_TOKEN]}" ]]; }; do
    candidate_values[BROWSER_SERVICE_API_KEY]="$(generate_base64url_secret)"
  done
  mark_changed BROWSER_SERVICE_API_KEY
elif [[ ! "${candidate_values[BROWSER_SERVICE_API_KEY]}" =~ ^[A-Za-z0-9_-]{43}$ ]]; then
  fail_field BROWSER_SERVICE_API_KEY
fi
if [[ ! -v 'candidate_values[BROWSER_REPLAY_INGEST_API_KEY]' ]]; then
  candidate_values[BROWSER_REPLAY_INGEST_API_KEY]="$(openssl rand -hex 32)"
  while [[ "${candidate_values[BROWSER_REPLAY_INGEST_API_KEY]}" == "${candidate_values[BROWSER_SERVICE_API_KEY]}" ]]; do
    candidate_values[BROWSER_REPLAY_INGEST_API_KEY]="$(openssl rand -hex 32)"
  done
  mark_changed BROWSER_REPLAY_INGEST_API_KEY
fi
if [[ ! -v 'candidate_values[BROWSER_INTERACTION_WORKER_TOKEN]' ]]; then
  candidate_values[BROWSER_INTERACTION_WORKER_TOKEN]="$(generate_base64url_secret)"
  while [[ "${candidate_values[BROWSER_INTERACTION_WORKER_TOKEN]}" == "${candidate_values[BROWSER_SERVICE_API_KEY]}" ]] ||
    [[ "${candidate_values[BROWSER_INTERACTION_WORKER_TOKEN]}" == "${candidate_values[BROWSER_REPLAY_INGEST_API_KEY]}" ]]; do
    candidate_values[BROWSER_INTERACTION_WORKER_TOKEN]="$(generate_base64url_secret)"
  done
  mark_changed BROWSER_INTERACTION_WORKER_TOKEN
fi
set_default APPLICATION_DATABASE_URL \
  "postgresql://${candidate_values[APP_POSTGRES_USER]}:${candidate_values[APP_POSTGRES_PASSWORD]}@app-postgres:5432/${candidate_values[APP_POSTGRES_DB]}"
if [[ ! -v 'candidate_values[LOCAL_OWNER_ID]' ]]; then
  candidate_values[LOCAL_OWNER_ID]="$(node -e 'process.stdout.write(require("node:crypto").randomUUID())')"
  mark_changed LOCAL_OWNER_ID
fi
set_default LOCAL_RECORD_RETENTION_DAYS 30
set_default LOCAL_ARTIFACT_RETENTION_DAYS 30
set_default MINIO_ROOT_USER firecrawl-root
if [[ ! -v 'candidate_values[MINIO_ROOT_PASSWORD]' ]]; then
  candidate_values[MINIO_ROOT_PASSWORD]="$(openssl rand -hex 32)"
  mark_changed MINIO_ROOT_PASSWORD
fi
set_default ARTIFACT_STORE_PROVIDER minio
set_default ARTIFACT_MINIO_ENDPOINT http://minio:9000
set_default ARTIFACT_MINIO_ACCESS_KEY firecrawl-app
if [[ ! -v 'candidate_values[ARTIFACT_MINIO_SECRET_KEY]' ]]; then
  candidate_values[ARTIFACT_MINIO_SECRET_KEY]="$(openssl rand -hex 32)"
  while [[ "${candidate_values[ARTIFACT_MINIO_SECRET_KEY]}" == "${candidate_values[MINIO_ROOT_PASSWORD]}" ]]; do
    candidate_values[ARTIFACT_MINIO_SECRET_KEY]="$(openssl rand -hex 32)"
  done
  mark_changed ARTIFACT_MINIO_SECRET_KEY
fi
set_default ARTIFACT_MINIO_BUCKET firecrawl-artifacts
set_default ARTIFACT_MINIO_REGION us-east-1
if [[ ! -v 'candidate_values[SEARXNG_ENDPOINT]' ]] ||
  [[ -z "${candidate_values[SEARXNG_ENDPOINT]}" ]]; then
  candidate_values[SEARXNG_ENDPOINT]=http://searxng:8080
  mark_changed SEARXNG_ENDPOINT
else
  if ! normalized_searxng_endpoint="$(
    normalize_searxng_endpoint "${candidate_values[SEARXNG_ENDPOINT]}"
  )"; then
    fail_field SEARXNG_ENDPOINT
  fi
  if [[ "${candidate_values[SEARXNG_ENDPOINT]}" != "${normalized_searxng_endpoint}" ]]; then
    candidate_values[SEARXNG_ENDPOINT]="${normalized_searxng_endpoint}"
    mark_changed SEARXNG_ENDPOINT
  fi
fi
if [[ ! -v 'candidate_values[SEARXNG_SECRET]' ]] ||
  [[ -z "${candidate_values[SEARXNG_SECRET]}" ]]; then
  generate_searxng_secret
  mark_changed SEARXNG_SECRET
elif [[ ! "${candidate_values[SEARXNG_SECRET]}" =~ ^[0-9a-f]{64}$ ]] ||
  ! searxng_secret_is_unique candidate_values; then
  fail_field SEARXNG_SECRET
fi

validate_phase_values candidate_values

if (( ${#changed_keys[@]} == 0 )); then
  printf 'Phase 1 environment is already configured: %s\n' "${env_file}"
  exit 0
fi

output_file="$(mktemp "${env_file}.firecrawl-secret-tmp.output.XXXXXX")"
: > "${output_file}"
while IFS= read -r line || [[ -n "${line}" ]]; do
  if [[ "${line}" =~ ^([A-Za-z_][A-Za-z0-9_]*)= ]] &&
    [[ -v "changed_key_set[${BASH_REMATCH[1]}]" ]]; then
    key="${BASH_REMATCH[1]}"
    printf '%s=%s\n' "${key}" "${candidate_values[${key}]}" >> "${output_file}"
  else
    printf '%s\n' "${line}" >> "${output_file}"
  fi
done < "${snapshot_file}"
for key in "${changed_keys[@]}"; do
  if [[ ! -v "original_values[${key}]" ]]; then
    printf '%s=%s\n' "${key}" "${candidate_values[${key}]}" >> "${output_file}"
  fi
done
chmod 0600 "${output_file}"

validate_environment_file
declare -A current_values=()
declare -A revalidated_values=()
parse_environment "${env_file}" current_values
if ! cmp -s "${snapshot_file}" "${env_file}"; then
  printf 'Environment file changed during Phase 1 upgrade\n' >&2
  exit 1
fi
copy_environment current_values revalidated_values
for key in "${changed_keys[@]}"; do
  revalidated_values["${key}"]="${candidate_values[${key}]}"
done
validate_phase_values revalidated_values

mv -- "${output_file}" "${env_file}"
output_file=""
rm -f -- "${snapshot_file}"
snapshot_file=""
trap - EXIT HUP INT TERM

printf 'Updated Phase 1 environment fields: %s\n' "${env_file}"
