#!/usr/bin/env node

import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import {
  chmodSync,
  lstatSync,
  mkdtempSync,
  readFileSync,
  rmSync,
  writeFileSync,
} from "node:fs";
import { tmpdir } from "node:os";
import { dirname, join, resolve } from "node:path";
import process from "node:process";
import { fileURLToPath } from "node:url";

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const CODE_ROOT = join(ROOT, "host/browser-runtime/bundles/code");
const DOCKER = "/usr/bin/docker";
const BROWSER_IMAGE =
  "mcr.microsoft.com/playwright:v1.61.1-noble@" +
  "sha256:5b8f294aff9041b7191c34a4bab3ac270157a28774d4b0660e9743297b697e48";
const CHROME =
  "/ms-playwright/chromium-1228/chrome-linux64/chrome";
const EXPECTED_TITLE = "code-relay-v1-fixture";
const MAX_OUTPUT = 8 * 1024 * 1024;

const GATEWAY_SOURCE = String.raw`
import { spawn } from "node:child_process";
import { chmod, chown, mkdir, rm } from "node:fs/promises";
import { createServer } from "node:net";

const path = process.env.RELAY_PATH || "/run/firecrawl-job/relay.sock";
await rm(path, { force: true });
if (process.env.CREATE_ARTIFACT_ROOT === "1") {
  await mkdir("/run/firecrawl-job/artifacts", { recursive: true });
  await chown("/run/firecrawl-job/artifacts", 65532, 65532);
  await chmod("/run/firecrawl-job/artifacts", 0o700);
}

const chrome = spawn(
  ${JSON.stringify(CHROME)},
  [
    "--headless=new",
    "--no-sandbox",
    "--disable-dev-shm-usage",
    "--disable-gpu",
    "--no-first-run",
    "--no-default-browser-check",
    "--remote-debugging-pipe",
    "--user-data-dir=/tmp/firecrawl-relay-profile",
    "data:text/html,<title>${EXPECTED_TITLE}</title>",
  ],
  { stdio: ["ignore", "ignore", "inherit", "pipe", "pipe"] },
);

let peer;
let browserBuffer = Buffer.alloc(0);
const shutdown = () => {
  peer?.destroy();
  chrome.kill("SIGKILL");
  server.close();
};

chrome.once("error", error => {
  process.stderr.write("gateway_chrome_spawn_failed:" + error.message + "\n");
  process.exit(1);
});
chrome.once("exit", (code, signal) => {
  if (code !== null || signal !== "SIGKILL") {
    process.stderr.write("gateway_chrome_exited\n");
    process.exitCode = 1;
  }
  peer?.destroy();
  server.close();
});
chrome.stdio[4].on("data", chunk => {
  browserBuffer = Buffer.concat([browserBuffer, chunk]);
  for (;;) {
    const end = browserBuffer.indexOf(0);
    if (end < 0) break;
    const message = browserBuffer.subarray(0, end);
    browserBuffer = browserBuffer.subarray(end + 1);
    if (message.byteLength > 0) peer?.write(Buffer.concat([message, Buffer.from("\n")]));
  }
});

const server = createServer(socket => {
  if (peer) {
    socket.destroy();
    return;
  }
  peer = socket;
  let input = Buffer.alloc(0);
  socket.on("data", chunk => {
    input = Buffer.concat([input, chunk]);
    for (;;) {
      const end = input.indexOf(0x0a);
      if (end < 0) break;
      const message = input.subarray(0, end);
      input = input.subarray(end + 1);
      if (message.byteLength > 0) {
        chrome.stdio[3].write(Buffer.concat([message, Buffer.from([0])]));
      }
    }
  });
  socket.once("close", shutdown);
  socket.once("error", shutdown);
});
server.listen(path, async () => {
  await chown(path, 65532, 65532);
  await chmod(path, 0o600);
});

for (const signal of ["SIGINT", "SIGTERM"]) process.once(signal, shutdown);
`;

const NODE_CLIENT_SOURCE = String.raw`
import assert from "node:assert/strict";
import { createRequire } from "node:module";
import { readFile } from "node:fs/promises";
import { startCdpRelay } from "/opt/firecrawl/bin/cdp-relay.mjs";

const require = createRequire(import.meta.url);
const { chromium } = require("/opt/firecrawl/node_modules/playwright");
const installed = await readFile("/opt/firecrawl/bin/cdp-relay.mjs");
const source = await readFile("/source/cdp-relay.mjs");
assert.deepEqual(installed, source, "relay source drift");
const packageJson = JSON.parse(
  await readFile("/opt/firecrawl/node_modules/playwright/package.json", "utf8"),
);
assert.equal(packageJson.version, "1.61.1");

const relay = await startCdpRelay();
const browser = await chromium.connectOverCDP(relay.endpoint, { timeout: 30_000 });
try {
  const contexts = browser.contexts();
  assert.equal(contexts.length, 1, "expected one context");
  assert.equal(contexts[0].pages().length, 1, "expected one context-bound page");
  assert.equal(await contexts[0].pages()[0].title(), ${JSON.stringify(EXPECTED_TITLE)});
  process.stdout.write("node-playwright-1.61.1:${EXPECTED_TITLE}\n");
} finally {
  await browser.close().catch(() => {});
  await relay.close();
}
`;

const PYTHON_CLIENT_SOURCE = String.raw`
import importlib.metadata
import pathlib
import signal
import subprocess
import time

from playwright.sync_api import sync_playwright

assert importlib.metadata.version("playwright") == "1.61.0"
assert pathlib.Path("/opt/firecrawl/bin/cdp-relay.mjs").read_bytes() == pathlib.Path(
    "/source/cdp-relay.mjs"
).read_bytes()

relay = subprocess.Popen(
    ["/usr/local/bin/node", "/opt/firecrawl/bin/cdp-relay.mjs", "--serve"],
    stdin=subprocess.DEVNULL,
    stdout=subprocess.DEVNULL,
    stderr=subprocess.PIPE,
    close_fds=True,
)
try:
    endpoint_file = pathlib.Path("/run/firecrawl-job/cdp-endpoint")
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline:
        if relay.poll() is not None:
            raise RuntimeError("python_relay_exited")
        try:
            endpoint = endpoint_file.read_text(encoding="utf-8")
            if endpoint.endswith("\n") and endpoint.count("\n") == 1:
                endpoint = endpoint[:-1]
                break
        except FileNotFoundError:
            pass
        time.sleep(0.01)
    else:
        raise RuntimeError("python_relay_timeout")

    with sync_playwright() as playwright:
        browser = playwright.chromium.connect_over_cdp(endpoint, timeout=30_000)
        try:
            assert len(browser.contexts) == 1, "expected one context"
            assert len(browser.contexts[0].pages) == 1, "expected one context-bound page"
            assert browser.contexts[0].pages[0].title() == "${EXPECTED_TITLE}"
            print("python-playwright-1.61.0:${EXPECTED_TITLE}")
        finally:
            browser.close()
finally:
    if relay.poll() is None:
        relay.send_signal(signal.SIGTERM)
    try:
        relay.wait(timeout=2)
    except subprocess.TimeoutExpired:
        relay.kill()
        relay.wait(timeout=2)
    if relay.returncode != 0:
        raise RuntimeError(relay.stderr.read().decode("utf-8", "replace"))
`;

const ARTIFACT_USER_SOURCE = String.raw`
const fs = await import("node:fs/promises");
const childProcess = await import("node:child_process");
const root = "/run/firecrawl-job/artifacts";
const chosenId = "11111111-1111-4111-8111-111111111111";
const chosenName = chosenId + ".png";
const png = Buffer.concat([
  Buffer.from([0x89, 0x50, 0x4e, 0x47, 13, 10, 26, 10]),
  Buffer.from("supervisor-owned"),
]);
await fs.mkdir(root + "/files", { recursive: true });
await fs.writeFile(root + "/files/" + chosenName, png);
await fs.writeFile(
  root + "/manifest.json",
  JSON.stringify([{
    artifactId: chosenId,
    name: chosenName,
    kind: "screenshot",
    contentType: "image/png",
    byteSize: png.byteLength,
    checksum: "0".repeat(64),
    attackerField: true,
  }]) + "\n",
);
const saved = await saveArtifact(png);
const racer = childProcess.spawn(
  "/usr/local/bin/node",
  [
    "-e",
    "const f=require('node:fs');" +
      "setInterval(()=>{" +
      "try{f.writeFileSync('/run/firecrawl-job/artifacts/manifest.json','attacker-race\\n')}" +
      "catch{}},1)",
  ],
  { detached: true, stdio: "ignore" },
);
racer.unref();
return saved;
`;

const SUPERVISOR_HARNESS_SOURCE = String.raw`
import os
import socket

relay = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
relay.connect("/run/firecrawl-job/gateway.sock")
os.dup2(relay.fileno(), 3, inheritable=True)
os.set_inheritable(3, True)
source = os.open("/fixture/" + os.environ["RUNNER_SOURCE"], os.O_RDONLY)
os.dup2(source, 0, inheritable=True)
os.close(source)
supervisor = "/opt/firecrawl/bin/job-init.py"
os.execve(
    supervisor,
    [supervisor, os.environ["RUNNER_PATH"]],
    os.environ,
)
`;

const ARTIFACT_VALIDATOR_SOURCE = String.raw`
import assert from "node:assert/strict";
import { createHash } from "node:crypto";
import { chmod, readFile, readdir } from "node:fs/promises";

const root = "/job/artifacts";
const records = JSON.parse(await readFile(root + "/manifest.json", "utf8"));
const expectArtifact = process.env.EXPECT_ARTIFACT === "1";
assert.equal(records.length, expectArtifact ? 1 : 0);
const files = await readdir(root + "/files");
if (expectArtifact) {
  const record = records[0];
  assert.deepEqual(Object.keys(record).sort(), [
    "artifactId",
    "byteSize",
    "checksum",
    "contentType",
    "kind",
    "name",
  ]);
  assert.match(
    record.artifactId,
    /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/,
  );
  assert.notEqual(record.artifactId, "11111111-1111-4111-8111-111111111111");
  assert.equal(record.name, record.artifactId + ".png");
  assert.equal(record.kind, "screenshot");
  assert.equal(record.contentType, "image/png");
  assert.equal(record.byteSize, 24);
  assert.deepEqual(files, [record.name]);
  const content = await readFile(root + "/files/" + record.name);
  assert.equal(
    createHash("sha256").update(content).digest("hex"),
    record.checksum,
  );
  await chmod(root + "/files/" + record.name, 0o644);
} else {
  assert.deepEqual(files, []);
}
await chmod(root + "/files", 0o755);
await chmod(root + "/manifest.json", 0o644);
await chmod(root, 0o755);
process.stdout.write(
  expectArtifact
    ? "artifact-manifest:server-owned\n"
    : "artifact-manifest:empty\n",
);
`;

const RELAY_CONTRACT_SOURCE = String.raw`
import assert from "node:assert/strict";
import { once } from "node:events";
import { rm } from "node:fs/promises";
import { createRequire } from "node:module";
import { createServer } from "node:net";
import { startCdpRelay } from "/opt/firecrawl/bin/cdp-relay.mjs";

const require = createRequire(import.meta.url);
const { WebSocket } = require("/opt/firecrawl/node_modules/ws");
const path = "/run/firecrawl-job/relay.sock";

async function openSocket(url) {
  const socket = new WebSocket(url);
  await once(socket, "open");
  return socket;
}

async function waitClosed(socket, label) {
  if (socket.readyState !== socket.CLOSED) {
    await Promise.race([
      once(socket, "close"),
      new Promise((_, reject) =>
        setTimeout(() => reject(new Error(label + "_close_timeout")), 2_000),
      ),
    ]);
  }
  assert.equal(socket.readyState, socket.CLOSED, label);
}

async function scenario(name, exercise) {
  await rm(path, { force: true });
  let peer;
  const server = createServer(socket => {
    assert.equal(peer, undefined, name + "_unexpected_gateway_client");
    peer = socket;
  });
  server.listen(path);
  await once(server, "listening");
  const relay = await startCdpRelay();
  try {
    while (!peer) await new Promise(resolve => setImmediate(resolve));
    await exercise(relay, peer);
  } finally {
    await relay.close().catch(() => {});
    peer?.destroy();
    server.close();
    await once(server, "close").catch(() => {});
    await rm(path, { force: true });
  }
}

await scenario("single-client", async (relay, peer) => {
  const first = await openSocket(relay.endpoint);
  const second = new WebSocket(relay.endpoint);
  const [code, reason] = await once(second, "close");
  assert.equal(code, 1008);
  assert.equal(reason.toString(), "single_client_only");
  assert.equal(first.readyState, first.OPEN);
  first.terminate();
  await waitClosed(first, "first_client");
});

await scenario("oversize", async (relay, peer) => {
  const client = await openSocket(relay.endpoint);
  peer.write(
    Buffer.concat([Buffer.alloc(24 * 1024 * 1024 + 1, 0x61), Buffer.from("\n")]),
  );
  await waitClosed(client, "oversize_frame");
});

await scenario("empty", async (relay, peer) => {
  const client = await openSocket(relay.endpoint);
  peer.write("\n");
  await waitClosed(client, "empty_frame");
});

await scenario("invalid-utf8", async (relay, peer) => {
  const client = await openSocket(relay.endpoint);
  peer.write(Buffer.from([0xff, 0x0a]));
  await waitClosed(client, "invalid_utf8");
});

await scenario("scalar", async (relay, peer) => {
  const client = await openSocket(relay.endpoint);
  client.send("1");
  await waitClosed(client, "scalar_json");
});

await scenario("non-json", async (relay, peer) => {
  const client = await openSocket(relay.endpoint);
  client.send("{");
  await waitClosed(client, "non_json");
});

await scenario("duplicate-id", async (relay, peer) => {
  const client = await openSocket(relay.endpoint);
  const received = once(peer, "data");
  client.send('{"id":1,"method":"Browser.getVersion"}');
  await received;
  client.send('{"id":1,"method":"Browser.getVersion"}');
  await waitClosed(client, "duplicate_id");
});

await scenario("unknown-id", async (relay, peer) => {
  const client = await openSocket(relay.endpoint);
  const received = once(peer, "data");
  client.send('{"id":1,"method":"Browser.getVersion"}');
  await received;
  peer.write('{"id":2,"result":{}}\n');
  await waitClosed(client, "unknown_id");
});

await scenario("outstanding-bound", async (relay, peer) => {
  const client = await openSocket(relay.endpoint);
  for (let id = 1; id <= 1025; id += 1) {
    client.send(JSON.stringify({ id, method: "Browser.getVersion" }));
  }
  await waitClosed(client, "outstanding_bound");
});

await scenario("eof", async (relay, peer) => {
  const client = await openSocket(relay.endpoint);
  peer.end();
  await waitClosed(client, "gateway_eof");
});

process.stdout.write(
  "code-relay-v1:single-client,oversize,empty,utf8,json,ids,outstanding,eof\n",
);
`;

function run(args, { timeout = 120_000, expected } = {}) {
  const result = spawnSync(args[0], args.slice(1), {
    cwd: ROOT,
    encoding: "utf8",
    timeout,
    maxBuffer: MAX_OUTPUT,
  });
  if (result.error || result.status !== 0 || result.signal !== null) {
    process.stderr.write(result.stdout || "");
    process.stderr.write(result.stderr || "");
    throw result.error ?? new Error(`command_failed:${args.slice(0, 3).join(":")}`);
  }
  if (expected !== undefined) assert.equal(result.stdout, expected);
  return result.stdout.trim();
}

function docker(...args) {
  return run([DOCKER, ...args]);
}

function makeFixtureRemovable(fixtureRoot) {
  spawnSync(
    DOCKER,
    [
      "run",
      "--rm",
      "--network",
      "none",
      "--mount",
      `type=bind,src=${fixtureRoot},dst=/cleanup`,
      "--entrypoint",
      "/bin/chmod",
      BROWSER_IMAGE,
      "-R",
      "a+rwX",
      "/cleanup",
    ],
    { encoding: "utf8", maxBuffer: MAX_OUTPUT },
  );
}

function waitForRelay(jobRoot, gatewayName, socketName = "relay.sock") {
  const socket = join(jobRoot, socketName);
  const deadline = Date.now() + 15_000;
  while (Date.now() < deadline) {
    try {
      if (lstatSync(socket).isSocket()) return;
    } catch {}
    const state = docker("inspect", "--format", "{{.State.Running}}", gatewayName);
    if (state !== "true") break;
    Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 25);
  }
  const logs = spawnSync(DOCKER, ["logs", gatewayName], {
    encoding: "utf8",
    maxBuffer: MAX_OUTPUT,
  });
  process.stderr.write(logs.stdout || "");
  process.stderr.write(logs.stderr || "");
  throw new Error("gateway_relay_socket_timeout");
}

function runGatewayFixture(image, fixtureRoot, client, expected) {
  const jobRoot = join(fixtureRoot, `job-${client}`);
  run(["/usr/bin/mkdir", "-m", "0777", jobRoot]);
  const gatewayName = `firecrawl-code-relay-${process.pid}-${client}`;
  try {
    docker(
      "run",
      "--detach",
      "--rm",
      "--name",
      gatewayName,
      "--network",
      "none",
      "--mount",
      `type=bind,src=${fixtureRoot},dst=/fixture,readonly`,
      "--mount",
      `type=bind,src=${jobRoot},dst=/run/firecrawl-job`,
      "--entrypoint",
      "/usr/bin/node",
      BROWSER_IMAGE,
      "/fixture/gateway.mjs",
    );
    waitForRelay(jobRoot, gatewayName);
    const command =
      client === "node"
        ? ["/usr/local/bin/node", "/fixture/client-node.mjs"]
        : ["/usr/bin/python3", "/fixture/client-python.py"];
    const stdout = docker(
      "run",
      "--rm",
      "--network",
      "none",
      "--tmpfs",
      "/tmp:rw,noexec,nosuid,nodev,uid=65532,gid=65532,mode=0700",
      "--mount",
      `type=bind,src=${fixtureRoot},dst=/fixture,readonly`,
      "--mount",
      `type=bind,src=${CODE_ROOT},dst=/source,readonly`,
      "--mount",
      `type=bind,src=${jobRoot},dst=/run/firecrawl-job`,
      "--entrypoint",
      command[0],
      image,
      ...command.slice(1),
    );
    assert.equal(stdout, expected);
  } finally {
    spawnSync(DOCKER, ["rm", "--force", gatewayName], {
      encoding: "utf8",
      maxBuffer: MAX_OUTPUT,
    });
  }
}

function runSupervisorFixture(
  image,
  fixtureRoot,
  name,
  runnerPath,
  runnerSource,
  expected,
  expectArtifact = false,
) {
  const jobRoot = join(fixtureRoot, `job-supervisor-${name}`);
  run(["/usr/bin/mkdir", "-m", "0777", jobRoot]);
  const gatewayName = `firecrawl-code-relay-${process.pid}-supervisor-${name}`;
  try {
    docker(
      "run",
      "--detach",
      "--rm",
      "--name",
      gatewayName,
      "--network",
      "none",
      "--env",
      "RELAY_PATH=/run/firecrawl-job/gateway.sock",
      "--env",
      "CREATE_ARTIFACT_ROOT=1",
      "--mount",
      `type=bind,src=${fixtureRoot},dst=/fixture,readonly`,
      "--mount",
      `type=bind,src=${jobRoot},dst=/run/firecrawl-job`,
      "--entrypoint",
      "/usr/bin/node",
      BROWSER_IMAGE,
      "/fixture/gateway.mjs",
    );
    waitForRelay(jobRoot, gatewayName, "gateway.sock");
    const supervisor = docker(
      "run",
      "--rm",
      "--read-only",
      "--cap-drop",
      "ALL",
      "--security-opt",
      "no-new-privileges",
      "--security-opt",
      `seccomp=${join(CODE_ROOT, "../../policy/code-seccomp.json")}`,
      "--pids-limit",
      "64",
      "--network",
      "none",
      "--env",
      `RUNNER_PATH=${runnerPath}`,
      "--env",
      `RUNNER_SOURCE=${runnerSource}`,
      "--tmpfs",
      "/run/firecrawl-work:rw,noexec,nosuid,nodev,uid=65532,gid=65532,mode=0700",
      "--tmpfs",
      "/run/firecrawl-home:rw,noexec,nosuid,nodev,uid=65532,gid=65532,mode=0700",
      "--mount",
      `type=bind,src=${fixtureRoot},dst=/fixture,readonly`,
      "--mount",
      `type=bind,src=${jobRoot},dst=/run/firecrawl-job`,
      "--entrypoint",
      "/usr/bin/python3",
      image,
      "/fixture/supervisor-harness.py",
    );
    assert.equal(supervisor, expected);
    const validated = docker(
      "run",
      "--rm",
      "--network",
      "none",
      "--env",
      `EXPECT_ARTIFACT=${expectArtifact ? "1" : "0"}`,
      "--mount",
      `type=bind,src=${fixtureRoot},dst=/fixture,readonly`,
      "--mount",
      `type=bind,src=${jobRoot},dst=/job`,
      "--entrypoint",
      "/usr/bin/node",
      BROWSER_IMAGE,
      "/fixture/artifact-validator.mjs",
    );
    assert.equal(
      validated,
      expectArtifact
        ? "artifact-manifest:server-owned"
        : "artifact-manifest:empty",
    );
  } finally {
    spawnSync(DOCKER, ["rm", "--force", gatewayName], {
      encoding: "utf8",
      maxBuffer: MAX_OUTPUT,
    });
  }
}

function main() {
  assert.deepEqual(process.argv.slice(2), [], "invalid_fixture_invocation");
  const fixtureRoot = mkdtempSync(join(tmpdir(), "firecrawl-code-relay-v1-"));
  chmodSync(fixtureRoot, 0o755);
  const tag = `firecrawl-code-relay-fixture:${process.pid}`;
  let built = false;
  try {
    for (const [name, source] of [
      ["gateway.mjs", GATEWAY_SOURCE],
      ["client-node.mjs", NODE_CLIENT_SOURCE],
      ["client-python.py", PYTHON_CLIENT_SOURCE],
      ["relay-contract.mjs", RELAY_CONTRACT_SOURCE],
      ["supervisor-harness.py", SUPERVISOR_HARNESS_SOURCE],
      ["runner-artifact.js", ARTIFACT_USER_SOURCE],
      ["runner-python.py", 'print(page.title())\n'],
      ["runner-bash.sh", 'agent-browser get-url\n'],
      ["artifact-validator.mjs", ARTIFACT_VALIDATOR_SOURCE],
    ]) {
      writeFileSync(join(fixtureRoot, name), source, { mode: 0o444 });
    }

    const supplied = process.env.FIRECRAWL_CODE_IMAGE;
    const image =
      supplied ||
      (() => {
        run(
          [
            DOCKER,
            "build",
            "--quiet",
            "--tag",
            tag,
            "--file",
            join(CODE_ROOT, "Dockerfile"),
            CODE_ROOT,
          ],
          { timeout: 1_200_000 },
        );
        built = true;
        return tag;
      })();

    runGatewayFixture(
      image,
      fixtureRoot,
      "node",
      `node-playwright-1.61.1:${EXPECTED_TITLE}`,
    );
    runGatewayFixture(
      image,
      fixtureRoot,
      "python",
      `python-playwright-1.61.0:${EXPECTED_TITLE}`,
    );
    runSupervisorFixture(
      image,
      fixtureRoot,
      "node",
      "/opt/firecrawl/bin/run-node.mjs",
      "runner-artifact.js",
      '{"kind":"screenshot","byteSize":24}',
      true,
    );
    runSupervisorFixture(
      image,
      fixtureRoot,
      "python",
      "/opt/firecrawl/bin/run-python.py",
      "runner-python.py",
      EXPECTED_TITLE,
    );
    runSupervisorFixture(
      image,
      fixtureRoot,
      "bash",
      "/opt/firecrawl/bin/run-bash.sh",
      "runner-bash.sh",
      `data:text/html,<title>${EXPECTED_TITLE}</title>`,
    );

    const protocolJob = join(fixtureRoot, "job-protocol");
    run(["/usr/bin/mkdir", "-m", "0777", protocolJob]);
    const protocol = docker(
      "run",
      "--rm",
      "--network",
      "none",
      "--tmpfs",
      "/tmp:rw,noexec,nosuid,nodev,uid=65532,gid=65532,mode=0700",
      "--mount",
      `type=bind,src=${fixtureRoot},dst=/fixture,readonly`,
      "--mount",
      `type=bind,src=${protocolJob},dst=/run/firecrawl-job`,
      "--entrypoint",
      "/usr/local/bin/node",
      image,
      "/fixture/relay-contract.mjs",
    );
    assert.equal(
      protocol,
      "code-relay-v1:single-client,oversize,empty,utf8,json,ids,outstanding,eof",
    );
    process.stdout.write(
      "ok - code-relay-v1 interoperates with pinned Node and Python Playwright\n",
    );
  } finally {
    if (built) {
      spawnSync(DOCKER, ["image", "rm", "--force", tag], {
        encoding: "utf8",
        maxBuffer: MAX_OUTPUT,
      });
    }
    makeFixtureRemovable(fixtureRoot);
    rmSync(fixtureRoot, { recursive: true, force: true });
  }
}

main();
